    max-width: 450px;
    animation: slideInRight 0.3s ease-out;
  }
  
  .toast.success { background: #28a745; color: white; }
  .toast.error { background: #dc3545; color: white; }
  .toast.info { background: #34495e; color: white; }
  
  .toast i:first-child { font-size: 1.25rem; }
  .toast i:last-child { cursor: pointer; opacity: 0.7; margin-left: auto; }
  .toast i:last-child:hover { opacity: 1; }
  
  .toast-content { flex: 1; }
  .toast-title { font-weight: 600; margin-bottom: 0.25rem; }
  .toast-message { font-size: 0.875rem; opacity: 0.9; }
  
  @keyframes slideInRight {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
`;
document.head.appendChild(style);
</script>

