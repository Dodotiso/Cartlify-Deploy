{% extends 'base.html.twig' %}

{% block title %}Cartlify — About Us | Meet Our Team{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    /* ========== CSS VARIABLES ========== */
    :root {
        --slide-seconds: 5s;
        --slide-count: 5;
        --total-duration: calc(var(--slide-seconds) * var(--slide-count));
        --primary: #1B2A4A;
        --primary-dark: #0F1D35;
        --primary-light: #243660;
        --accent: #e67e22;
        --accent-dark: #d35400;
        --gray-50: #f8f9fa;
        --gray-100: #e9ecef;
        --gray-200: #dee2e6;
        --gray-500: #6c757d;
        --gray-700: #343a40;
        --gray-900: #212529;
        --white: #ffffff;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
        --shadow-lg: 0 10px 30px rgba(0,0,0,0.12);
        --shadow-xl: 0 20px 40px rgba(0,0,0,0.15);
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        --transition: all 0.3s ease;
        --navbar-height: 80px;
    }

    /* ========== RESET & BASE ========== */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
        font-family: 'Inter', sans-serif;
        color: var(--gray-900);
        background: var(--white);
        overflow-x: hidden;
    }

    h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 700; line-height: 1.2; }
    h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 700; margin-bottom: 1rem; }
    h3 { font-size: 1.25rem; font-weight: 600; }
    
    .section-header {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 3rem;
    }
    
    .section-header p {
        color: var(--gray-500);
        font-size: 1.1rem;
    }

    /* ========== NAVIGATION ========== */
    .navbar {
        display: flex;
        align-items: center;
        padding: 0 5%;
        background: var(--white);
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
        position: sticky;
        top: 0;
        z-index: 1000;
        height: var(--navbar-height);
    }

    .navbar.scrolled {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    }

    .navbar__logo {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        cursor: pointer;
        z-index: 1001;
    }

    .navbar__logo-img {
        height: 45px;
        width: auto;
        transition: var(--transition);
        filter: brightness(0) saturate(100%) invert(11%) sepia(53%) saturate(746%) hue-rotate(197deg) brightness(37%) contrast(97%);
    }

    .navbar__logo-img:hover {
        transform: scale(1.05);
    }

    .navbar__nav {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

    .navbar__menu {
        display: flex;
        gap: 2.5rem;
        list-style: none;
        align-items: center;
    }

    .navbar__menu-link {
        text-decoration: none;
        color: var(--gray-700);
        font-weight: 500;
        font-size: 0.95rem;
        transition: var(--transition);
        position: relative;
        padding: 0.5rem 0;
        letter-spacing: 0.3px;
    }

    .navbar__menu-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background: var(--accent);
        transition: width 0.3s ease;
        border-radius: 2px;
    }

    .navbar__menu-link:hover,
    .navbar__menu-link--active {
        color: var(--primary);
    }

    .navbar__menu-link:hover::after,
    .navbar__menu-link--active::after {
        width: 100%;
    }

    .navbar__actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-shrink: 0;
    }

    .navbar__mobile-auth {
        display: none;
    }

    /* ========== BUTTONS ========== */
    .btn {
        padding: 0.6rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        white-space: nowrap;
        text-decoration: none;
        display: inline-block;
        border: 2px solid transparent;
    }

    .btn--outline {
        border-color: var(--primary);
        background: transparent;
        color: var(--primary);
    }

    .btn--outline:hover {
        background: var(--primary);
        color: var(--white);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(27, 42, 74, 0.3);
    }

    .btn--primary {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--white);
    }

    .btn--primary:hover {
        background: var(--accent-dark);
        border-color: var(--accent-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(230, 126, 34, 0.4);
    }

    .btn--large {
        padding: 1rem 2rem;
        font-size: 1rem;
    }

    .btn--block {
        width: 100%;
        text-align: center;
        padding: 0.8rem;
        font-size: 0.9rem;
    }

    /* ========== HAMBURGER ========== */
    .hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        z-index: 1001;
        width: 40px;
        height: 40px;
    }

    .hamburger__line {
        display: block;
        width: 24px;
        height: 2px;
        background: var(--primary);
        margin: 5px auto;
        transition: var(--transition);
        border-radius: 2px;
    }

    .hamburger--active .hamburger__line:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
    }

    .hamburger--active .hamburger__line:nth-child(2) {
        opacity: 0;
    }

    .hamburger--active .hamburger__line:nth-child(3) {
        transform: rotate(-45deg) translate(5px, -5px);
    }

    /* ========== MOBILE OVERLAY ========== */
    .overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .overlay--active {
        opacity: 1;
    }

    /* ========== HERO ABOUT SECTION ========== */
    .hero-about {
        min-height: 60vh;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: 2rem 5%;
    }

    .hero-about::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1920&auto=format') center/cover;
        opacity: 0.1;
        animation: slowZoom 20s ease-in-out infinite alternate;
    }

    @keyframes slowZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.05); }
    }

    .hero-about__content {
        position: relative;
        z-index: 2;
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        color: var(--white);
    }

    .hero-about__badge {
        display: inline-block;
        background: var(--accent);
        color: white;
        padding: 0.5rem 1.5rem;
        border-radius: 40px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .hero-about__content h1 {
        margin-bottom: 1rem;
    }

    .hero-about__content h1 span {
        color: var(--accent);
    }

    .hero-about__content p {
        font-size: 1.1rem;
        margin-bottom: 2rem;
        opacity: 0.9;
        line-height: 1.6;
    }

    .hero-about__stats {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-top: 2rem;
    }

    .stat-item {
        text-align: center;
    }

    .stat-item__number {
        font-size: 2rem;
        font-weight: 800;
        color: var(--accent);
        display: block;
    }

    .stat-item__label {
        font-size: 0.875rem;
        opacity: 0.8;
    }

    /* ========== STORY SECTION ========== */
    .story {
        padding: 5rem 5%;
        background: var(--white);
    }

    .story__container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .story__grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }

    .story__content {
        position: relative;
    }

    .story__badge {
        display: inline-block;
        background: linear-gradient(135deg, var(--accent), var(--accent-dark));
        color: white;
        padding: 0.3rem 1rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 1rem;
        letter-spacing: 1px;
    }

    .story__content h2 {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        color: var(--primary);
        line-height: 1.2;
    }

    .story__content h2 span {
        color: var(--accent);
        position: relative;
    }

    .story__content h2 span::after {
        content: '';
        position: absolute;
        bottom: 5px;
        left: 0;
        width: 100%;
        height: 8px;
        background: rgba(230, 126, 34, 0.2);
        z-index: -1;
    }

    .story__content p {
        color: var(--gray-700);
        line-height: 1.7;
        margin-bottom: 1.2rem;
        font-size: 1rem;
    }

    .story__highlight {
        background: linear-gradient(135deg, var(--gray-50), var(--white));
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        margin: 1.5rem 0;
        border-left: 4px solid var(--accent);
        box-shadow: var(--shadow-sm);
    }

    .story__highlight i {
        color: var(--accent);
        font-size: 1.5rem;
        margin-right: 0.5rem;
        vertical-align: middle;
    }

    .story__highlight p {
        margin-bottom: 0;
        font-style: italic;
        font-weight: 500;
        color: var(--gray-700);
    }

    .story__stats {
        display: flex;
        gap: 2rem;
        margin-top: 2rem;
    }

    .story-stat__number {
        font-size: 2rem;
        font-weight: 800;
        color: var(--accent);
        display: block;
    }

    .story-stat__label {
        font-size: 0.8rem;
        color: var(--gray-500);
    }

    .story__image {
        position: relative;
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-xl);
    }

    .story__image img {
        width: 100%;
        height: auto;
        transition: transform 0.5s ease;
        display: block;
    }

    .story__image:hover img {
        transform: scale(1.05);
    }

    /* ========== VALUES SECTION ========== */
    .values {
        padding: 5rem 5%;
        background: var(--gray-50);
    }

    .values__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .value-card {
        text-align: center;
        padding: 2rem;
        background: var(--white);
        border-radius: var(--radius-lg);
        transition: var(--transition);
        box-shadow: var(--shadow-sm);
    }

    .value-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-xl);
    }

    .value-card__icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2rem;
        color: var(--white);
        transition: var(--transition);
    }

    .value-card:hover .value-card__icon {
        transform: rotateY(180deg);
    }

    /* ========== TEAM SECTION ========== */
    .team {
        padding: 5rem 5%;
        background: var(--white);
    }

    .team__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .team-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        transition: var(--transition);
        text-align: center;
        border: 1px solid var(--gray-100);
    }

    .team-card:hover {
        transform: translateY(-10px);
        box-shadow: var(--shadow-xl);
        border-color: var(--accent);
    }

    .team-card__image {
        position: relative;
        overflow: hidden;
        padding-top: 100%;
        background: linear-gradient(135deg, var(--primary-light), var(--primary-dark));
    }

    .team-card__image img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .team-card:hover .team-card__image img {
        transform: scale(1.08);
    }

    .team-card__social {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        padding: 1rem;
        display: flex;
        justify-content: center;
        gap: 1rem;
        transform: translateY(100%);
        transition: transform 0.3s ease;
    }

    .team-card:hover .team-card__social {
        transform: translateY(0);
    }

    .team-card__social a {
        width: 36px;
        height: 36px;
        background: var(--white);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        text-decoration: none;
        transition: var(--transition);
    }

    .team-card__social a:hover {
        background: var(--accent);
        color: var(--white);
        transform: translateY(-3px);
    }

    .team-card__body {
        padding: 1.5rem;
    }

    .team-card__name {
        margin-bottom: 0.25rem;
        color: var(--gray-900);
        font-size: 1.3rem;
    }

    .team-card__role {
        color: var(--accent);
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: var(--gray-50);
        border-radius: 50px;
    }

    .team-card__bio {
        color: var(--gray-500);
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0.75rem 0;
    }

    /* ========== CTA BANNER ========== */
    .cta-banner {
        margin: 3rem 5%;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        border-radius: var(--radius-xl);
        overflow: hidden;
        position: relative;
    }

    .cta-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(230,126,34,0.15) 0%, transparent 70%);
        animation: rotateBg 20s linear infinite;
    }

    @keyframes rotateBg {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .cta-banner__container {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 3rem 4rem;
        flex-wrap: wrap;
        gap: 2rem;
    }

    .cta-banner__content {
        flex: 1;
        color: var(--white);
    }

    .cta-banner__content h2 {
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
        color: var(--white);
    }

    .cta-banner__content p {
        opacity: 0.9;
        font-size: 1rem;
    }

    .cta-banner__features {
        display: flex;
        gap: 2rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .cta-banner__feature {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(255,255,255,0.8);
        font-size: 0.85rem;
    }

    .cta-banner__feature i {
        color: var(--accent);
    }

    .cta-banner__actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn--cta-primary {
        padding: 1rem 2rem;
        background: var(--accent);
        color: var(--white);
        border: none;
        border-radius: 50px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
        font-size: 1rem;
        text-decoration: none;
        display: inline-block;
    }

    .btn--cta-primary:hover {
        background: var(--accent-dark);
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(230,126,34,0.3);
    }

    .btn--cta-secondary {
        padding: 1rem 2rem;
        background: transparent;
        color: var(--white);
        border: 2px solid var(--white);
        border-radius: 50px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
        font-size: 1rem;
        text-decoration: none;
        display: inline-block;
    }

    .btn--cta-secondary:hover {
        background: var(--white);
        color: var(--primary);
        transform: translateY(-3px);
    }

    /* ========== FOOTER ========== */
    .footer {
        background: var(--primary-dark);
        color: var(--gray-200);
        padding: 3rem 5% 2rem;
    }

    .footer__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        max-width: 1300px;
        margin: 0 auto;
    }

    .footer a {
        color: var(--gray-400);
        text-decoration: none;
        transition: var(--transition);
        display: inline-block;
        margin: 0.3rem 0;
    }

    .footer a:hover {
        color: var(--accent);
        transform: translateX(3px);
    }

    .footer__social {
        margin-top: 1rem;
    }

    .footer__social a {
        margin-right: 1rem;
        font-size: 1.2rem;
    }

    .footer__bottom {
        text-align: center;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.8rem;
    }

    /* ========== ANIMATIONS ========== */
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .section { animation: fadeInUp 0.6s ease-out; }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 992px) {
        .navbar__menu { gap: 1.5rem; }
    }

    @media (max-width: 768px) {
        .navbar {
            padding: 0 1.5rem;
            height: 70px;
            justify-content: space-between;
        }

        .navbar__logo-img { height: 35px; }

        .navbar__actions { display: none; }

        .hamburger {
            display: block;
            order: 3;
        }

        .navbar__nav {
            position: fixed;
            top: 0;
            right: -100%;
            width: 300px;
            height: 100vh;
            background: var(--white);
            flex-direction: column;
            justify-content: flex-start;
            padding: 100px 2rem 2rem;
            transition: right 0.3s ease;
            box-shadow: -5px 0 30px rgba(0, 0, 0, 0.15);
            z-index: 1000;
            overflow-y: auto;
        }

        .navbar__nav--open { right: 0; }

        .navbar__menu {
            flex-direction: column;
            gap: 0;
            width: 100%;
        }

        .navbar__menu li {
            width: 100%;
            border-bottom: 1px solid var(--gray-100);
        }

        .navbar__menu li:last-child { border-bottom: none; }

        .navbar__menu-link {
            display: block;
            padding: 1rem 0;
            font-size: 1.1rem;
            text-align: left;
        }

        .navbar__menu-link::after { display: none; }

        .navbar__menu-link:hover {
            color: var(--accent);
            padding-left: 0.5rem;
        }

        .navbar__mobile-auth {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            width: 100%;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--gray-100);
        }

        .overlay { display: block; }

        .hero-about {
            min-height: auto;
            padding: 3rem 1rem;
        }

        .hero-about__content h1 { font-size: 2rem; }
        .hero-about__content p { font-size: 1rem; }

        .hero-about__stats {
            flex-direction: column;
            gap: 1rem;
        }

        .story__grid {
            grid-template-columns: 1fr;
            gap: 2rem;
            text-align: center;
        }

        .story__content h2 { font-size: 2rem; }
        .story__stats { justify-content: center; }

        .values__grid { grid-template-columns: 1fr; }

        .team__grid { grid-template-columns: 1fr; }
        .team-card { max-width: 350px; margin: 0 auto; }

        .cta-banner__container {
            flex-direction: column;
            text-align: center;
            padding: 2rem 1.5rem;
        }

        .cta-banner__content h2 { font-size: 1.8rem; }
        .cta-banner__actions { justify-content: center; width: 100%; }
        .btn--cta-primary,
        .btn--cta-secondary { width: 100%; text-align: center; padding: 0.8rem 1.5rem; }
        .cta-banner__features { justify-content: center; }

        .footer__grid { grid-template-columns: 1fr; text-align: center; gap: 1.5rem; }
        .footer a { margin: 0.2rem 0.5rem; }
        .footer__social a { margin: 0 0.5rem; }
    }

    @media (max-width: 480px) {
        .navbar { padding: 0 1rem; height: 60px; }
        .navbar__logo-img { height: 30px; }
        .navbar__nav { width: 100%; padding: 90px 1.5rem 2rem; }

        .hero-about__badge { padding: 0.4rem 1rem; font-size: 0.75rem; }
        .hero-about__content h1 { font-size: 1.8rem; }
        .stat-item__number { font-size: 1.8rem; }

        .story__content h2 { font-size: 1.8rem; }
        .story__highlight { padding: 1rem; }
        .story__highlight i { font-size: 1.2rem; }
        .story__stats { flex-wrap: wrap; gap: 1rem; }
        .story-stat__number { font-size: 1.5rem; }

        .value-card__icon { width: 65px; height: 65px; font-size: 1.5rem; }

        .team-card { max-width: 300px; }
