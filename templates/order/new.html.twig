<!-- ============================================ -->
<!-- PROFILE VARIABLES
<!-- ============================================ -->
{% set role = app.user.roles[0] ?? 'ROLE_USER' %}
{% set hasProfilePic = app.user.profilePicture is defined and app.user.profilePicture is not null %}
{% set userRoleName = role == 'ROLE_ADMIN' ? 'Administrator' : (role == 'ROLE_STAFF' ? 'Staff Member' : 'Customer') %}
{% set userRoleIcon = role == 'ROLE_ADMIN' ? 'crown' : (role == 'ROLE_STAFF' ? 'user-tie' : 'user') %}

<!-- ============================================ -->
<!-- HEADER
<!-- ============================================ -->
<div class="header">
    <h1>
        <button class="menu-toggle" id="menuToggle">
            <i class="fas fa-bars"></i>
        </button>
        <i class="fas fa-store"></i> Marketplace
    </h1>

    <div class="header-right">
        <a href="{{ path('app_order_tracker') }}" class="tracker-icon-link" title="My Orders Tracker">
            <i class="fas fa-box"></i>
            <span class="tracker-badge" id="trackerBadge">0</span>
        </a>
        <a href="{{ path('app_cart_view') }}" class="cart-icon-link" title="Shopping Cart">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-badge" id="cartBadge">0</span>
        </a>
        <div class="notification-wrapper">
            <button class="notification-icon" id="notificationIcon" onclick="toggleNotificationDropdown()">
                <i class="fas fa-bell"></i>
                <span class="notification-badge" id="notificationBadge">0</span>
            </button>
            <div class="notification-dropdown" id="notificationDropdown">
                <div class="notification-header"><i class="fas fa-bell"></i> Notifications</div>
                <div id="notificationList"><div style="padding:20px;text-align:center;color:#6c757d;"><i class="fas fa-bell-slash"></i> No notifications</div></div>
                <div class="notification-footer">
                    <a href="{{ path('app_notifications_index') }}" class="view-all-link" onclick="markAllNotificationsAsReadBeforeRedirect()">View all notifications</a>
                    <button class="clear-notif-btn" onclick="clearAllNotifications()">Clear all</button>
                </div>
            </div>
        </div>
        <div class="profile-wrapper">
            <div class="profile-header" id="profileHeader">
                <div class="profile-avatar">
                    {% if hasProfilePic %}
                        <img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">
                    {% else %}
                        {{ app.user.username|first|upper }}
                    {% endif %}
                </div>
                <span class="profile-name">{{ app.user.username }}</span>
                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
            <div class="profile-dropdown" id="profileDropdown">
                <div class="dropdown-role-header">
                    <i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}
                </div>
                <a href="{{ path('app_profile_index') }}" class="dropdown-item">
                    <i class="fas fa-user-circle"></i>
                    <span>My Profile</span>
                </a>
                <a href="#" class="dropdown-item" id="changeProfilePicBtn">
                    <i class="fas fa-camera"></i>
                    <span>Change Picture</span>
                </a>
                <div class="dropdown-divider"></div>
                <a href="{{ path('app_logout') }}" class="dropdown-item logout-item">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </div>
</div>

<form id="profilePicUploadForm" method="post" enctype="multipart/form-data" style="display: none;">
    <input type="file" id="profilePicInput" name="profile_picture" accept="image/*">
</form>
<div class="toast-container" id="toastContainer"></div>

<!-- ============================================ -->
<!-- MAIN CONTENT
<!-- ============================================ -->
<div class="main-content">
    <!-- Search Section -->
    <div class="search-section">
        <div class="search-container">
            <div class="search-form-wrapper">
                <form method="get" action="{{ path('app_order_new') }}" class="search-form" id="searchForm">
                    <input type="text" name="search" id="searchInput" value="{{ search|default('') }}" placeholder="Search products...">
                    <button type="submit"><i class="fas fa-search"></i> Search</button>
                </form>
                {% if search %}<a href="{{ path('app_order_new') }}" class="clear-btn"><i class="fas fa-times"></i> Clear</a>{% endif %}
            </div>
        </div>

        <div class="filter-container">
            <div class="filter-group">
                <label><i class="fas fa-filter"></i> Category:</label>
                <select id="categoryFilter" onchange="filterProducts()">
                    <option value="all">All Categories</option>
                    {% set categories = [] %}
                    {% for stock in stocks %}
                        {% if stock.product.category and stock.product.category.category not in categories %}
                            {% set categories = categories|merge([stock.product.category.category]) %}
                        {% endif %}
                    {% endfor %}
                    {% for category in categories|sort %}
                        <option value="{{ category }}">{{ category }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label><i class="fas fa-tag"></i> Sort by:</label>
                <select id="sortFilter" onchange="filterProducts()">
                    <option value="default">Default</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                    <option value="name_asc">Name: A to Z</option>
                    <option value="name_desc">Name: Z to A</option>
                    <option value="stock_asc">Stock: Low to High</option>
                </select>
            </div>
            <button class="filter-reset" onclick="resetFilters()"><i class="fas fa-undo-alt"></i> Reset Filters</button>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="products-container" id="productsContainer">
        {% if stocks|length > 0 %}
            {% for stock in stocks %}
                <div class="product-card" data-category="{{ stock.product.category ? stock.product.category.category : 'Uncategorized' }}" data-price="{{ stock.product.price }}" data-name="{{ stock.product.name }}" data-stock="{{ stock.stock }}">
                    <div class="product-image-container">
                        {% if stock.product.image %}
                            {% set imagePath = stock.product.image %}
                            {% if not (imagePath starts with 'http' or imagePath starts with '/') %}{% set imagePath = '/uploads/' ~ imagePath %}{% endif %}
                            <img src="{{ imagePath }}" alt="{{ stock.product.name }}" onerror="this.src='{{ asset('images/placeholder.png') }}'">
                        {% else %}
                            <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#f8f9fa;"><i class="fas fa-image" style="font-size:48px;color:#bdc3c7;"></i></div>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <h3 title="{{ stock.product.name }}">{{ stock.product.name|length > 40 ? stock.product.name|slice(0, 40) ~ '...' : stock.product.name }}</h3>
                        <div class="description">{{ stock.product.description|length > 60 ? stock.product.description|slice(0, 60) ~ '...' : stock.product.description }}</div>
                        <div class="price">₱{{ stock.product.price|number_format(2, '.', ',') }}</div>
                        <div class="stock"><i class="fas fa-boxes"></i> Available: {% if stock.stock < 10 %}<span class="stock-low">{{ stock.stock }} (Low Stock)</span>{% elseif stock.stock < 20 %}<span class="stock-medium">{{ stock.stock }}</span>{% else %}<span class="stock-high">{{ stock.stock }}</span>{% endif %}</div>
                        <div class="product-actions">
                            <button type="button" class="btn-add-to-cart" onclick="openAddToCartModal({{ stock.id }}, '{{ stock.product.name|escape('js') }}', {{ stock.product.price }}, {{ stock.stock }}, '{{ stock.product.image ? stock.product.image|escape('js') : '' }}')"><i class="fas fa-cart-plus"></i> Add to Cart</button>
                            <button type="button" class="btn-buy-now" onclick="openBuyNowModal({{ stock.id }}, '{{ stock.product.name|escape('js') }}', {{ stock.product.price }}, {{ stock.stock }}, '{{ stock.product.image ? stock.product.image|escape('js') : '' }}')"><i class="fas fa-bolt"></i> Buy Now</button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="no-products"><i class="fas fa-store-slash"></i><h3>No Products Available</h3><p>{% if search %}No products found for "{{ search }}"{% else %}There are no products available at the moment.{% endif %}</p></div>
        {% endif %}
    </div>
</div>

<!-- ADD TO CART MODAL -->
<div id="addToCartModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header"><h3><i class="fas fa-cart-plus"></i> Add to Cart</h3><button class="modal-close" onclick="closeAddToCartModal()">&times;</button></div>
        <div class="modal-body">
            <div class="modal-product-image"><img id="addCartProductImage" src=""></div>
            <div class="modal-product-name" id="addCartProductName"></div>
            <div class="modal-product-price" id="addCartProductPrice"></div>
            <div class="form-group" style="text-align:center;background:#f8f9fa;padding:12px;border-radius:8px;"><i class="fas fa-boxes"></i> Available Stock: <strong id="addCartStockAmount">0</strong></div>
            <div class="quantity-selector"><button class="quantity-btn" onclick="decrementAddCartQuantity()">-</button><input type="number" id="addCartQuantity" class="quantity-input" value="1" min="1"><button class="quantity-btn" onclick="incrementAddCartQuantity()">+</button></div>
            <div class="modal-total"><strong>Total: ₱</strong><span id="addCartTotalAmount">0.00</span></div>
        </div>
        <div class="modal-footer"><button class="btn-cancel" onclick="closeAddToCartModal()">Cancel</button><button class="btn-confirm" onclick="confirmAddToCart()">Add to Cart</button></div>
    </div>
</div>

<!-- BUY NOW MODAL -->
<div id="buyNowModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 600px;">
        <div class="modal-header">
            <h3><i class="fas fa-bolt"></i> Complete Your Purchase</h3>
            <button class="modal-close" onclick="closeBuyNowModal()">&times;</button>
        </div>
        <div class="modal-body">
            <div style="display: flex; gap: 20px; margin-bottom: 25px; flex-wrap: wrap; align-items: center;">
                <div style="flex: 0 0 100px; text-align: center;">
                    <img id="buyNowProductImage" style="width: 100px; height: 100px; object-fit: contain; border-radius: 8px;">
                </div>
                <div style="flex: 2;">
                    <div class="modal-product-name" id="buyNowProductName" style="text-align: left; font-size: 18px; font-weight: 600; margin-bottom: 8px;"></div>
                    <div class="modal-product-price" id="buyNowProductPrice" style="text-align: left; font-size: 22px; font-weight: 700; color: #28a745;"></div>
                    <div style="margin-top: 5px; font-size: 13px; color: #6c757d;">
                        <i class="fas fa-boxes"></i> Available Stock: <strong id="buyNowStockAmount">0</strong>
                    </div>
                </div>
            </div>

            <div style="border-top: 1px solid #e9ecef; padding-top: 20px;">
                <h4 style="margin-bottom: 15px; font-size: 16px;"><i class="fas fa-user"></i> Customer Information</h4>

                <div class="form-group">
                    <label>Full Name *</label>
                    <input type="text" id="customerName" placeholder="Enter your full name" value="" required>
                </div>

                <div class="form-group">
                    <label>Email Address *</label>
                    <input type="email" id="customerEmail" placeholder="Enter your email" value="{{ app.user.email ?? '' }}" required>
                    <div id="emailError" class="email-error"></div>
                    <small style="display: block; margin-top: 5px; color: #6c757d; font-size: 11px;">Use valid email like name@gmail.com or name@yahoo.com</small>
                </div>

                <div class="form-group">
                    <label>Contact Number *</label>
                    <input type="tel" id="customerPhone" class="phone-input" placeholder="e.g., +639171234567 or +14155552671" maxlength="20" required>
                    <div id="phoneError" class="phone-error"></div>
                    <small style="display: block; margin-top: 5px; color: #6c757d; font-size: 11px;">Select your country flag and enter your phone number with country code</small>
                </div>

                <div class="form-group">
                    <label>Delivery Method *</label>
                    <select id="deliveryMethod" onchange="toggleAddressField()" required>
                        <option value="pickup">🏪 Pickup (In-Store)</option>
                        <option value="shipping">🚚 Ship / Delivery</option>
                    </select>
                </div>

                <div class="form-group" id="addressField" style="display: none;">
                    <label>Delivery Address *</label>
                    <textarea id="deliveryAddress" rows="3" placeholder="House #, Street, Barangay, City, Province, Postal Code" required></textarea>
                </div>

                <div class="form-group">
                    <label>Quantity *</label>
                    <div class="quantity-selector" style="justify-content: flex-start;">
                        <button type="button" class="quantity-btn" onclick="decrementBuyNowQuantity()" style="width: 40px; height: 40px;">-</button>
                        <input type="number" id="buyNowQuantity" class="quantity-input" value="1" min="1" style="width: 70px; height: 40px;">
                        <button type="button" class="quantity-btn" onclick="incrementBuyNowQuantity()" style="width: 40px; height: 40px;">+</button>
                    </div>
                </div>

                <div class="modal-total">
                    <span>Total Amount: ₱</span>
                    <span id="buyNowTotalAmount">0.00</span>
                </div>

                <h4 style="margin: 20px 0 15px 0; font-size: 16px;"><i class="fas fa-credit-card"></i> Payment Method</h4>
                <div class="payment-methods">
                    <div class="payment-method selected" data-payment="cod" onclick="selectPaymentMethod('cod')">
                        <i class="fas fa-money-bill-wave"></i>
                        <span>Cash on Delivery</span>
                    </div>
                </div>
                <input type="hidden" id="selectedPaymentMethod" value="cod">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-cancel" onclick="closeBuyNowModal()">Cancel</button>
            <button class="btn-confirm" onclick="confirmBuyNow()">Place Order</button>
        </div>
    </div>
</div>

<!-- intl-tel-input CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/css/intlTelInput.css">
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/intlTelInput.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
    // ============================================
    // GLOBAL VARIABLES
    // ============================================
    let addCartStockId = null, addCartMaxStock = 0, addCartPrice = 0;
    let buyNowStockId = null, buyNowMaxStock = 0, buyNowPrice = 0;
    let notifications = [];
    let phoneInputInstance = null;

    // ============================================
    // FILTER FUNCTIONS
    // ============================================
    function filterProducts() {
        const category = document.getElementById('categoryFilter').value;
        const sort = document.getElementById('sortFilter').value;
        const products = document.querySelectorAll('.product-card');
        let visibleProducts = [];

        products.forEach(product => {
            const productCategory = product.getAttribute('data-category');
            if (category === 'all' || productCategory === category) {
                product.style.display = '';
                visibleProducts.push(product);
            } else {
                product.style.display = 'none';
            }
        });

        if (sort !== 'default') {
            const container = document.getElementById('productsContainer');
            const sortedProducts = [...visibleProducts].sort((a, b) => {
                if (sort === 'price_asc') return parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price'));
                if (sort === 'price_desc') return parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price'));
                if (sort === 'name_asc') return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
                if (sort === 'name_desc') return b.getAttribute('data-name').localeCompare(a.getAttribute('data-name'));
                if (sort === 'stock_asc') return parseInt(a.getAttribute('data-stock')) - parseInt(b.getAttribute('data-stock'));
                return 0;
            });
            sortedProducts.forEach(product => container.appendChild(product));
        }
    }

    function resetFilters() {
        document.getElementById('categoryFilter').value = 'all';
        document.getElementById('sortFilter').value = 'default';
        document.getElementById('searchInput').value = '';
        document.getElementById('searchForm').submit();
    }

    // ============================================
    // EMAIL VALIDATION FUNCTION
    // ============================================
    function validateEmail(email) {
        const emailPattern = /^[a-zA-Z0-9._%+-]+@(gmail\.com|yahoo\.com|yahoo\.com\.ph|outlook\.com|hotmail\.com)$/i;
        return emailPattern.test(email);
    }

    function checkEmailValidation() {
        const emailInput = document.getElementById('customerEmail');
        const emailError = document.getElementById('emailError');
        const email = emailInput.value.trim();
        
        if (!email) {
            emailError.textContent = 'Email address is required';
            emailError.style.display = 'block';
            emailInput.style.borderColor = '#dc3545';
            return false;
        }
        
        if (!validateEmail(email)) {
            emailError.textContent = 'Please enter a valid email address (e.g., name@gmail.com or name@yahoo.com)';
            emailError.style.display = 'block';
            emailInput.style.borderColor = '#dc3545';
            return false;
        }
        
        emailError.style.display = 'none';
        emailInput.style.borderColor = '#28a745';
        return true;
    }

    // ============================================
    // PHONE VALIDATION FUNCTION
    // ============================================
    function validatePhone() {
        if (!phoneInputInstance) return true;
        
        const errorDiv = document.getElementById('phoneError');
        const phoneInput = document.getElementById('customerPhone');
        
        if (!phoneInputInstance.isValidNumber()) {
            errorDiv.textContent = 'Invalid contact number. Please enter a valid international phone number with country code (e.g., +639171234567).';
            errorDiv.style.display = 'block';
            phoneInput.style.borderColor = '#dc3545';
            return false;
        }
        
        errorDiv.style.display = 'none';
        phoneInput.style.borderColor = '#28a745';
        return true;
    }

    // ============================================
    // BADGE UPDATE FUNCTIONS
    // ============================================
    function updateCartBadge() {
        fetch('/cart/count')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('cartBadge');
                if (badge) {
                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.classList.add('show');
                    } else {
                        badge.classList.remove('show');
                    }
                }
            })
            .catch(e => console.log('Cart update error:', e));
    }

    function updateTrackerBadge() {
        fetch('{{ path('app_new_orders_count') }}')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('trackerBadge');
                if (badge) {
                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.classList.add('show');
                    } else {
                        badge.classList.remove('show');
                    }
                }
            })
            .catch(e => console.log('Tracker update error:', e));
    }

    // ============================================
    // TOAST NOTIFICATION
    // ============================================
    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if (!container) { 
            container = document.createElement('div'); 
            container.id = 'toastContainer'; 
            container.className = 'toast-container'; 
            document.body.appendChild(container); 
        }
        const toast = document.createElement('div'); 
        toast.className = `toast toast-${type}`;
        let icon = type === 'success' ? '✓' : (type === 'error' ? '✗' : (type === 'warning' ? '⚠' : 'ℹ'));
        toast.innerHTML = `<div class="toast-icon">${icon}</div><div class="toast-content">${message}</div><div class="toast-progress"></div>`;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.animation = 'slideOutRight 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    // ============================================
    // NOTIFICATION SYSTEM
    // ============================================
    function loadNotifications() { 
        const saved = localStorage.getItem('order_notifications'); 
        notifications = saved ? JSON.parse(saved) : []; 
        updateNotificationUI(); 
        updateNotificationBadge();
    }
    
    function saveNotifications() { 
        localStorage.setItem('order_notifications', JSON.stringify(notifications)); 
        updateNotificationUI(); 
        updateNotificationBadge();
    }
    
    function addNotification(title, message, orderId, type) {
        const notification = { id: Date.now(), title, message, orderId, type, timestamp: new Date().toISOString(), read: false };
        notifications.unshift(notification);
        if (notifications.length > 100) notifications = notifications.slice(0, 100);
        saveNotifications();
        showToast(message, type);
        updateTrackerBadge();
    }
    
    function updateNotificationBadge() {
        const unreadCount = notifications.filter(n => !n.read).length;
        const badge = document.getElementById('notificationBadge');
        if (badge) { 
            if (unreadCount > 0) { 
                badge.classList.add('show'); 
                badge.textContent = unreadCount > 99 ? '99+' : unreadCount; 
            } else { 
                badge.classList.remove('show'); 
            } 
        }
    }
    
    function markAllNotificationsAsRead() {
        if (notifications.length > 0) {
            let hasUnread = notifications.some(n => !n.read);
            if (hasUnread) {
                notifications.forEach(n => n.read = true);
                saveNotifications();
                updateNotificationBadge();
            }
        }
    }
    
    function markAllNotificationsAsReadBeforeRedirect() {
        markAllNotificationsAsRead();
        window.location.href = '{{ path('app_notifications_index') }}';
    }
    
    function updateNotificationUI() {
        const list = document.getElementById('notificationList');
        if (!list) return;
        
        if (notifications.length === 0) { 
            list.innerHTML = '<div style="padding:20px;text-align:center;color:#6c757d;"><i class="fas fa-bell-slash"></i> No notifications</div>'; 
        } else { 
            const recentNotifications = notifications.slice(0, 5);
            list.innerHTML = recentNotifications.map(n => `
                <div class="notification-item ${n.read ? '' : 'unread'}" onclick="markNotificationAsRead(${n.id})">
                    <div class="notification-title">${n.title}</div>
                    <div class="notification-message">${n.message}</div>
                    <div class="notification-time">${formatTimeAgo(n.timestamp)}</div>
                </div>
            `).join('');
            
            if (notifications.length > 5) {
                list.innerHTML += '<div style="padding:10px;text-align:center;"><a href="#" onclick="markAllNotificationsAsReadBeforeRedirect(); return false;" style="color:#3498db;text-decoration:none;font-size:12px;">View all ' + notifications.length + ' notifications →</a></div>';
            }
        }
    }
    
    function markNotificationAsRead(id) { 
        const notification = notifications.find(n => n.id === id); 
        if (notification) { 
            notification.read = true; 
            saveNotifications(); 
        } 
    }
    
    function clearAllNotifications() { 
        if (confirm('Clear all notifications?')) { 
            notifications = []; 
            saveNotifications(); 
            showToast('All notifications cleared', 'info'); 
        } 
    }
    
    function formatTimeAgo(timestamp) { 
        const date = new Date(timestamp), now = new Date(), mins = Math.floor((now - date) / 60000), hours = Math.floor(mins / 60), days = Math.floor(hours / 24); 
        if (mins < 1) return 'Just now'; 
        if (mins < 60) return `${mins} min ago`; 
        if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`; 
        return `${days} day${days > 1 ? 's' : ''} ago`; 
    }
    
    function toggleNotificationDropdown() { 
        const dropdown = document.getElementById('notificationDropdown');
        if (dropdown) {
            markAllNotificationsAsRead();
            dropdown.classList.toggle('show');
        }
    }

    // ============================================
    // PROFILE DROPDOWN FUNCTIONS
    // ============================================
    function toggleProfileDropdown() {
        const dropdown = document.getElementById('profileDropdown');
        const header = document.getElementById('profileHeader');
        if (dropdown && header) {
            dropdown.classList.toggle('show');
            header.classList.toggle('active');
        }
    }

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
        const notificationDropdown = document.getElementById('notificationDropdown');
        const notificationIcon = document.getElementById('notificationIcon');
        if (notificationDropdown && notificationIcon && !notificationIcon.contains(event.target) && !notificationDropdown.contains(event.target)) {
            notificationDropdown.classList.remove('show');
        }
        
        const profileDropdown = document.getElementById('profileDropdown');
        const profileHeader = document.getElementById('profileHeader');
        if (profileDropdown && profileHeader && !profileHeader.contains(event.target) && !profileDropdown.contains(event.target)) {
            profileDropdown.classList.remove('show');
            profileHeader.classList.remove('active');
        }
    });

    // ============================================
    // ADD TO CART FUNCTIONS
    // ============================================
    function openAddToCartModal(id, name, price, stock, img) {
        addCartStockId = id; addCartMaxStock = stock; addCartPrice = price;
        document.getElementById('addCartProductName').textContent = name;
        document.getElementById('addCartProductPrice').textContent = '₱' + price.toLocaleString('en-US', {minimumFractionDigits: 2});
        document.getElementById('addCartStockAmount').textContent = stock;
        let imgEl = document.getElementById('addCartProductImage');
        if (img) { let path = img; if (!path.startsWith('http') && !path.startsWith('/')) path = '/uploads/' + path; imgEl.src = path; imgEl.onerror = () => imgEl.src = '{{ asset('images/placeholder.png') }}'; }
        else imgEl.src = '{{ asset('images/placeholder.png') }}';
        document.getElementById('addCartQuantity').value = 1; updateAddCartTotal();
        document.getElementById('addToCartModal').classList.add('show');
    }
    
    function closeAddToCartModal() { document.getElementById('addToCartModal').classList.remove('show'); addCartStockId = null; }
    
    function incrementAddCartQuantity() { let input = document.getElementById('addCartQuantity'), val = parseInt(input.value) || 1; if (val < addCartMaxStock) { input.value = val + 1; updateAddCartTotal(); } else showToast('Maximum stock is ' + addCartMaxStock, 'warning'); }
    
    function decrementAddCartQuantity() { let input = document.getElementById('addCartQuantity'), val = parseInt(input.value) || 1; if (val > 1) { input.value = val - 1; updateAddCartTotal(); } }
    
    function updateAddCartTotal() { let qty = parseInt(document.getElementById('addCartQuantity').value) || 1; document.getElementById('addCartTotalAmount').textContent = (addCartPrice * qty).toLocaleString('en-US', {minimumFractionDigits: 2}); }
    
    function confirmAddToCart() {
        if (!addCartStockId) return;
        let qty = parseInt(document.getElementById('addCartQuantity').value) || 1;
        if (qty > addCartMaxStock) { showToast('Not enough stock', 'error'); return; }
        let form = document.createElement('form'); form.method = 'POST'; form.action = '{{ path('app_cart_add', {'stockId': '__ID__'}) }}'.replace('__ID__', addCartStockId);
        let qtyField = document.createElement('input'); qtyField.type = 'hidden'; qtyField.name = 'quantity'; qtyField.value = qty; form.appendChild(qtyField);
        document.body.appendChild(form); form.submit();
        closeAddToCartModal();
        showToast('✓ Product added to cart!', 'success');
        setTimeout(() => updateCartBadge(), 500);
    }

    // ============================================
    // BUY NOW FUNCTIONS
    // ============================================
    function initializePhoneInput() {
        if (phoneInputInstance) return;
        
        const phoneInput = document.querySelector("#customerPhone");
        if (phoneInput && typeof window.intlTelInput !== 'undefined') {
            phoneInputInstance = window.intlTelInput(phoneInput, {
                initialCountry: "ph",
                separateDialCode: true,
                preferredCountries: ["ph", "us", "gb", "au", "ca", "sg", "my", "jp", "kr", "cn", "in", "de", "fr", "it", "es", "br", "mx"],
                utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js",
                formatOnDisplay: true,
                autoHideDialCode: false,
                nationalMode: false
            });
            
            phoneInput.addEventListener('blur', validatePhone);
            phoneInput.addEventListener('countrychange', function() {
                validatePhone();
                saveCheckoutInfo();
            });
            phoneInput.addEventListener('input', saveCheckoutInfo);
        }
    }
    
    function openBuyNowModal(id, name, price, stock, img) {
        buyNowStockId = id; 
        buyNowMaxStock = stock; 
        buyNowPrice = price;
        
        document.getElementById('buyNowProductName').textContent = name;
        document.getElementById('buyNowProductPrice').textContent = '₱' + price.toLocaleString('en-US', {minimumFractionDigits: 2});
        document.getElementById('buyNowStockAmount').textContent = stock;
        
        let imgEl = document.getElementById('buyNowProductImage');
        if (img) { 
            let path = img; 
            if (!path.startsWith('http') && !path.startsWith('/')) path = '/uploads/' + path; 
            imgEl.src = path; 
            imgEl.onerror = () => imgEl.src = '{{ asset('images/placeholder.png') }}'; 
        } else { 
            imgEl.src = '{{ asset('images/placeholder.png') }}'; 
        }
        
        document.getElementById('buyNowQuantity').value = 1; 
        updateBuyNowTotal();
        document.getElementById('buyNowModal').classList.add('show');
        
        initializePhoneInput();
        
        const emailInput = document.getElementById('customerEmail');
        if (emailInput) {
            emailInput.addEventListener('blur', checkEmailValidation);
            emailInput.addEventListener('input', function() {
                if (this.value.trim()) checkEmailValidation();
            });
        }
        
        const loggedInEmail = '{{ app.user.email ?? '' }}';
        if (loggedInEmail && emailInput && !emailInput.value) {
            emailInput.value = loggedInEmail;
        }
    }
    
    function closeBuyNowModal() { 
        document.getElementById('buyNowModal').classList.remove('show'); 
        buyNowStockId = null;
    }
    
    function incrementBuyNowQuantity() { 
        let input = document.getElementById('buyNowQuantity'), val = parseInt(input.value) || 1; 
        if (val < buyNowMaxStock) { 
            input.value = val + 1; 
            updateBuyNowTotal(); 
        } else { 
            showToast('Maximum stock is ' + buyNowMaxStock, 'warning'); 
        } 
    }
    
    function decrementBuyNowQuantity() { 
        let input = document.getElementById('buyNowQuantity'), val = parseInt(input.value) || 1; 
        if (val > 1) { 
            input.value = val - 1; 
            updateBuyNowTotal(); 
        } 
    }
    
    function updateBuyNowTotal() { 
        let qty = parseInt(document.getElementById('buyNowQuantity').value) || 1; 
        document.getElementById('buyNowTotalAmount').textContent = (buyNowPrice * qty).toLocaleString('en-US', {minimumFractionDigits: 2}); 
    }
    
    function toggleAddressField() { 
        const addressField = document.getElementById('addressField');
        const addressTextarea = document.getElementById('deliveryAddress');
        if (document.getElementById('deliveryMethod').value === 'shipping') {
            addressField.style.display = 'block';
            addressTextarea.required = true;
        } else {
            addressField.style.display = 'none';
            addressTextarea.required = false;
        }
    }
    
    function selectPaymentMethod(method) { 
        document.querySelectorAll('.payment-method').forEach(el => el.classList.remove('selected')); 
        document.querySelector(`.payment-method[data-payment="${method}"]`).classList.add('selected'); 
        document.getElementById('selectedPaymentMethod').value = method; 
    }
    
    function getFullPhoneNumber() {
        if (phoneInputInstance) return phoneInputInstance.getNumber();
        return '';
    }
    
    function saveCheckoutInfo() {
        let name = document.getElementById('customerName')?.value || '';
        let email = document.getElementById('customerEmail')?.value || '';
        let fullPhone = phoneInputInstance ? phoneInputInstance.getNumber() : '';
        let delivery = document.getElementById('deliveryMethod')?.value || 'pickup';
        let address = document.getElementById('deliveryAddress')?.value || '';
        let payment = document.getElementById('selectedPaymentMethod')?.value || 'cod';
        let countryCode = phoneInputInstance ? phoneInputInstance.getSelectedCountryData().iso2 : 'ph';
        
        fetch('/cart/save-checkout-info', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, phone: fullPhone, countryCode, delivery, address, payment })
        }).catch(e => console.error('Save error:', e));
    }
    
    function confirmBuyNow() {
        if (!buyNowStockId) return;
        
        let qty = parseInt(document.getElementById('buyNowQuantity').value) || 1;
        if (qty > buyNowMaxStock) { showToast('Not enough stock', 'error'); return; }
        
        let name = document.getElementById('customerName').value.trim();
        let email = document.getElementById('customerEmail').value.trim();
        let fullPhone = getFullPhoneNumber();
        let delivery = document.getElementById('deliveryMethod').value;
        let address = document.getElementById('deliveryAddress').value.trim();
        let payment = document.getElementById('selectedPaymentMethod').value;
        
        if (!name) { showToast('Please enter your full name', 'error'); return; }
        if (!email) { showToast('Please enter your email address', 'error'); return; }
        if (!validateEmail(email)) { showToast('Please enter a valid email address', 'error'); return; }
        if (!fullPhone) { showToast('Please enter your contact number', 'error'); return; }
        if (phoneInputInstance && !phoneInputInstance.isValidNumber()) { showToast('Invalid contact number', 'error'); return; }
        if (delivery === 'shipping' && !address) { showToast('Please enter delivery address', 'error'); return; }
        
        fetch('/cart/save-checkout-info', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, phone: fullPhone, delivery, address, payment })
        }).then(response => response.json()).then(data => {
            if (data.success) {
                let form = document.createElement('form'); 
                form.method = 'POST'; 
                form.action = '{{ path('app_buy_now', {'stockId': '__ID__'}) }}'.replace('__ID__', buyNowStockId);
                let qtyField = document.createElement('input'); 
                qtyField.type = 'hidden'; 
                qtyField.name = 'quantity'; 
                qtyField.value = qty; 
                form.appendChild(qtyField);
                document.body.appendChild(form); 
                form.submit();
            } else {
                showToast(data.message || 'Error saving info', 'error');
            }
        }).catch(() => { showToast('Error saving info', 'error'); });
    }

    // ============================================
    // CHECK ORDER UPDATES
    // ============================================
    function checkOrderUpdates() {
        fetch('{{ path('app_order_check_updates') }}')
            .then(res => res.json())
            .then(data => {
                if (data.updates && data.updates.length > 0) {
                    updateTrackerBadge();
                    data.updates.forEach(update => {
                        let exists = notifications.find(n => n.orderId === update.orderId && n.message.includes(update.newStatus));
                        if (!exists) {
                            let title = '', message = '', type = 'info';
                            switch(update.newStatus) {
                                case 'processing': title = '📦 Order Processing'; message = `Order #${update.orderId} is now being processed.`; break;
                                case 'packaging': title = '📦 Packaging Your Order'; message = `Order #${update.orderId} is being packed.`; break;
                                case 'ready_for_pickup': title = '✅ Ready for Pickup!'; message = `Order #${update.orderId} is ready for pickup.`; type = 'success'; break;
                                case 'shipped': title = '🚚 Order Shipped!'; message = `Order #${update.orderId} has been shipped.`; type = 'success'; break;
                                case 'delivered': title = '🏠 Order Delivered'; message = `Order #${update.orderId} has been delivered.`; type = 'success'; break;
                                case 'complete': title = '✅ Order Complete'; message = `Order #${update.orderId} has been completed.`; type = 'success'; break;
                                case 'cancelled': title = '❌ Order Cancelled'; message = `Order #${update.orderId} has been cancelled.`; type = 'warning'; break;
                                default: return;
                            }
                            addNotification(title, message, update.orderId, type);
                        }
                    });
                }
            })
            .catch(e => console.error('Polling error:', e));
    }

    // ============================================
    // MOBILE SIDEBAR
    // ============================================
    let sidebarInit = false;
    function initMobileSidebar() {
        if (sidebarInit) return;
        let toggle = document.getElementById('menuToggle'), sidebar = document.getElementById('sidebar'), overlay = document.getElementById('sidebarOverlay');
        if (!toggle || !sidebar) return;
        function open() { sidebar.classList.add('mobile-open'); if (overlay) overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
        function close() { sidebar.classList.remove('mobile-open'); if (overlay) overlay.classList.remove('active'); document.body.style.overflow = ''; }
        toggle.addEventListener('click', e => { e.stopPropagation(); sidebar.classList.contains('mobile-open') ? close() : open(); });
        if (overlay) overlay.addEventListener('click', close);
        document.addEventListener('click', e => { if (window.innerWidth <= 768 && sidebar.classList.contains('mobile-open') && !sidebar.contains(e.target) && !toggle.contains(e.target)) close(); });
        window.addEventListener('resize', () => { if (window.innerWidth > 768 && sidebar.classList.contains('mobile-open')) close(); });
        sidebarInit = true;
    }

    let shownFlashes = [];
    function initFlashMessages() {
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                let msg = '{{ message|escape('js') }}';
                if (!shownFlashes.includes(msg)) { shownFlashes.push(msg); showToast(msg, '{{ label }}'); }
            {% endfor %}
        {% endfor %}
    }

    let dropdownInit = false;
    function initializeDropdown() {
        if (dropdownInit) return;
        let header = document.getElementById('profileHeader'), dropdown = document.getElementById('profileDropdown');
        if (header && dropdown) {
            header.addEventListener('click', function(e) {
                e.stopPropagation();
                toggleProfileDropdown();
            });
            dropdownInit = true;
        }
        let changeBtn = document.getElementById('changeProfilePicBtn');
        if (changeBtn) changeBtn.addEventListener('click', e => { e.preventDefault(); showUploadModal(); });
    }

    function showUploadModal() {
        let existing = document.getElementById('uploadModal'); if (existing) existing.remove();
        let modal = document.createElement('div'); modal.id = 'uploadModal'; modal.className = 'modal';
        modal.innerHTML = `<div class="modal-content"><div class="modal-header"><h3>Change Profile Picture</h3><button class="close-modal">&times;</button></div><div class="modal-body"><div class="upload-area" id="uploadArea"><i class="fas fa-cloud-upload-alt"></i><p>Click to upload or drag and drop</p><small>PNG, JPG, GIF, WebP up to 2MB</small></div><div class="image-preview" id="imagePreview" style="display:none;"><img src="" alt="Preview"></div><div class="upload-progress" id="uploadProgress" style="display:none;"><div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div><span id="progressText">0%</span></div></div><div class="modal-footer"><button class="btn-secondary-modal" id="cancelUpload">Cancel</button><button class="btn-primary-modal" id="saveUpload" disabled>Upload</button></div></div>`;
        document.body.appendChild(modal); setTimeout(() => modal.classList.add('show'), 10);
        let uploadArea = document.getElementById('uploadArea'), preview = document.getElementById('imagePreview'), previewImg = preview.querySelector('img'), saveBtn = document.getElementById('saveUpload'), cancelBtn = document.getElementById('cancelUpload'), closeBtn = modal.querySelector('.close-modal'), progressContainer = document.getElementById('uploadProgress'), progressFill = document.getElementById('progressFill'), progressText = document.getElementById('progressText');
        let fileInput = document.createElement('input'); fileInput.type = 'file'; fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp'; fileInput.style.display = 'none'; modal.appendChild(fileInput);
        uploadArea.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', e => { let file = e.target.files[0]; if (file) { if (!['image/jpeg','image/png','image/gif','image/webp'].includes(file.type)) { showToast('Invalid image type', 'error'); return; } if (file.size > 2*1024*1024) { showToast('File too large (max 2MB)', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; }; reader.readAsDataURL(file); } });
        uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.style.borderColor = '#007bff'; });
        uploadArea.addEventListener('drop', e => { e.preventDefault(); let file = e.dataTransfer.files[0]; if (file && file.type.startsWith('image/')) { if (file.size > 2*1024*1024) { showToast('File too large', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; let dt = new DataTransfer(); dt.items.add(file); fileInput.files = dt.files; }; reader.readAsDataURL(file); } });
        saveBtn.addEventListener('click', () => { if (fileInput.files.length > 0) uploadProfilePicture(fileInput.files[0]); });
        function uploadProfilePicture(file) { let fd = new FormData(); fd.append('profile_picture', file); progressContainer.style.display = 'block'; saveBtn.disabled = true; let xhr = new XMLHttpRequest(); xhr.upload.addEventListener('progress', e => { if (e.lengthComputable) { let pct = Math.round((e.loaded / e.total) * 100); progressFill.style.width = pct + '%'; progressText.textContent = pct + '%'; } }); xhr.addEventListener('load', () => { if (xhr.status === 200) { try { let resp = JSON.parse(xhr.responseText); if (resp.success) { document.querySelector('.profile-avatar').innerHTML = `<img src="${resp.imageUrl}?t=${Date.now()}" alt="{{ app.user.username }}">`; showToast('Profile picture updated!', 'success'); closeUploadModal(); } else { showToast(resp.message || 'Upload failed', 'error'); resetUpload(); } } catch(e) { showToast('Invalid response', 'error'); resetUpload(); } } else { showToast('Upload failed', 'error'); resetUpload(); } }); xhr.addEventListener('error', () => { showToast('Network error', 'error'); resetUpload(); }); xhr.open('POST', '/dashboard/upload-profile-picture', true); xhr.send(fd); }
        function resetUpload() { progressContainer.style.display = 'none'; progressFill.style.width = '0%'; progressText.textContent = '0%'; saveBtn.disabled = false; }
        window.closeUploadModal = () => { modal.classList.remove('show'); setTimeout(() => modal.remove(), 300); };
        cancelBtn.addEventListener('click', closeUploadModal);
        closeBtn.addEventListener('click', closeUploadModal);
        modal.addEventListener('click', e => { if (e.target === modal) closeUploadModal(); });
    }

    function initAll() {
        initMobileSidebar(); 
        initFlashMessages(); 
        initializeDropdown(); 
        loadNotifications();
        
        checkOrderUpdates(); 
        setInterval(checkOrderUpdates, 30000);
        updateCartBadge(); 
        setInterval(updateCartBadge, 5000);
        updateTrackerBadge();
        initializePhoneInput();
        
        document.getElementById('addCartQuantity')?.addEventListener('change', function() { let val = parseInt(this.value) || 1; if (val < 1) val = 1; if (val > addCartMaxStock) val = addCartMaxStock; this.value = val; updateAddCartTotal(); });
        document.getElementById('buyNowQuantity')?.addEventListener('change', function() { let val = parseInt(this.value) || 1; if (val < 1) val = 1; if (val > buyNowMaxStock) val = buyNowMaxStock; this.value = val; updateBuyNowTotal(); });
        document.getElementById('customerName')?.addEventListener('input', saveCheckoutInfo);
        document.getElementById('customerEmail')?.addEventListener('input', saveCheckoutInfo);
        document.getElementById('deliveryMethod')?.addEventListener('change', saveCheckoutInfo);
        document.getElementById('deliveryAddress')?.addEventListener('input', saveCheckoutInfo);
        
        const phoneInput = document.getElementById('customerPhone');
        if (phoneInput) {
            phoneInput.addEventListener('blur', saveCheckoutInfo);
            phoneInput.addEventListener('countrychange', saveCheckoutInfo);
            phoneInput.addEventListener('input', saveCheckoutInfo);
        }
    }

    document.addEventListener('DOMContentLoaded', () => setTimeout(initAll, 100));
    document.addEventListener('turbo:load', () => { sidebarInit = false; dropdownInit = false; setTimeout(initAll, 100); });
</script>
{% endblock %}