        <a href="{{ path('app_cart_view') }}" class="user-cart-icon-link" title="Shopping Cart">
            <i class="fas fa-shopping-cart"></i>
            <span class="user-cart-badge" id="userCartBadge">0</span>
        </a>
        <div class="user-notification-wrapper">
            <button class="user-notification-icon" id="userNotificationIcon" onclick="toggleUserNotificationDropdown()">
                <i class="fas fa-bell"></i>
                <span class="user-notification-badge" id="userNotificationBadge">0</span>
            </button>
            <div class="user-notification-dropdown" id="userNotificationDropdown">
                <div class="notification-header"><i class="fas fa-bell"></i> Notifications</div>
                <div id="userNotificationList"><div style="padding:20px;text-align:center;color:#64748b;"><i class="fas fa-bell-slash"></i> No notifications</div></div>
                <div class="notification-footer">
                    <a href="{{ path('app_notifications_index') }}" class="view-all-link" onclick="markAllUserNotificationsAsReadBeforeRedirect()">View all notifications</a>
                    <button class="clear-notif-btn" onclick="clearAllUserNotifications()">Clear all</button>
                </div>
            </div>
        </div>
        <div class="user-profile-wrapper">
            <div class="user-profile-header" id="userProfileHeader">
                <div class="user-profile-avatar">
                    {% if hasProfilePic %}
                        <img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">
                    {% else %}
                        {{ app.user.username|first|upper }}
                    {% endif %}
                </div>
            </div>
            <div class="user-profile-dropdown" id="userProfileDropdown">
                <div class="dropdown-role-header"><i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}</div>
                <a href="{{ path('app_profile_index') }}" class="dropdown-item"><i class="fas fa-user-circle"></i><span>My Profile</span></a>
                <a href="#" class="dropdown-item" id="userChangeProfilePicBtn"><i class="fas fa-camera"></i><span>Change Picture</span></a>
                <div class="dropdown-divider"></div>
                <a href="{{ path('app_logout') }}" class="dropdown-item logout-item"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a>
            </div>
        </div>
    </div>
</div>
{% endif %}

