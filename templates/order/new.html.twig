<!-- PROFILE VARIABLES -->
<!-- ============================================ -->
{% set role = app.user.roles[0] ?? 'ROLE_USER' %}
{% set hasProfilePic = app.user.profilePicture is defined and app.user.profilePicture is not null %}
{% set userRoleName = role == 'ROLE_ADMIN' ? 'Administrator' : (role == 'ROLE_STAFF' ? 'Staff Member' : 'Customer') %}
{% set userRoleIcon = role == 'ROLE_ADMIN' ? 'crown' : (role == 'ROLE_STAFF' ? 'user-tie' : 'user') %}

<!-- ============================================ -->
<!-- HEADER -->
<!-- ============================================ -->
{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
<div class="admin-header">
    <div class="admin-header-left">
        <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
        <h1><i class="fas fa-store"></i> Marketplace</h1>
    </div>
    <div class="admin-header-right">
        <a href="{{ path('app_order_tracker') }}" class="admin-tracker-icon-link" title="My Orders Tracker">
            <i class="fas fa-box"></i>
            <span class="admin-tracker-badge" id="adminTrackerBadge">0</span>
        </a>
        <a href="{{ path('app_cart_view') }}" class="admin-cart-icon-link" title="Shopping Cart">
            <i class="fas fa-shopping-cart"></i>
            <span class="admin-cart-badge" id="adminCartBadge">0</span>
        </a>
        <div class="admin-notification-wrapper">
            <button class="admin-notification-icon" id="adminNotificationIcon" onclick="toggleAdminNotificationDropdown()">
                <i class="fas fa-bell"></i>
                <span class="admin-notification-badge" id="adminNotificationBadge">0</span>
            </button>
            <div class="admin-notification-dropdown" id="adminNotificationDropdown">
                <div class="notification-header"><i class="fas fa-bell"></i> Notifications</div>
                <div id="adminNotificationList"><div style="padding:20px;text-align:center;color:#64748b;"><i class="fas fa-bell-slash"></i> No notifications</div></div>
                <div class="notification-footer">
                    <a href="{{ path('app_notifications_index') }}" class="view-all-link" onclick="markAllAdminNotificationsAsReadBeforeRedirect()">View all notifications</a>
                    <button class="clear-notif-btn" onclick="clearAllAdminNotifications()">Clear all</button>
                </div>
            </div>
        </div>
        <div class="admin-profile-wrapper">
            <div class="admin-profile-header" id="adminProfileHeader">
                <div class="admin-profile-avatar">
                    {% if hasProfilePic %}
                        <img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">
                    {% else %}
                        {{ app.user.username|first|upper }}
                    {% endif %}
                </div>
            </div>
            <div class="admin-profile-dropdown" id="adminProfileDropdown">
                <div class="dropdown-role-header"><i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}</div>
                <a href="{{ path('app_profile_index') }}" class="dropdown-item"><i class="fas fa-user-circle"></i><span>My Profile</span></a>
                <a href="#" class="dropdown-item" id="adminChangeProfilePicBtn"><i class="fas fa-camera"></i><span>Change Picture</span></a>
                <div class="dropdown-divider"></div>
                <a href="{{ path('app_logout') }}" class="dropdown-item logout-item"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="user-header">
    <a href="{{ path('app_order_new') }}" class="user-logo-link">
        <div class="user-logo-wrapper">
            <img src="{{ asset('images/cart8-01.png') }}" alt="Cartlify">
        </div>
