    <a href="{{ path('app_order_new') }}">
        <i class="fas fa-shopping-cart"></i>
        <span>Marketplace</span>
    </a>
    <a href="{{ path('app_order_index') }}">
        <i class="fas fa-receipt"></i>
        <span>Transactions</span>
    </a>
    <a href="{{ path('app_profile_index') }}">
        <i class="fas fa-user"></i>
        <span>Profile</span>
    </a>
    <a href="{{ path('app_logout') }}">
        <i class="fas fa-power-off"></i>
        <span>Logout</span>
    </a>
</div>
{% endif %}

<!-- Sidebar Overlay for Mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

{# Profile Section #}
{% set role = app.user.roles[0] ?? 'ROLE_USER' %}
{% set hasProfilePic = app.user.profilePicture is defined and app.user.profilePicture is not null %}
{% set userRoleName = 
    role == 'ROLE_ADMIN' ? 'Administrator' :
    (role == 'ROLE_STAFF' ? 'Staff Member' : 'User')
%}
{% set userRoleIcon = 
    role == 'ROLE_ADMIN' ? 'crown' :
    (role == 'ROLE_STAFF' ? 'user-tie' : 'user')
%}

<!-- Sticky Header -->
<div class="header">
    <h1>
        <button class="menu-toggle" id="menuToggle">
            <i class="fas fa-bars"></i>
        </button>
        <i class="fas fa-receipt"></i> Transactions
    </h1>
    
    <div class="profile-wrapper">
        <div class="profile-header" id="profileHeader">
            <div class="profile-avatar">
                {% if hasProfilePic %}
                    <img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">
                {% else %}
                    {{ app.user.username|first|upper }}
                {% endif %}
            </div>
            <span class="profile-name">{{ app.user.username }}</span>
            <i class="fas fa-chevron-down dropdown-icon"></i>
        </div>
        
        <div class="profile-dropdown" id="profileDropdown">
            <div class="dropdown-role-header">
                <i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}
            </div>
            <a href="{{ path('app_profile_index') }}" class="dropdown-item">
                <i class="fas fa-user-circle"></i>
                <span>My Profile</span>
            </a>
            <a href="#" class="dropdown-item" id="changeProfilePicBtn">
                <i class="fas fa-camera"></i>
                <span>Change Picture</span>
            </a>
            <div class="dropdown-divider"></div>
            <a href="{{ path('app_logout') }}" class="dropdown-item logout-item">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </div>
    </div>
</div>

<!-- Hidden File Upload Form -->
<form id="profilePicUploadForm" method="post" enctype="multipart/form-data" style="display: none;">
    <input type="file" id="profilePicInput" name="profile_picture" accept="image/*">
</form>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Main Content -->
<div class="main-content">
    <!-- Search Bar -->
    <div class="search-container">
        <div class="search-form-wrapper">
            <form method="get" action="{{ path('app_order_index') }}" class="search-form">
                <input type="text" name="search" value="{{ search|default('') }}" placeholder="Search by product name, description, or order ID..." />
                <button type="submit">
                    <i class="fas fa-search"></i> <span>Search</span>
                </button>
            </form>
            {% if search %}
                <a href="{{ path('app_order_index') }}" class="clear-btn">
                    <i class="fas fa-times"></i> <span>Clear</span>
                </a>
            {% endif %}
        </div>
        
        <a href="{{ path('app_order_new') }}" class="btn btn-success create-btn">
            <i class="fas fa-shopping-cart"></i> <span>Place New Order</span>
        </a>
    </div>

    <!-- Desktop Table View -->
    <div class="table-view">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Product</th>
                        <th>Image</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>Ordered At</th>
                    </tr>
                </thead>
                <tbody>
                {% for order in orders %}
                    <tr>
                        <td style="font-weight: 500;">#{{ order.id }}</td>
                        <td><strong>{{ order.stock.product.name }}</strong></td>
                        <td>
                            {% if order.stock.product.image %}
                                {% set imagePath = order.stock.product.image %}
                                {% if not (imagePath starts with 'http' or imagePath starts with '/') %}
                                    {% set imagePath = '/uploads/' ~ imagePath %}
                                {% endif %}
                                <img src="{{ imagePath }}" 
                                     class="thumbnail" 
                                     alt="{{ order.stock.product.name }}"
                                     onerror="this.onerror=null; this.src='{{ asset('images/placeholder.png') }}';">
                            {% else %}
                                <span class="text-muted">No Image</span>
                            {% endif %}
                        </td>
                        <td>{{ order.quantity }}</td>
                        <td style="color: #28a745; font-weight: 600;">₱{{ order.totalAmount|number_format(2, '.', ',') }}</td>
                        <td>{{ order.createdAt ? order.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted" style="text-align: center; padding: 60px 20px;">
                            <i class="fas fa-box-open" style="font-size: 48px; margin-bottom: 15px; display: block; color: #6c757d;"></i>
                            {% if search %}
                                No transactions found for "{{ search }}"
                            {% else %}
                                No orders found
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Mobile Card View -->
    <div class="order-cards-view">
        {% for order in orders %}
            <div class="order-card">
                <div class="order-card-image">
                    {% if order.stock.product.image %}
                        {% set imagePath = order.stock.product.image %}
                        {% if not (imagePath starts with 'http' or imagePath starts with '/') %}
                            {% set imagePath = '/uploads/' ~ imagePath %}
                        {% endif %}
                        <img src="{{ imagePath }}" alt="{{ order.stock.product.name }}">
                    {% else %}
                        <div class="no-image">
                            <i class="fas fa-image" style="font-size: 48px; color: #adb5bd; margin-bottom: 8px; display: block;"></i>
                            <span>No Image</span>
                        </div>
                    {% endif %}
                </div>
                <div class="order-card-content">
                    <div class="order-card-header">
                        <span class="order-card-id">#{{ order.id }}</span>
                        <span class="order-card-date">
                            <i class="fas fa-calendar-alt"></i> {{ order.createdAt ? order.createdAt|date('M d, Y H:i') : 'N/A' }}
                        </span>
                    </div>
                    <div class="order-card-product">{{ order.stock.product.name }}</div>
                    <div class="order-card-details">
                        <span class="order-card-quantity"><i class="fas fa-cubes"></i> Quantity: {{ order.quantity }}</span>
                        <span class="order-card-total">₱{{ order.totalAmount|number_format(2, '.', ',') }}</span>
                    </div>
                </div>
            </div>
        {% else %}
            <div style="text-align: center; padding: 60px 20px; background: #fff; border-radius: 12px;">
                <i class="fas fa-box-open" style="font-size: 48px; margin-bottom: 15px; display: block; color: #6c757d;"></i>
                <p style="margin: 0; color: #6c757d; font-size: 16px;">No orders found</p>
                {% if search %}
                    <p style="margin: 10px 0 0 0; color: #adb5bd; font-size: 14px;">for "{{ search }}"</p>
                {% endif %}
                <a href="{{ path('app_order_new') }}" class="btn btn-success" style="margin-top: 15px;">
                    <i class="fas fa-shopping-cart"></i> Place New Order
                </a>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Add Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
// Toast Notification System
function showToast(message, type = 'success') {
    let container = document.getElementById('toastContainer');
    if (!container) {
        container = document.createElement('div');
        container.id = 'toastContainer';
        container.className = 'toast-container';
        document.body.appendChild(container);
    }
    
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    
    let icon = '';
    if (type === 'success') icon = '✓';
    if (type === 'error') icon = '✗';
    if (type === 'warning') icon = '⚠';
    if (type === 'info') icon = 'ℹ';
    
    toast.innerHTML = `
        <div class="toast-icon">${icon}</div>
        <div class="toast-content">${message}</div>
        <div class="toast-progress"></div>
    `;
    
    container.appendChild(toast);
    
    setTimeout(() => {
        toast.style.animation = 'slideOutRight 0.3s ease';
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

// Mobile Sidebar Toggle - Fixed version
let sidebarInitialized = false;

function initMobileSidebar() {
    if (sidebarInitialized) return;
    
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    
    if (!menuToggle || !sidebar) return;
    
    function openSidebar() {
        sidebar.classList.add('mobile-open');
        if (overlay) overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    
    function closeSidebar() {
        sidebar.classList.remove('mobile-open');
        if (overlay) overlay.classList.remove('active');
        document.body.style.overflow = '';
    }
    
    const newToggle = menuToggle.cloneNode(true);
    menuToggle.parentNode.replaceChild(newToggle, menuToggle);
    const newMenuToggle = document.getElementById('menuToggle');
    
    newMenuToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        const sidebarEl = document.getElementById('sidebar');
        if (sidebarEl.classList.contains('mobile-open')) {
            closeSidebar();
        } else {
            openSidebar();
        }
    });
    
    if (overlay) {
        const newOverlay = overlay.cloneNode(true);
        overlay.parentNode.replaceChild(newOverlay, overlay);
        const newOverlayEl = document.getElementById('sidebarOverlay');
        newOverlayEl.addEventListener('click', closeSidebar);
    }
    
    document.addEventListener('click', function(e) {
        const currentSidebar = document.getElementById('sidebar');
        const currentMenuToggle = document.getElementById('menuToggle');
        if (window.innerWidth <= 768 && currentSidebar && currentSidebar.classList.contains('mobile-open')) {
            if (!currentSidebar.contains(e.target) && !currentMenuToggle.contains(e.target)) {
                closeSidebar();
            }
        }
    });
    
    window.addEventListener('resize', function() {
        const currentSidebar = document.getElementById('sidebar');
        if (window.innerWidth > 768 && currentSidebar && currentSidebar.classList.contains('mobile-open')) {
            closeSidebar();
        }
    });
    
    sidebarInitialized = true;
}

// Display flash messages
function initFlashMessages() {
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            showToast('{{ message|escape('js') }}', '{{ label }}');
        {% endfor %}
    {% endfor %}
}

// Profile dropdown
let dropdownInitialized = false;

function initializeDropdown() {
    if (dropdownInitialized) return;
    
    const profileHeader = document.getElementById('profileHeader');
    const profileDropdown = document.getElementById('profileDropdown');
    const changePicBtn = document.getElementById('changeProfilePicBtn');
    
    if (profileHeader && profileDropdown) {
        const newHeader = profileHeader.cloneNode(true);
        profileHeader.parentNode.replaceChild(newHeader, profileHeader);
        const newProfileHeader = document.getElementById('profileHeader');
        
        newProfileHeader.addEventListener('click', function(e) {
            e.stopPropagation();
            this.classList.toggle('active');
            const dropdown = document.getElementById('profileDropdown');
            if (dropdown) dropdown.classList.toggle('show');
        });
        
        document.addEventListener('click', function(e) {
            const header = document.getElementById('profileHeader');
            const dropdown = document.getElementById('profileDropdown');
            if (header && dropdown && !header.contains(e.target) && !dropdown.contains(e.target)) {
                header.classList.remove('active');
                dropdown.classList.remove('show');
            }
        });
        
        dropdownInitialized = true;
    }
    
    if (changePicBtn) {
        const newChangeBtn = changePicBtn.cloneNode(true);
        changePicBtn.parentNode.replaceChild(newChangeBtn, changePicBtn);
        const newChangePicBtn = document.getElementById('changeProfilePicBtn');
        if (newChangePicBtn) {
            newChangePicBtn.addEventListener('click', function(e) {
                e.preventDefault();
                showUploadModal();
            });
        }
    }
}

function showUploadModal() {
    const existingModal = document.getElementById('uploadModal');
    if (existingModal) existingModal.remove();
    
    const modal = document.createElement('div');
    modal.id = 'uploadModal';
    modal.className = 'modal';
    modal.innerHTML = `
        <div class="modal-content">
            <div class="modal-header">
                <h3>Change Profile Picture</h3>
                <button class="close-modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Click to upload or drag and drop</p>
                    <small>PNG, JPG, GIF, WebP up to 2MB</small>
                </div>
                <div class="image-preview" id="imagePreview" style="display: none;">
                    <img src="" alt="Preview">
                </div>
                <div class="upload-progress" id="uploadProgress" style="display: none;">
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                    <span id="progressText">0%</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary-modal" id="cancelUpload">Cancel</button>
                <button class="btn-primary-modal" id="saveUpload" disabled>Upload</button>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    setTimeout(() => modal.classList.add('show'), 10);
    
    const uploadArea = document.getElementById('uploadArea');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = imagePreview.querySelector('img');
    const saveBtn = document.getElementById('saveUpload');
    const cancelBtn = document.getElementById('cancelUpload');
    const closeBtn = modal.querySelector('.close-modal');
    const progressContainer = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');
    
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp';
    fileInput.style.display = 'none';
    modal.appendChild(fileInput);
    
    uploadArea.addEventListener('click', () => fileInput.click());
    
    fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
            if (!validTypes.includes(file.type)) {
                showToast('Please upload a valid image file (JPEG, PNG, GIF, WebP)', 'error');
                return;
            }
            if (file.size > 2 * 1024 * 1024) {
                showToast('File size must be less than 2MB', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                imagePreview.style.display = 'block';
                uploadArea.style.display = 'none';
                saveBtn.disabled = false;
            };
            reader.readAsDataURL(file);
        }
    });
    
    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = '#007bff';
        uploadArea.style.backgroundColor = 'rgba(0,123,255,0.05)';
    });
    
    uploadArea.addEventListener('dragleave', () => {
        uploadArea.style.borderColor = '#ced4da';
        uploadArea.style.backgroundColor = 'transparent';
    });
    
    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = '#ced4da';
        uploadArea.style.backgroundColor = 'transparent';
        
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            if (file.size > 2 * 1024 * 1024) {
                showToast('File size must be less than 2MB', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                imagePreview.style.display = 'block';
                uploadArea.style.display = 'none';
                saveBtn.disabled = false;
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                fileInput.files = dataTransfer.files;
            };
            reader.readAsDataURL(file);
        }
    });
    
    saveBtn.addEventListener('click', function() {
        if (fileInput.files.length > 0) {
            uploadProfilePicture(fileInput.files[0]);
        }
    });
    
    function uploadProfilePicture(file) {
        const formData = new FormData();
        formData.append('profile_picture', file);
        
        progressContainer.style.display = 'block';
        saveBtn.disabled = true;
        
        const xhr = new XMLHttpRequest();
        
        xhr.upload.addEventListener('progress', function(e) {
            if (e.lengthComputable) {
                const percentComplete = Math.round((e.loaded / e.total) * 100);
                progressFill.style.width = percentComplete + '%';
                progressText.textContent = percentComplete + '%';
            }
        });
        
        xhr.addEventListener('load', function() {
            if (xhr.status === 200) {
                try {
                    const response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        updateProfilePicture(response.imageUrl);
                        showToast('Profile picture updated successfully!', 'success');
                        modal.classList.remove('show');
                        setTimeout(() => modal.remove(), 300);
                    } else {
                        showToast(response.message || 'Upload failed', 'error');
                        resetUpload();
                    }
                } catch (e) {
                    showToast('Invalid server response', 'error');
                    resetUpload();
                }
            } else {
                showToast('Upload failed. Please try again.', 'error');
                resetUpload();
            }
        });
        
        xhr.addEventListener('error', function() {
            showToast('Network error. Please try again.', 'error');
            resetUpload();
        });
        
        xhr.open('POST', '/dashboard/upload-profile-picture', true);
        xhr.send(formData);
    }
    
    function resetUpload() {
        progressContainer.style.display = 'none';
        progressFill.style.width = '0%';
        progressText.textContent = '0%';
        saveBtn.disabled = false;
    }
    
    function updateProfilePicture(imageUrl) {
        const avatar = document.querySelector('.profile-avatar');
        const url = imageUrl + '?t=' + new Date().getTime();
        avatar.innerHTML = `<img src="${url}" alt="{{ app.user.username }}">`;
    }
    
    function closeModal() {
        modal.classList.remove('show');
        setTimeout(() => modal.remove(), 300);
    }
    
    cancelBtn.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
    });
}

// Initialize all
function initAll() {
    initMobileSidebar();
    initFlashMessages();
    initializeDropdown();
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(initAll, 100);
});

// Handle Turbo navigation
document.addEventListener('turbo:load', function() {
    sidebarInitialized = false;
    dropdownInitialized = false;
    setTimeout(initAll, 100);
});
</script>
{% endblock %}