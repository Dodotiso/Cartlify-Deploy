{% set role = app.user.roles[0] ?? 'ROLE_USER' %}
{% set hasProfilePic = app.user.profilePicture is defined and app.user.profilePicture is not null %}
{% set userRoleName = role == 'ROLE_ADMIN' ? 'Administrator' : (role == 'ROLE_STAFF' ? 'Staff Member' : 'Customer') %}
{% set userRoleIcon = role == 'ROLE_ADMIN' ? 'crown' : (role == 'ROLE_STAFF' ? 'user-tie' : 'user') %}

<div class="header">
    <h1>
        <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
        <i class="fas fa-receipt"></i> Order Management
    </h1>
    <div class="header-right">
        <a href="{{ path('app_order_tracker') }}" class="tracker-icon-link" title="My Orders Tracker">
            <i class="fas fa-box"></i>
            <span class="tracker-badge" id="trackerBadge">0</span>
        </a>
        <a href="{{ path('app_cart_view') }}" class="cart-icon-link" title="Shopping Cart">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-badge" id="cartBadge">0</span>
        </a>
        <div class="notification-wrapper">
            <button class="notification-icon" id="notificationIcon" onclick="toggleNotificationDropdown()">
                <i class="fas fa-bell"></i>
                <span class="notification-badge" id="notificationBadge">0</span>
            </button>
            <div class="notification-dropdown" id="notificationDropdown">
                <div class="notification-header"><i class="fas fa-bell"></i> Notifications</div>
                <div id="notificationList"><div style="padding:20px;text-align:center;color:#64748b;"><i class="fas fa-bell-slash"></i> No notifications</div></div>
                <div class="notification-footer">
                    <a href="{{ path('app_notifications_index') }}" class="view-all-link" onclick="markAllNotificationsAsReadBeforeRedirect()">View all notifications</a>
                    <button class="clear-notif-btn" onclick="clearAllNotifications()">Clear all</button>
                </div>
            </div>
        </div>
        <div class="profile-wrapper">
            <div class="profile-header" id="profileHeader">
                <div class="profile-avatar">
                    {% if hasProfilePic %}
                        <img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">
                    {% else %}
                        {{ app.user.username|first|upper }}
                    {% endif %}
                </div>
            </div>
            <div class="profile-dropdown" id="profileDropdown">
                <div class="dropdown-role-header"><i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}</div>
                <a href="{{ path('app_profile_index') }}" class="dropdown-item"><i class="fas fa-user-circle"></i><span>My Profile</span></a>
                <a href="#" class="dropdown-item" id="changeProfilePicBtn"><i class="fas fa-camera"></i><span>Change Picture</span></a>
                <div class="dropdown-divider"></div>
                <a href="{{ path('app_logout') }}" class="dropdown-item logout-item"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a>
            </div>
        </div>
    </div>
</div>

<form id="profilePicUploadForm" method="post" enctype="multipart/form-data" style="display: none;">
    <input type="file" id="profilePicInput" name="profile_picture" accept="image/*">
</form>
<div class="toast-container" id="toastContainer"></div>

<div class="main-content">
    <div class="search-section">
        <div class="search-container">
            <div class="search-form-wrapper">
                <form method="get" action="{{ path('app_order_index') }}" class="search-form" id="searchForm">
                    <input type="text" name="search" id="searchInput" value="{{ search|default('') }}" placeholder="Search by product name, description, or order ID...">
                    <button type="submit"><i class="fas fa-search"></i> Search</button>
                </form>
                {% if search %}<a href="{{ path('app_order_index') }}" class="clear-btn"><i class="fas fa-times"></i> Clear</a>{% endif %}
            </div>
        </div>
        <div class="filter-container">
            <div class="filter-group">
                <label><i class="fas fa-filter"></i> Filter by Status:</label>
                <select id="statusFilter" onchange="filterOrders()">
                    <option value="all">📋 All Orders</option>
                    <option value="pending">⏳ Pending</option>
                    <option value="accepted">✅ Accepted</option>
                    <option value="rejected">❌ Rejected</option>
                    <option value="cancelled">🚫 Cancelled</option>
                    <option value="completed">🏆 Completed</option>
                </select>
            </div>
            <button class="filter-reset" onclick="resetFilters()"><i class="fas fa-undo-alt"></i> Reset Filters</button>
        </div>
    </div>

    <!-- Desktop Table View -->
    <div class="table-view">
        <div class="table-container">
            <table id="ordersTable">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Image</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Delivery</th>
                        <th>Payment</th>
                        <th>Process Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                    <tr data-order-status="{{ order.orderStatus }}" data-order-id="{{ order.id }}" data-delivery-type="{{ order.deliveryType }}" data-process-status="{{ order.processStatus }}" class="{% if order.orderStatus in ['rejected', 'cancelled', 'completed'] %}disabled-row{% endif %}">
                        <td style="font-weight: 600; color: #3b82f6;">#{{ order.id }}</td>
                        <td>{{ order.customer ? order.customer.username : order.customerName ?: 'Guest' }}</td>
                        <td><strong>{{ order.stock.product.name }}</strong></td>
                        <td>
                            {% if order.stock.product.image %}
                                {% set imagePath = order.stock.product.image %}
                                {% if not (imagePath starts with 'http' or imagePath starts with '/') %}
                                    {% set imagePath = '/uploads/' ~ imagePath %}
                                {% endif %}
                                <img src="{{ imagePath }}" class="thumbnail" alt="{{ order.stock.product.name }}" onerror="this.style.display='none'">
                            {% else %}
                                <span class="status-badge" style="background: #f1f5f9;">No Image</span>
                            {% endif %}
                        </td>
                        <td style="text-align: center;">{{ order.quantity }}</td>
                        <td style="color: #10b981; font-weight: 700;">₱{{ order.totalAmount|number_format(2, '.', ',') }}</td>
                        <td>
                            {% if order.deliveryType == 'pickup' %}
                                <span class="delivery-pickup"><i class="fas fa-store"></i> Pickup</span>
                            {% else %}
                                <span class="delivery-shipping"><i class="fas fa-truck"></i> Shipping</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if order.paymentMethod is defined %}
                                <span class="status-badge" style="background: #d1fae5;">
                                    {% if order.paymentMethod == 'cod' %}💰 COD
                                    {% elseif order.paymentMethod == 'gcash' %}📱 GCash
                                    {% else %}🏦 Bank Transfer{% endif %}
                                </span>
                            {% else %}
                                <span class="status-badge" style="background: #f1f5f9;">Pending</span>
                            {% endif %}
                        </td>
                        <td>
                            <form method="post" action="{{ path('app_order_update_process', {'id': order.id}) }}" onsubmit="return confirmUpdateProcess(this)">
                                <select name="process_status" class="process-select" onchange="checkProcessStatusChange(this, '{{ order.orderStatus }}')" {% if order.orderStatus != 'accepted' or order.orderStatus in ['rejected', 'cancelled', 'completed'] %}disabled{% endif %}>
                                    <option value="pending" {% if order.processStatus == 'pending' %}selected{% endif %}>⏳ Pending</option>
                                    <option value="processing" {% if order.processStatus == 'processing' %}selected{% endif %}>⚙️ Processing</option>
                                    <option value="packaging" {% if order.processStatus == 'packaging' %}selected{% endif %}>📦 Packaging</option>
                                    <option value="ready_for_pickup" {% if order.processStatus == 'ready_for_pickup' %}selected{% endif %}>✅ Ready for Pickup</option>
                                    <option value="shipped" {% if order.processStatus == 'shipped' %}selected{% endif %}>🚚 Shipped</option>
                                    <option value="delivered" {% if order.processStatus == 'delivered' %}selected{% endif %}>🏠 Delivered</option>
                                </select>
                            </form>
                        </td>
                        <td>{{ order.createdAt ? order.createdAt|date('Y-m-d H:i') : 'N/A' }}</td>
                        <td>
                            <div class="action-buttons">
                                {% if order.orderStatus == 'pending' %}
                                    <form method="post" action="{{ path('app_order_accept', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Accept this order?')">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> Accept</button>
                                    </form>
                                    <form method="post" action="{{ path('app_order_reject', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Reject this order? Stock will be restored.')">
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Reject</button>
                                    </form>
                                {% elseif order.orderStatus == 'accepted' %}
                                    <form method="post" action="{{ path('app_order_complete', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirmComplete(this, '{{ order.deliveryType }}', '{{ order.processStatus }}')">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check-circle"></i> Complete</button>
                                    </form>
                                    <form method="post" action="{{ path('app_order_cancel_by_admin', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Cancel this order? Stock will be restored.')">
                                        <button type="submit" class="btn btn-warning btn-sm"><i class="fas fa-ban"></i> Cancel</button>
                                    </form>
                                {% elseif order.orderStatus == 'completed' %}
                                    <button type="button" class="btn btn-secondary btn-sm" disabled><i class="fas fa-lock"></i> Completed</button>
                                    <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Delete this order?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Delete</button>
                                    </form>
                                {% elseif order.orderStatus == 'rejected' %}
                                    <button type="button" class="btn btn-secondary btn-sm" disabled><i class="fas fa-lock"></i> Rejected</button>
                                    <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Delete this order?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Delete</button>
                                    </form>
                                {% elseif order.orderStatus == 'cancelled' %}
                                    <button type="button" class="btn btn-secondary btn-sm" disabled><i class="fas fa-lock"></i> Cancelled</button>
                                    <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Delete this order?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Delete</button>
                                    </form>
                                {% else %}
                                    <a href="{{ path('app_order_show', {'id': order.id}) }}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i> View</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="11" class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <p>{% if search %}No orders found for "{{ search }}"{% else %}No orders found{% endif %}</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Card View -->
    <div class="order-cards-view" id="mobileCardsContainer">
        {% for order in orders %}
        <div class="order-card {% if order.orderStatus in ['rejected', 'cancelled', 'completed'] %}disabled-card{% endif %}" data-order-status="{{ order.orderStatus }}" data-order-id="{{ order.id }}" data-delivery-type="{{ order.deliveryType }}" data-process-status="{{ order.processStatus }}">
            <div class="order-card-image">
                {% if order.stock.product.image %}
                    {% set imagePath = order.stock.product.image %}
                    {% if not (imagePath starts with 'http' or imagePath starts with '/') %}
                        {% set imagePath = '/uploads/' ~ imagePath %}
                    {% endif %}
                    <img src="{{ imagePath }}" alt="{{ order.stock.product.name }}" onerror="this.style.display='none'">
                {% else %}
                    <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#f8fafc;"><i class="fas fa-image" style="font-size:48px;color:#94a3b8;"></i></div>
                {% endif %}
            </div>
            <div class="order-card-content">
                <div class="order-card-header">
                    <span class="order-card-id">#{{ order.id }}</span>
                    <span class="order-card-date"><i class="far fa-calendar-alt"></i> {{ order.createdAt ? order.createdAt|date('M d, Y H:i') : 'N/A' }}</span>
                </div>
                <div class="order-card-product">{{ order.stock.product.name }}</div>
                <div class="order-card-details">
                    <span><i class="fas fa-user"></i> {{ order.customer ? order.customer.username : order.customerName ?: 'Guest' }}</span>
                    <span><i class="fas fa-cubes"></i> Qty: {{ order.quantity }}</span>
                </div>
                <div class="order-card-details">
                    <span class="order-card-total">₱{{ order.totalAmount|number_format(2, '.', ',') }}</span>
                    <span>{% if order.deliveryType == 'pickup' %}<i class="fas fa-store"></i> Pickup{% else %}<i class="fas fa-truck"></i> Shipping{% endif %}</span>
                </div>
                <div class="order-card-details" style="border-top: none;">
                    <span>
                        <span class="status-badge" style="background: #d1fae5;">
                            {% if order.processStatus == 'pending' %}⏳ Pending
                            {% elseif order.processStatus == 'processing' %}⚙️ Processing
                            {% elseif order.processStatus == 'packaging' %}📦 Packaging
                            {% elseif order.processStatus == 'ready_for_pickup' %}✅ Ready
                            {% elseif order.processStatus == 'shipped' %}🚚 Shipped
                            {% else %}🏠 Delivered{% endif %}
                        </span>
                    </span>
                    <span>
                        {% if order.orderStatus == 'pending' %}<span class="status-badge status-pending">⏳ Pending</span>
                        {% elseif order.orderStatus == 'accepted' %}<span class="status-badge status-accepted">✅ Accepted</span>
                        {% elseif order.orderStatus == 'completed' %}<span class="status-badge status-complete">✅ Completed</span>
                        {% elseif order.orderStatus == 'rejected' %}<span class="status-badge status-rejected">❌ Rejected</span>
                        {% elseif order.orderStatus == 'cancelled' %}<span class="status-badge status-cancelled">🚫 Cancelled</span>{% endif %}
                    </span>
                </div>
                <div class="order-card-actions">
                    {% if order.orderStatus == 'pending' %}
                        <form method="post" action="{{ path('app_order_accept', {'id': order.id}) }}" onsubmit="return confirm('Accept this order?')">
                            <button type="submit" class="btn btn-success">Accept</button>
                        </form>
                        <form method="post" action="{{ path('app_order_reject', {'id': order.id}) }}" onsubmit="return confirm('Reject this order?')">
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </form>
                    {% elseif order.orderStatus == 'accepted' %}
                        <form method="post" action="{{ path('app_order_complete', {'id': order.id}) }}" onsubmit="return confirmComplete(this, '{{ order.deliveryType }}', '{{ order.processStatus }}')">
                            <button type="submit" class="btn btn-success">Complete</button>
                        </form>
                        <form method="post" action="{{ path('app_order_cancel_by_admin', {'id': order.id}) }}" onsubmit="return confirm('Cancel this order?')">
                            <button type="submit" class="btn btn-warning">Cancel</button>
                        </form>
                    {% elseif order.orderStatus == 'completed' %}
                        <button type="button" class="btn btn-secondary" disabled>Completed</button>
                        <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" onsubmit="return confirm('Delete this order?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    {% elseif order.orderStatus == 'rejected' %}
                        <button type="button" class="btn btn-secondary" disabled>Rejected</button>
                        <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" onsubmit="return confirm('Delete this order?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    {% elseif order.orderStatus == 'cancelled' %}
                        <button type="button" class="btn btn-secondary" disabled>Cancelled</button>
                        <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" onsubmit="return confirm('Delete this order?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    {% else %}
                        <a href="{{ path('app_order_show', {'id': order.id}) }}" class="btn btn-info">View</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% else %}
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <p>{% if search %}No orders found for "{{ search }}"{% else %}No orders found{% endif %}</p>
        </div>
        {% endfor %}
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
    let notifications = [];
    let shownFlashes = [];

    function confirmComplete(formElement, deliveryType, processStatus) {
        if (deliveryType === 'pickup') {
            if (processStatus !== 'ready_for_pickup' && processStatus !== 'delivered') {
                alert('⚠️ For pickup orders, please update Process Status to "Ready for Pickup" first.');
                return false;
            }
        } else {
            if (processStatus !== 'delivered') {
                alert('⚠️ For shipping orders, please update Process Status to "Delivered" first.');
                return false;
            }
        }
        return confirm('Complete this order? This action cannot be undone.');
    }

    function confirmUpdateProcess(formElement) {
        return confirm('Are you sure you want to update the process status?');
    }

    function checkProcessStatusChange(selectElement, orderStatus) {
        if (orderStatus !== 'accepted') {
            alert('⚠️ You must ACCEPT the order first before updating process status.');
            selectElement.value = selectElement.getAttribute('data-original-value') || 'pending';
            return false;
        }
        if (!selectElement.getAttribute('data-original-value')) {
            selectElement.setAttribute('data-original-value', selectElement.value);
        }
        const newValue = selectElement.value;
        const optionText = selectElement.options[selectElement.selectedIndex]?.text || newValue;
        if (confirm(`Update process status to "${optionText}"?`)) {
            selectElement.form.submit();
            return true;
        } else {
            const originalValue = selectElement.getAttribute('data-original-value');
            if (originalValue) { selectElement.value = originalValue; }
            return false;
        }
    }

    // ✅ FIXED: Silent fail on non-200, no more shaking
    function updateCartBadge() {
        fetch('/cart/count')
            .then(res => { if (!res.ok) return null; return res.json(); })
            .then(data => {
                if (!data) return;
                const badge = document.getElementById('cartBadge');
                if (badge) {
                    if (data.count > 0) { badge.textContent = data.count > 9 ? '9+' : data.count; badge.classList.add('show'); }
                    else { badge.classList.remove('show'); }
                }
            })
            .catch(() => {});
    }

    // ✅ FIXED: Silent fail on non-200
    function updateTrackerBadge() {
        fetch('{{ path('app_new_orders_count') }}')
            .then(res => { if (!res.ok) return null; return res.json(); })
            .then(data => {
                if (!data) return;
                const badge = document.getElementById('trackerBadge');
                if (badge) {
                    if (data.count > 0) { badge.textContent = data.count > 9 ? '9+' : data.count; badge.classList.add('show'); }
                    else { badge.classList.remove('show'); }
                }
            })
            .catch(() => {});
    }

    function filterOrders() {
        const status = document.getElementById('statusFilter').value;
        document.querySelectorAll('#ordersTable tbody tr').forEach(row => {
            row.style.display = (status === 'all' || row.getAttribute('data-order-status') === status) ? '' : 'none';
        });
        document.querySelectorAll('#mobileCardsContainer .order-card').forEach(card => {
            card.style.display = (status === 'all' || card.getAttribute('data-order-status') === status) ? '' : 'none';
        });
    }

    function resetFilters() {
        document.getElementById('statusFilter').value = 'all';
        document.getElementById('searchInput').value = '';
        document.getElementById('searchForm').submit();
    }

    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if (!container) { container = document.createElement('div'); container.id = 'toastContainer'; container.className = 'toast-container'; document.body.appendChild(container); }
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        let icon = type === 'success' ? '✓' : (type === 'error' ? '✗' : (type === 'warning' ? '⚠' : 'ℹ'));
        toast.innerHTML = `<div class="toast-icon">${icon}</div><div class="toast-content">${message}</div><div class="toast-progress"></div>`;
        container.appendChild(toast);
        setTimeout(() => { toast.style.animation = 'slideOutRight 0.3s ease'; setTimeout(() => toast.remove(), 300); }, 3000);
    }

    function loadNotifications() { const saved = localStorage.getItem('order_notifications'); notifications = saved ? JSON.parse(saved) : []; updateNotificationUI(); updateNotificationBadge(); }
    function saveNotifications() { localStorage.setItem('order_notifications', JSON.stringify(notifications)); updateNotificationUI(); updateNotificationBadge(); }

    function addNotification(title, message, orderId, type) {
        const notification = { id: Date.now(), title, message, orderId, type, timestamp: new Date().toISOString(), read: false };
        notifications.unshift(notification);
        if (notifications.length > 100) notifications = notifications.slice(0, 100);
        saveNotifications(); showToast(message, type); updateTrackerBadge();
    }

    function updateNotificationBadge() {
        const unreadCount = notifications.filter(n => !n.read).length;
        const badge = document.getElementById('notificationBadge');
        if (badge) { if (unreadCount > 0) { badge.classList.add('show'); badge.textContent = unreadCount > 99 ? '99+' : unreadCount; } else { badge.classList.remove('show'); } }
    }

    function markAllNotificationsAsRead() {
        if (notifications.some(n => !n.read)) { notifications.forEach(n => n.read = true); saveNotifications(); updateNotificationBadge(); }
    }

    function markAllNotificationsAsReadBeforeRedirect() { markAllNotificationsAsRead(); window.location.href = '{{ path('app_notifications_index') }}'; }

    function updateNotificationUI() {
        const list = document.getElementById('notificationList'); if (!list) return;
        if (notifications.length === 0) { list.innerHTML = '<div style="padding:20px;text-align:center;color:#64748b;"><i class="fas fa-bell-slash"></i> No notifications</div>'; return; }
        const recent = notifications.slice(0, 5);
        list.innerHTML = recent.map(n => `<div class="notification-item ${n.read ? '' : 'unread'}" onclick="markNotificationAsRead(${n.id})"><div class="notification-title">${n.title}</div><div class="notification-message">${n.message}</div><div class="notification-time">${formatTimeAgo(n.timestamp)}</div></div>`).join('');
        if (notifications.length > 5) { list.innerHTML += `<div style="padding:10px;text-align:center;"><a href="#" onclick="markAllNotificationsAsReadBeforeRedirect(); return false;" style="color:#3b82f6;text-decoration:none;font-size:13px;font-weight:500;">View all ${notifications.length} notifications →</a></div>`; }
    }

    function markNotificationAsRead(id) { const n = notifications.find(n => n.id === id); if (n) { n.read = true; saveNotifications(); } }
    function clearAllNotifications() { if (confirm('Clear all notifications?')) { notifications = []; saveNotifications(); showToast('All notifications cleared', 'info'); } }
    function formatTimeAgo(timestamp) { const date = new Date(timestamp), now = new Date(), mins = Math.floor((now - date) / 60000), hours = Math.floor(mins / 60), days = Math.floor(hours / 24); if (mins < 1) return 'Just now'; if (mins < 60) return `${mins} min ago`; if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`; return `${days} day${days > 1 ? 's' : ''} ago`; }
    function toggleNotificationDropdown() { const dropdown = document.getElementById('notificationDropdown'); if (dropdown) { markAllNotificationsAsRead(); dropdown.classList.toggle('show'); } }
    function toggleProfileDropdown() { const dropdown = document.getElementById('profileDropdown'); const header = document.getElementById('profileHeader'); if (dropdown && header) { dropdown.classList.toggle('show'); header.classList.toggle('active'); } }

    document.addEventListener('click', function(event) {
        const nd = document.getElementById('notificationDropdown'), ni = document.getElementById('notificationIcon');
        if (nd && ni && !ni.contains(event.target) && !nd.contains(event.target)) nd.classList.remove('show');
        const pd = document.getElementById('profileDropdown'), ph = document.getElementById('profileHeader');
        if (pd && ph && !ph.contains(event.target) && !pd.contains(event.target)) { pd.classList.remove('show'); ph.classList.remove('active'); }
    });

    // ✅ FIXED: 30s interval, silent fail
    function checkOrderUpdates() {
        fetch('{{ path('app_order_check_updates') }}')
            .then(res => { if (!res.ok) return null; return res.json(); })
            .then(data => {
                if (!data || !data.updates || data.updates.length === 0) return;
                updateTrackerBadge();
                data.updates.forEach(update => {
                    let exists = notifications.find(n => n.orderId === update.orderId && n.message.includes(update.newStatus));
                    if (!exists) {
                        let title = '', message = '', type = 'info';
                        switch(update.newStatus) {
                            case 'processing': title = '📦 Order Processing'; message = `Order #${update.orderId} is now being processed.`; break;
                            case 'packaging': title = '📦 Packaging Your Order'; message = `Order #${update.orderId} is being packed.`; break;
                            case 'ready_for_pickup': title = '✅ Ready for Pickup!'; message = `Order #${update.orderId} is ready for pickup.`; type = 'success'; break;
                            case 'shipped': title = '🚚 Order Shipped!'; message = `Order #${update.orderId} has been shipped.`; type = 'success'; break;
                            case 'delivered': title = '🏠 Order Delivered'; message = `Order #${update.orderId} has been delivered.`; type = 'success'; break;
                            case 'completed': title = '✅ Order Completed'; message = `Order #${update.orderId} has been completed.`; type = 'success'; break;
                            case 'accepted': title = '✅ Order Accepted'; message = `Order #${update.orderId} has been accepted.`; type = 'success'; break;
                            case 'rejected': title = '❌ Order Rejected'; message = `Order #${update.orderId} has been rejected.`; type = 'warning'; break;
                            case 'cancelled': title = '❌ Order Cancelled'; message = `Order #${update.orderId} has been cancelled.`; type = 'warning'; break;
                            default: return;
                        }
                        addNotification(title, message, update.orderId, type);
                    }
                });
            })
            .catch(() => {});
    }

    let sidebarInit = false;
    function initMobileSidebar() {
        if (sidebarInit) return;
        let toggle = document.getElementById('menuToggle'), sidebar = document.getElementById('sidebar'), overlay = document.getElementById('sidebarOverlay');
        if (!toggle || !sidebar) return;
        function open() { sidebar.classList.add('mobile-open'); if (overlay) overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
        function close() { sidebar.classList.remove('mobile-open'); if (overlay) overlay.classList.remove('active'); document.body.style.overflow = ''; }
        toggle.addEventListener('click', e => { e.stopPropagation(); sidebar.classList.contains('mobile-open') ? close() : open(); });
        if (overlay) overlay.addEventListener('click', close);
        document.addEventListener('click', e => { if (window.innerWidth <= 768 && sidebar.classList.contains('mobile-open') && !sidebar.contains(e.target) && !toggle.contains(e.target)) close(); });
        window.addEventListener('resize', () => { if (window.innerWidth > 768 && sidebar.classList.contains('mobile-open')) close(); });
        sidebarInit = true;
    }

    function initFlashMessages() {
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                let msg{{ loop.index }} = '{{ message|escape('js') }}';
                if (!shownFlashes.includes(msg{{ loop.index }})) { shownFlashes.push(msg{{ loop.index }}); showToast(msg{{ loop.index }}, '{{ label }}'); }
            {% endfor %}
        {% endfor %}
    }

    let dropdownInit = false;
    function initializeDropdown() {
        if (dropdownInit) return;
        let header = document.getElementById('profileHeader'), dropdown = document.getElementById('profileDropdown');
        if (header && dropdown) { header.addEventListener('click', function(e) { e.stopPropagation(); toggleProfileDropdown(); }); dropdownInit = true; }
        let changeBtn = document.getElementById('changeProfilePicBtn');
        if (changeBtn) changeBtn.addEventListener('click', e => { e.preventDefault(); showUploadModal(); });
    }

    function showUploadModal() {
        let existing = document.getElementById('uploadModal'); if (existing) existing.remove();
        let modal = document.createElement('div'); modal.id = 'uploadModal'; modal.className = 'modal';
        modal.innerHTML = `<div class="modal-content"><div class="modal-header"><h3>Change Profile Picture</h3><button class="close-modal">&times;</button></div><div class="modal-body"><div class="upload-area" id="uploadArea"><i class="fas fa-cloud-upload-alt"></i><p>Click to upload or drag and drop</p><small>PNG, JPG, GIF, WebP up to 2MB</small></div><div class="image-preview" id="imagePreview" style="display:none;"><img src="" alt="Preview"></div><div class="upload-progress" id="uploadProgress" style="display:none;"><div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div><span id="progressText">0%</span></div></div><div class="modal-footer"><button class="btn-secondary-modal" id="cancelUpload">Cancel</button><button class="btn-primary-modal" id="saveUpload" disabled>Upload</button></div></div>`;
        document.body.appendChild(modal); setTimeout(() => modal.classList.add('show'), 10);
        let uploadArea = document.getElementById('uploadArea'), preview = document.getElementById('imagePreview'), previewImg = preview.querySelector('img'), saveBtn = document.getElementById('saveUpload'), cancelBtn = document.getElementById('cancelUpload'), closeBtn = modal.querySelector('.close-modal'), progressContainer = document.getElementById('uploadProgress'), progressFill = document.getElementById('progressFill'), progressText = document.getElementById('progressText');
        let fileInput = document.createElement('input'); fileInput.type = 'file'; fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp'; fileInput.style.display = 'none'; modal.appendChild(fileInput);
        uploadArea.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', e => { let file = e.target.files[0]; if (file) { if (!['image/jpeg','image/png','image/gif','image/webp'].includes(file.type)) { showToast('Invalid image type', 'error'); return; } if (file.size > 2*1024*1024) { showToast('File too large (max 2MB)', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; }; reader.readAsDataURL(file); } });
        uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.style.borderColor = '#3b82f6'; });
        uploadArea.addEventListener('drop', e => { e.preventDefault(); let file = e.dataTransfer.files[0]; if (file && file.type.startsWith('image/')) { if (file.size > 2*1024*1024) { showToast('File too large', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; let dt = new DataTransfer(); dt.items.add(file); fileInput.files = dt.files; }; reader.readAsDataURL(file); } });
        saveBtn.addEventListener('click', () => { if (fileInput.files.length > 0) uploadProfilePicture(fileInput.files[0]); });
        function uploadProfilePicture(file) { let fd = new FormData(); fd.append('profile_picture', file); progressContainer.style.display = 'block'; saveBtn.disabled = true; let xhr = new XMLHttpRequest(); xhr.upload.addEventListener('progress', e => { if (e.lengthComputable) { let pct = Math.round((e.loaded / e.total) * 100); progressFill.style.width = pct + '%'; progressText.textContent = pct + '%'; } }); xhr.addEventListener('load', () => { if (xhr.status === 200) { try { let resp = JSON.parse(xhr.responseText); if (resp.success) { document.querySelector('.profile-avatar').innerHTML = `<img src="${resp.imageUrl}?t=${Date.now()}" alt="{{ app.user.username }}" style="border-radius: 50%;">`; showToast('Profile picture updated!', 'success'); closeUploadModal(); } else { showToast(resp.message || 'Upload failed', 'error'); resetUpload(); } } catch(e) { showToast('Invalid response', 'error'); resetUpload(); } } else { showToast('Upload failed', 'error'); resetUpload(); } }); xhr.addEventListener('error', () => { showToast('Network error', 'error'); resetUpload(); }); xhr.open('POST', '/dashboard/upload-profile-picture', true); xhr.send(fd); }
        function resetUpload() { progressContainer.style.display = 'none'; progressFill.style.width = '0%'; progressText.textContent = '0%'; saveBtn.disabled = false; }
        window.closeUploadModal = () => { modal.classList.remove('show'); setTimeout(() => modal.remove(), 300); };
        cancelBtn.addEventListener('click', closeUploadModal); closeBtn.addEventListener('click', closeUploadModal);
        modal.addEventListener('click', e => { if (e.target === modal) closeUploadModal(); });
    }

    function initAll() {
        initMobileSidebar();
        initFlashMessages();
        initializeDropdown();
        loadNotifications();
        markAllNotificationsAsRead();
        checkOrderUpdates();
        setInterval(checkOrderUpdates, 30000); // ✅ 30s not 5s
        updateCartBadge();
        setInterval(updateCartBadge, 30000);   // ✅ 30s not 5s
        updateTrackerBadge();
    }

    document.addEventListener('DOMContentLoaded', () => setTimeout(initAll, 100));
    document.addEventListener('turbo:load', () => { sidebarInit = false; dropdownInit = false; setTimeout(initAll, 100); });
</script>
{% endblock %}