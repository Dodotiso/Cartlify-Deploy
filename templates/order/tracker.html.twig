        .toast-container { top: 80px; right: 10px; left: 10px; }
        .toast { min-width: auto; width: 100%; }
        .notification-dropdown { position: fixed; top: 70px; left: 10px; right: 10px; width: auto; max-width: none; border-radius: 12px; }
        .profile-dropdown { position: fixed; top: 70px; right: 10px; left: 10px; width: auto; max-width: none; }
    }

    @media (max-width: 576px) {
        body { padding-top: 60px; }
        .header { height: 60px; padding: 0 12px; }
        .header h1 { font-size: 14px; }
        .header-right { gap: 10px; }
