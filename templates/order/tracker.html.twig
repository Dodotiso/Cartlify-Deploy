<!-- ============================================ -->
<!-- MAIN CONTENT -->
<!-- ============================================ -->
<div class="main-content {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_STAFF') %}user-mode{% endif %}">
    <div class="tracker-container">
        <div class="tracker-header">
            <a href="{{ path('app_order_new') }}" class="continue-shopping-btn">
                <i class="fas fa-arrow-left"></i> Continue Shopping
            </a>
            <h2><i class="fas fa-chart-line"></i> My Orders Tracker</h2>
            <p>Track the real-time status of your orders from placement to delivery</p>
        </div>

        {% if orders|length > 0 %}
            {% for order in orders %}
                {% set currentStep = order.processStatus %}
                {% set orderStatus = order.orderStatus %}
                {% set isRejectedOrCancelled = orderStatus in ['rejected', 'cancelled'] %}
                {% set isCompleted = orderStatus == 'completed' %}
                
                <div class="order-track-card" id="order-card-{{ order.id }}">
                    <div class="order-track-header">
                        <span class="order-id">Order #{{ order.id }}</span>
                        <span class="order-date"><i class="far fa-calendar-alt"></i> {{ order.createdAt|date('F d, Y - h:i A') }}</span>
                    </div>
                    <div class="order-track-body">
                        <div class="product-header">
                            <div class="product-info">
                                <div class="product-image">
                                    {% if order.stock.product.image %}
                                        {% set imagePath = order.stock.product.image %}
                                        {% if not (imagePath starts with 'http' or imagePath starts with '/') %}
                                            {% set imagePath = '/uploads/' ~ imagePath %}
                                        {% endif %}
                                        <img src="{{ imagePath }}" alt="{{ order.stock.product.name }}" onerror="this.src='{{ asset('images/placeholder.png') }}'">
                                    {% else %}
                                        <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#f8fafc;">
                                            <i class="fas fa-image" style="font-size:32px;color:#94a3b8;"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="product-details">
                                    <div class="product-name">{{ order.stock.product.name }}</div>
                                    <div class="product-meta"><i class="fas fa-cubes"></i> Quantity: {{ order.quantity }}</div>
                                    <div class="product-meta"><i class="fas fa-tag"></i> Unit Price: ₱{{ order.unitPrice|number_format(2, '.', ',') }}</div>
                                    <div class="product-meta" style="font-size:16px;color:#10b981;font-weight:700;">Total: ₱{{ order.totalAmount|number_format(2, '.', ',') }}</div>
                                </div>
                            </div>
                            <div>
                                {% if orderStatus == 'pending' %}
                                    <span class="order-status-badge status-pending"><i class="fas fa-hourglass-half"></i> Awaiting Confirmation</span>
                                {% elseif orderStatus == 'accepted' %}
                                    <span class="order-status-badge status-accepted"><i class="fas fa-check-circle"></i> Order Accepted</span>
                                {% elseif orderStatus == 'completed' %}
                                    <span class="order-status-badge status-completed"><i class="fas fa-trophy"></i> Order Completed</span>
                                {% elseif orderStatus == 'rejected' %}
                                    <span class="order-status-badge status-rejected"><i class="fas fa-times-circle"></i> Order Rejected</span>
                                {% elseif orderStatus == 'cancelled' %}
                                    <span class="order-status-badge status-cancelled"><i class="fas fa-ban"></i> Order Cancelled</span>
                                {% else %}
                                    <span class="order-status-badge status-{{ order.processStatus }}">
                                        {% if order.processStatus == 'processing' %}<i class="fas fa-cogs"></i> Processing
                                        {% elseif order.processStatus == 'packaging' %}<i class="fas fa-box"></i> Packaging
                                        {% elseif order.processStatus == 'ready_for_pickup' %}<i class="fas fa-store"></i> Ready for Pickup
                                        {% elseif order.processStatus == 'shipped' %}<i class="fas fa-truck"></i> Shipped
                                        {% elseif order.processStatus == 'delivered' %}<i class="fas fa-check-circle"></i> Delivered
                                        {% else %}<i class="fas fa-clock"></i> Pending
                                        {% endif %}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="delivery-info">
                            <i class="fas {% if order.deliveryType == 'pickup' %}fa-store{% else %}fa-truck{% endif %}"></i> 
                            {% if order.deliveryType == 'pickup' %}
                                Pickup at Store
                            {% else %}
                                Shipping to: {{ order.deliveryAddress|length > 80 ? order.deliveryAddress|slice(0, 80) ~ '...' : order.deliveryAddress }}
                            {% endif %}
                        </div>
                        
                        <div class="progress-stepper">
                            <div class="progress-steps">
                                {% if isRejectedOrCancelled %}
                                    <div class="step cancelled">
                                        <div class="step-icon"><i class="fas fa-times-circle"></i></div>
                                        <div class="step-label">Order {% if orderStatus == 'rejected' %}Rejected{% else %}Cancelled{% endif %}</div>
                                    </div>
                                {% elseif isCompleted %}
                                    <div class="step completed"><div class="step-icon"><i class="fas fa-clock"></i></div><div class="step-label">Order Placed</div></div>
                                    <div class="step completed"><div class="step-icon"><i class="fas fa-cogs"></i></div><div class="step-label">Processing</div></div>
                                    <div class="step completed"><div class="step-icon"><i class="fas fa-box"></i></div><div class="step-label">Packaging</div></div>
                                    {% if order.deliveryType == 'pickup' %}
                                        <div class="step completed"><div class="step-icon"><i class="fas fa-store"></i></div><div class="step-label">Ready for Pickup</div></div>
                                        <div class="step completed"><div class="step-icon"><i class="fas fa-check-circle"></i></div><div class="step-label">Picked Up</div></div>
                                    {% else %}
                                        <div class="step completed"><div class="step-icon"><i class="fas fa-shipping-fast"></i></div><div class="step-label">Shipped</div></div>
                                        <div class="step completed"><div class="step-icon"><i class="fas fa-check-circle"></i></div><div class="step-label">Delivered</div></div>
                                    {% endif %}
                                {% else %}
                                    <div class="step completed"><div class="step-icon"><i class="fas fa-clock"></i></div><div class="step-label">Order Placed</div></div>
                                    <div class="step {% if currentStep in ['processing','packaging','ready_for_pickup','shipped','delivered'] %}completed{% elseif currentStep == 'processing' %}active{% endif %}">
                                        <div class="step-icon"><i class="fas fa-cogs"></i></div><div class="step-label">Processing</div>
                                    </div>
                                    <div class="step {% if currentStep in ['packaging','ready_for_pickup','shipped','delivered'] %}completed{% elseif currentStep == 'packaging' %}active{% endif %}">
                                        <div class="step-icon"><i class="fas fa-box"></i></div><div class="step-label">Packaging</div>
                                    </div>
                                    {% if order.deliveryType == 'pickup' %}
                                        <div class="step {% if currentStep in ['ready_for_pickup','delivered'] %}completed{% elseif currentStep == 'ready_for_pickup' %}active{% endif %}">
                                            <div class="step-icon"><i class="fas fa-store"></i></div><div class="step-label">Ready for Pickup</div>
                                        </div>
                                    {% else %}
                                        <div class="step {% if currentStep in ['shipped','delivered'] %}completed{% elseif currentStep == 'shipped' %}active{% endif %}">
                                            <div class="step-icon"><i class="fas fa-shipping-fast"></i></div><div class="step-label">Shipped</div>
                                        </div>
                                    {% endif %}
                                    <div class="step {% if currentStep == 'delivered' %}completed{% elseif currentStep == 'delivered' %}active{% endif %}">
                                        <div class="step-icon"><i class="fas fa-check-circle"></i></div>
                                        <div class="step-label">{% if order.deliveryType == 'pickup' %}Picked Up{% else %}Delivered{% endif %}</div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="action-buttons">
                            {% if orderStatus == 'completed' %}
                                <form method="post" action="{{ path('app_order_customer_delete', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Delete this completed order? This action cannot be undone.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt"></i> Delete Order</button>
                                </form>
                            {% elseif orderStatus == 'rejected' or orderStatus == 'cancelled' %}
                                <form method="post" action="{{ path('app_order_customer_delete', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Delete this {{ orderStatus }} order? This action cannot be undone.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt"></i> Delete Order</button>
                                </form>
                            {% elseif orderStatus == 'pending' %}
                                <form method="post" action="{{ path('app_order_customer_cancel', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Request to cancel this pending order? The admin will review your request.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.id) }}">
                                    <button type="submit" class="btn btn-warning"><i class="fas fa-ban"></i> Request Cancellation</button>
                                </form>
                            {% elseif orderStatus == 'accepted' %}
                                <form method="post" action="{{ path('app_order_customer_cancel', {'id': order.id}) }}" style="display: inline-block;" onsubmit="return confirm('Request to cancel this accepted order? The admin will review your request.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.id) }}">
                                    <button type="submit" class="btn btn-warning"><i class="fas fa-ban"></i> Request Cancellation</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="empty-tracker">
                <i class="fas fa-shopping-bag"></i>
                <h3>No Orders Yet</h3>
                <p>You haven't placed any orders yet. Start shopping to see your orders here!</p>
                <a href="{{ path('app_order_new') }}" class="btn-primary"><i class="fas fa-store"></i> Start Shopping</a>
            </div>
        {% endif %}
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
    let adminNotifications = [];
    let userNotifications = [];
    let shownFlashes = [];
    const isAdminOrStaff = {{ is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') ? 'true' : 'false' }};

    function loadAdminNotifications() { const saved = localStorage.getItem('admin_order_notifications'); adminNotifications = saved ? JSON.parse(saved) : []; updateAdminNotificationUI(); updateAdminNotificationBadge(); }
    function saveAdminNotifications() { localStorage.setItem('admin_order_notifications', JSON.stringify(adminNotifications)); updateAdminNotificationUI(); updateAdminNotificationBadge(); }
    
    function updateAdminNotificationBadge() {
        const unreadCount = adminNotifications.filter(n => !n.read).length;
        const badge = document.getElementById('adminNotificationBadge');
        if (badge) { if (unreadCount > 0) { badge.classList.add('show'); badge.textContent = unreadCount > 99 ? '99+' : unreadCount; } else { badge.classList.remove('show'); } }
    }
    
    function markAllAdminNotificationsAsRead() {
        if (adminNotifications.length > 0) { let hasUnread = adminNotifications.some(n => !n.read); if (hasUnread) { adminNotifications.forEach(n => n.read = true); saveAdminNotifications(); updateAdminNotificationBadge(); } }
    }
    
    function updateAdminNotificationUI() {
        const list = document.getElementById('adminNotificationList'); if (!list) return;
        if (adminNotifications.length === 0) { list.innerHTML = '<div style="padding:20px;text-align:center;color:#64748b;"><i class="fas fa-bell-slash"></i> No notifications</div>'; }
        else { const recentNotifications = adminNotifications.slice(0, 5); list.innerHTML = recentNotifications.map(n => `<div class="notification-item ${n.read ? '' : 'unread'}" onclick="markAdminNotificationAsRead(${n.id})"><div class="notification-title">${n.title}</div><div class="notification-message">${n.message}</div><div class="notification-time">${formatTimeAgo(n.timestamp)}</div></div>`).join(''); }
    }
    
    function markAdminNotificationAsRead(id) { const notification = adminNotifications.find(n => n.id === id); if (notification) { notification.read = true; saveAdminNotifications(); } }
    function clearAllAdminNotifications() { if (confirm('Clear all notifications?')) { adminNotifications = []; saveAdminNotifications(); showToast('All notifications cleared', 'info'); } }
    function toggleAdminNotificationDropdown(e) { if (e) e.stopPropagation(); const dropdown = document.getElementById('adminNotificationDropdown'); if (dropdown) { markAllAdminNotificationsAsRead(); dropdown.classList.toggle('show'); } }

    function loadUserNotifications() { const saved = localStorage.getItem('user_order_notifications'); userNotifications = saved ? JSON.parse(saved) : []; updateUserNotificationUI(); updateUserNotificationBadge(); }
    function saveUserNotifications() { localStorage.setItem('user_order_notifications', JSON.stringify(userNotifications)); updateUserNotificationUI(); updateUserNotificationBadge(); }
    
    function updateUserNotificationBadge() {
        const unreadCount = userNotifications.filter(n => !n.read).length;
        const badge = document.getElementById('userNotificationBadge');
        if (badge) { if (unreadCount > 0) { badge.classList.add('show'); badge.textContent = unreadCount > 99 ? '99+' : unreadCount; } else { badge.classList.remove('show'); } }
    }
    
    function markAllUserNotificationsAsRead() {
        if (userNotifications.length > 0) { let hasUnread = userNotifications.some(n => !n.read); if (hasUnread) { userNotifications.forEach(n => n.read = true); saveUserNotifications(); updateUserNotificationBadge(); } }
    }
    
    function updateUserNotificationUI() {
        const list = document.getElementById('userNotificationList'); if (!list) return;
        if (userNotifications.length === 0) { list.innerHTML = '<div style="padding:20px;text-align:center;color:#64748b;"><i class="fas fa-bell-slash"></i> No notifications</div>'; }
        else { const recentNotifications = userNotifications.slice(0, 5); list.innerHTML = recentNotifications.map(n => `<div class="notification-item ${n.read ? '' : 'unread'}" onclick="markUserNotificationAsRead(${n.id})"><div class="notification-title">${n.title}</div><div class="notification-message">${n.message}</div><div class="notification-time">${formatTimeAgo(n.timestamp)}</div></div>`).join(''); }
    }
    
    function markUserNotificationAsRead(id) { const notification = userNotifications.find(n => n.id === id); if (notification) { notification.read = true; saveUserNotifications(); } }
    function clearAllUserNotifications() { if (confirm('Clear all notifications?')) { userNotifications = []; saveUserNotifications(); showToast('All notifications cleared', 'info'); } }
    function toggleUserNotificationDropdown(e) { if (e) e.stopPropagation(); const dropdown = document.getElementById('userNotificationDropdown'); if (dropdown) { markAllUserNotificationsAsRead(); dropdown.classList.toggle('show'); } }

    function formatTimeAgo(timestamp) { const date = new Date(timestamp), now = new Date(), mins = Math.floor((now - date) / 60000), hours = Math.floor(mins / 60), days = Math.floor(hours / 24); if (mins < 1) return 'Just now'; if (mins < 60) return `${mins} min ago`; if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`; return `${days} day${days > 1 ? 's' : ''} ago`; }

    function toggleAdminProfileDropdown(event) { if (event) event.stopPropagation(); const dropdown = document.getElementById('adminProfileDropdown'); const header = document.getElementById('adminProfileHeader'); if (dropdown && header) { dropdown.classList.toggle('show'); header.classList.toggle('active'); } }
    function toggleUserProfileDropdown(event) { if (event) event.stopPropagation(); const dropdown = document.getElementById('userProfileDropdown'); const header = document.getElementById('userProfileHeader'); if (dropdown && header) { dropdown.classList.toggle('show'); header.classList.toggle('active'); } }

    function updateCartBadge() {
        fetch('/cart/count').then(res => res.json()).then(data => {
            if (isAdminOrStaff) {
                const badge = document.getElementById('adminCartBadge');
                if (badge) { if (data.count > 0) { badge.textContent = data.count > 9 ? '9+' : data.count; badge.classList.add('show'); } else { badge.classList.remove('show'); } }
            } else {
                const badge = document.getElementById('userCartBadge');
                if (badge) { if (data.count > 0) { badge.textContent = data.count > 9 ? '9+' : data.count; badge.classList.add('show'); } else { badge.classList.remove('show'); } }
            }
        }).catch(e => console.log('Cart update error:', e));
    }

    function updateTrackerBadge() {
        fetch('{{ path('app_new_orders_count') }}').then(res => res.json()).then(data => {
            if (isAdminOrStaff) {
                const badge = document.getElementById('adminTrackerBadge');
                if (badge) { if (data.count > 0) { badge.textContent = data.count > 9 ? '9+' : data.count; badge.classList.add('show'); } else { badge.classList.remove('show'); } }
            } else {
                const badge = document.getElementById('userTrackerBadge');
                if (badge) { if (data.count > 0) { badge.textContent = data.count > 9 ? '9+' : data.count; badge.classList.add('show'); } else { badge.classList.remove('show'); } }
            }
        }).catch(e => console.log('Tracker update error:', e));
    }

    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if (!container) { container = document.createElement('div'); container.id = 'toastContainer'; container.className = 'toast-container'; document.body.appendChild(container); }
        const toast = document.createElement('div'); toast.className = `toast toast-${type}`;
        let icon = type === 'success' ? '✓' : (type === 'error' ? '✗' : (type === 'warning' ? '⚠' : 'ℹ'));
        toast.innerHTML = `<div class="toast-icon">${icon}</div><div class="toast-content">${message}</div><div class="toast-progress"></div>`;
        container.appendChild(toast);
        setTimeout(() => { toast.style.animation = 'slideOutRight 0.3s ease'; setTimeout(() => toast.remove(), 300); }, 3000);
    }

    function checkOrderUpdates() {
        fetch('{{ path('app_order_check_updates') }}').then(res => res.json()).then(data => {
            if (data.updates && data.updates.length > 0) { updateTrackerBadge();
                data.updates.forEach(update => {
                    let title = '', message = '', type = 'info';
                    switch(update.newStatus) {
                        case 'processing': title = '📦 Order Processing'; message = `Order #${update.orderId} is now being processed.`; break;
                        case 'packaging': title = '📦 Packaging Your Order'; message = `Order #${update.orderId} is being packed.`; break;
                        case 'ready_for_pickup': title = '✅ Ready for Pickup!'; message = `Order #${update.orderId} is ready for pickup.`; type = 'success'; break;
                        case 'shipped': title = '🚚 Order Shipped!'; message = `Order #${update.orderId} has been shipped.`; type = 'success'; break;
                        case 'delivered': title = '🏠 Order Delivered'; message = `Order #${update.orderId} has been delivered.`; type = 'success'; break;
                        case 'completed': title = '✅ Order Completed'; message = `Order #${update.orderId} has been completed.`; type = 'success'; break;
                        case 'accepted': title = '✅ Order Accepted'; message = `Order #${update.orderId} has been accepted.`; type = 'success'; break;
                        case 'rejected': title = '❌ Order Rejected'; message = `Order #${update.orderId} has been rejected.`; type = 'warning'; break;
                        case 'cancelled': title = '❌ Order Cancelled'; message = `Order #${update.orderId} has been cancelled.`; type = 'warning'; break;
                        default: return;
                    }
                    if (isAdminOrStaff) {
                        let exists = adminNotifications.find(n => n.orderId === update.orderId && n.message.includes(update.newStatus));
                        if (!exists) { const notification = { id: Date.now(), title, message, orderId: update.orderId, type, timestamp: new Date().toISOString(), read: false }; adminNotifications.unshift(notification); if (adminNotifications.length > 100) adminNotifications = adminNotifications.slice(0, 100); saveAdminNotifications(); showToast(message, type); }
                    } else {
                        let exists = userNotifications.find(n => n.orderId === update.orderId && n.message.includes(update.newStatus));
                        if (!exists) { const notification = { id: Date.now(), title, message, orderId: update.orderId, type, timestamp: new Date().toISOString(), read: false }; userNotifications.unshift(notification); if (userNotifications.length > 100) userNotifications = userNotifications.slice(0, 100); saveUserNotifications(); showToast(message, type); }
                    }
                });
            }
        }).catch(e => console.error('Polling error:', e));
    }

    let sidebarInit = false;
    function initMobileSidebar() {
        if (sidebarInit) return;
        let toggle = document.getElementById('menuToggle'), sidebar = document.getElementById('sidebar'), overlay = document.getElementById('sidebarOverlay');
        if (!toggle || !sidebar) return;
        function open() { sidebar.classList.add('mobile-open'); if (overlay) overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
        function close() { sidebar.classList.remove('mobile-open'); if (overlay) overlay.classList.remove('active'); document.body.style.overflow = ''; }
        toggle.addEventListener('click', e => { e.stopPropagation(); sidebar.classList.contains('mobile-open') ? close() : open(); });
        if (overlay) overlay.addEventListener('click', close);
        document.addEventListener('click', e => { if (window.innerWidth <= 768 && sidebar.classList.contains('mobile-open') && !sidebar.contains(e.target) && !toggle.contains(e.target)) close(); });
        window.addEventListener('resize', () => { if (window.innerWidth > 768 && sidebar.classList.contains('mobile-open')) close(); });
        sidebarInit = true;
    }

    function initFlashMessages() {
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                let msg = '{{ message|escape('js') }}';
                if (!shownFlashes.includes(msg)) { shownFlashes.push(msg); showToast(msg, '{{ label }}'); }
            {% endfor %}
        {% endfor %}
    }

    function showUploadModal() {
        let existing = document.getElementById('uploadModal'); if (existing) existing.remove();
        let modal = document.createElement('div'); modal.id = 'uploadModal'; modal.className = 'modal';
        modal.innerHTML = `<div class="modal-content"><div class="modal-header"><h3>Change Profile Picture</h3><button class="close-modal">&times;</button></div><div class="modal-body"><div class="upload-area" id="uploadArea"><i class="fas fa-cloud-upload-alt"></i><p>Click to upload or drag and drop</p><small>PNG, JPG, GIF, WebP up to 2MB</small></div><div class="image-preview" id="imagePreview" style="display:none;"><img src="" alt="Preview"></div><div class="upload-progress" id="uploadProgress" style="display:none;"><div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div><span id="progressText">0%</span></div></div><div class="modal-footer"><button class="btn-secondary-modal" id="cancelUpload">Cancel</button><button class="btn-primary-modal" id="saveUpload" disabled>Upload</button></div></div>`;
        document.body.appendChild(modal); setTimeout(() => modal.classList.add('show'), 10);
        let uploadArea = document.getElementById('uploadArea'), preview = document.getElementById('imagePreview'), previewImg = preview.querySelector('img'), saveBtn = document.getElementById('saveUpload'), cancelBtn = document.getElementById('cancelUpload'), closeBtn = modal.querySelector('.close-modal'), progressContainer = document.getElementById('uploadProgress'), progressFill = document.getElementById('progressFill'), progressText = document.getElementById('progressText');
        let fileInput = document.createElement('input'); fileInput.type = 'file'; fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp'; fileInput.style.display = 'none'; modal.appendChild(fileInput);
        uploadArea.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', e => { let file = e.target.files[0]; if (file) { if (!['image/jpeg','image/png','image/gif','image/webp'].includes(file.type)) { showToast('Invalid image type', 'error'); return; } if (file.size > 2*1024*1024) { showToast('File too large (max 2MB)', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; }; reader.readAsDataURL(file); } });
        uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.style.borderColor = '#3b82f6'; });
        uploadArea.addEventListener('drop', e => { e.preventDefault(); let file = e.dataTransfer.files[0]; if (file && file.type.startsWith('image/')) { if (file.size > 2*1024*1024) { showToast('File too large', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; let dt = new DataTransfer(); dt.items.add(file); fileInput.files = dt.files; }; reader.readAsDataURL(file); } });
        saveBtn.addEventListener('click', () => { if (fileInput.files.length > 0) uploadProfilePicture(fileInput.files[0]); });
        function uploadProfilePicture(file) { let fd = new FormData(); fd.append('profile_picture', file); progressContainer.style.display = 'block'; saveBtn.disabled = true; let xhr = new XMLHttpRequest(); xhr.upload.addEventListener('progress', e => { if (e.lengthComputable) { let pct = Math.round((e.loaded / e.total) * 100); progressFill.style.width = pct + '%'; progressText.textContent = pct + '%'; } }); xhr.addEventListener('load', () => { if (xhr.status === 200) { try { let resp = JSON.parse(xhr.responseText); if (resp.success) { if (isAdminOrStaff) { document.querySelector('.admin-profile-avatar').innerHTML = `<img src="${resp.imageUrl}?t=${Date.now()}" alt="{{ app.user.username }}" style="border-radius: 50%;">`; } else { document.querySelector('.user-profile-avatar').innerHTML = `<img src="${resp.imageUrl}?t=${Date.now()}" alt="{{ app.user.username }}" style="border-radius: 50%;">`; } showToast('Profile picture updated!', 'success'); closeUploadModal(); } else { showToast(resp.message || 'Upload failed', 'error'); resetUpload(); } } catch(e) { showToast('Invalid response', 'error'); resetUpload(); } } else { showToast('Upload failed', 'error'); resetUpload(); } }); xhr.addEventListener('error', () => { showToast('Network error', 'error'); resetUpload(); }); xhr.open('POST', '/dashboard/upload-profile-picture', true); xhr.send(fd); }
        function resetUpload() { progressContainer.style.display = 'none'; progressFill.style.width = '0%'; progressText.textContent = '0%'; saveBtn.disabled = false; }
        window.closeUploadModal = () => { modal.classList.remove('show'); setTimeout(() => modal.remove(), 300); };
        cancelBtn.addEventListener('click', closeUploadModal); closeBtn.addEventListener('click', closeUploadModal);
        modal.addEventListener('click', e => { if (e.target === modal) closeUploadModal(); });
    }

    function closeAllDropdowns(event) {
        if (isAdminOrStaff) {
            const adminNotifIcon = document.getElementById('adminNotificationIcon');
            const adminProfileHeader = document.getElementById('adminProfileHeader');
            if (adminNotifIcon && adminNotifIcon.contains(event.target)) return;
            if (adminProfileHeader && adminProfileHeader.contains(event.target)) return;
            const adminProfileDropdown = document.getElementById('adminProfileDropdown');
            const adminProfileHeaderEl = document.getElementById('adminProfileHeader');
            if (adminProfileDropdown && adminProfileHeaderEl && !adminProfileHeaderEl.contains(event.target) && !adminProfileDropdown.contains(event.target)) { adminProfileDropdown.classList.remove('show'); adminProfileHeaderEl.classList.remove('active'); }
            const adminNotifDropdown = document.getElementById('adminNotificationDropdown');
            if (adminNotifDropdown && !adminNotifIcon?.contains(event.target) && !adminNotifDropdown.contains(event.target)) { adminNotifDropdown.classList.remove('show'); }
        } else {
            const userNotifIcon = document.getElementById('userNotificationIcon');
            const userProfileHeader = document.getElementById('userProfileHeader');
            if (userNotifIcon && userNotifIcon.contains(event.target)) return;
            if (userProfileHeader && userProfileHeader.contains(event.target)) return;
            const userProfileDropdown = document.getElementById('userProfileDropdown');
            const userProfileHeaderEl = document.getElementById('userProfileHeader');
            if (userProfileDropdown && userProfileHeaderEl && !userProfileHeaderEl.contains(event.target) && !userProfileDropdown.contains(event.target)) { userProfileDropdown.classList.remove('show'); userProfileHeaderEl.classList.remove('active'); }
            const userNotifDropdown = document.getElementById('userNotificationDropdown');
            if (userNotifDropdown && !userNotifIcon?.contains(event.target) && !userNotifDropdown.contains(event.target)) { userNotifDropdown.classList.remove('show'); }
        }
    }

    function initAll() {
        if (isAdminOrStaff) {
            initMobileSidebar(); loadAdminNotifications();
            const adminHeader = document.getElementById('adminProfileHeader');
            if (adminHeader) { adminHeader.removeEventListener('click', toggleAdminProfileDropdown); adminHeader.addEventListener('click', toggleAdminProfileDropdown); }
            const adminNotifIcon = document.getElementById('adminNotificationIcon');
            if (adminNotifIcon) { adminNotifIcon.removeEventListener('click', toggleAdminNotificationDropdown); adminNotifIcon.addEventListener('click', toggleAdminNotificationDropdown); }
            const adminClearBtn = document.querySelector('#adminNotificationDropdown .clear-notif-btn');
            if (adminClearBtn) { adminClearBtn.removeEventListener('click', clearAllAdminNotifications); adminClearBtn.addEventListener('click', clearAllAdminNotifications); }
            const adminChangeBtn = document.getElementById('adminChangeProfilePicBtn');
            if (adminChangeBtn) { adminChangeBtn.removeEventListener('click', showUploadModal); adminChangeBtn.addEventListener('click', (e) => { e.preventDefault(); showUploadModal(); }); }
        } else {
            loadUserNotifications();
            const userHeader = document.getElementById('userProfileHeader');
            if (userHeader) { userHeader.removeEventListener('click', toggleUserProfileDropdown); userHeader.addEventListener('click', toggleUserProfileDropdown); }
            const userNotifIcon = document.getElementById('userNotificationIcon');
            if (userNotifIcon) { userNotifIcon.removeEventListener('click', toggleUserNotificationDropdown); userNotifIcon.addEventListener('click', toggleUserNotificationDropdown); }
            const userClearBtn = document.querySelector('#userNotificationDropdown .clear-notif-btn');
            if (userClearBtn) { userClearBtn.removeEventListener('click', clearAllUserNotifications); userClearBtn.addEventListener('click', clearAllUserNotifications); }
            const userChangeBtn = document.getElementById('userChangeProfilePicBtn');
            if (userChangeBtn) { userChangeBtn.removeEventListener('click', showUploadModal); userChangeBtn.addEventListener('click', (e) => { e.preventDefault(); showUploadModal(); }); }
        }
        initFlashMessages();
        document.removeEventListener('click', closeAllDropdowns);
        document.addEventListener('click', closeAllDropdowns);
        checkOrderUpdates(); setInterval(checkOrderUpdates, 30000);
        updateCartBadge(); setInterval(updateCartBadge, 5000);
        updateTrackerBadge();
    }

    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', () => setTimeout(initAll, 100)); }
    else { setTimeout(initAll, 100); }
    document.addEventListener('turbo:load', () => { sidebarInit = false; setTimeout(initAll, 100); });
</script>
{% endblock %}