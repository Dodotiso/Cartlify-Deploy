                <img src="{{ imagePath }}" alt="{{ stock.product.name }}">
            {% else %}
                <div style="text-align: center; color: #6c757d; padding: 20px;">
                    <i class="fas fa-image" style="font-size: 48px; margin-bottom: 10px; display: block;"></i>
                    <span>No Image Available</span>
                </div>
            {% endif %}
        </div>

        <!-- INFO SECTION -->
        <div class="current-info">
            <p><i class="fas fa-box"></i> <strong>Product:</strong> {{ stock.product.name }} (ID: {{ stock.product.id }})</p>
            <p><i class="fas fa-calendar-alt"></i> <strong>Stock Created:</strong> {{ stock.createdAt ? stock.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</p>
            <p><i class="fas fa-chart-line"></i> <strong>Current Stock:</strong> 
                {% if stock.stock < 10 %}
                    <span style="color: #dc3545; font-weight: bold;"><i class="fas fa-exclamation-triangle"></i> {{ stock.stock }} (Low Stock)</span>
                {% elseif stock.stock < 20 %}
                    <span style="color: #ffc107; font-weight: bold;">{{ stock.stock }}</span>
                {% else %}
                    <span style="color: #28a745; font-weight: bold;"><i class="fas fa-check-circle"></i> {{ stock.stock }}</span>
                {% endif %}
            </p>
            <p><i class="fas fa-clock"></i> <strong>Last Updated:</strong> {{ "now"|date('Y-m-d H:i:s') }}</p>
