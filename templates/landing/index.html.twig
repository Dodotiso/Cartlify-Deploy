<script>
    // ========== MOBILE MENU CONTROLLER ==========
    const MenuController = {
        hamburger: document.getElementById('hamburger'),
        nav: document.getElementById('mainNav'),
        overlay: document.getElementById('overlay'),
        navbar: document.getElementById('navbar'),
        isOpen: false,

        init() {
            this.hamburger.addEventListener('click', () => this.toggle());
            this.overlay.addEventListener('click', () => this.close());
            this.nav.addEventListener('click', (e) => {
                if (e.target.closest('a')) this.close();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && this.isOpen) this.close();
            });
            window.addEventListener('scroll', () => {
                this.navbar.classList.toggle('scrolled', window.scrollY > 50);
            });
            window.addEventListener('resize', () => {
                if (window.innerWidth > 768 && this.isOpen) this.close();
            });
        },

        toggle() {
            this.isOpen ? this.close() : this.open();
        },

        open() {
            this.isOpen = true;
            this.nav.classList.add('navbar__nav--open');
            this.hamburger.classList.add('hamburger--active');
            this.overlay.classList.add('overlay--active');
            document.body.style.overflow = 'hidden';
        },

        close() {
            this.isOpen = false;
            this.nav.classList.remove('navbar__nav--open');
            this.hamburger.classList.remove('hamburger--active');
            this.overlay.classList.remove('overlay--active');
            document.body.style.overflow = '';
        }
    };

    // ========== DATA ==========
    const Data = {
        categories: [
            { icon: 'fa-mobile-alt', name: 'Electronics', desc: 'Latest gadgets & gear' },
            { icon: 'fa-tshirt', name: 'Fashion', desc: 'Trendy apparel' },
            { icon: 'fa-couch', name: 'Furniture', desc: 'Modern living' },
            { icon: 'fa-shoe-prints', name: 'Footwear', desc: 'Step in style' },
            { icon: 'fa-gem', name: 'Accessories', desc: 'Complete your look' }
        ],

        featuredProducts: [
            { name: "Horizon Smartwatch", price: 4990, oldPrice: 8990, rating: 4.5, image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400&auto=format" },
            { name: "Auric Wireless Headphones", price: 3290, oldPrice: 5990, rating: 4.8, image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400&auto=format" },
            { name: "Urban Runners", price: 2499, oldPrice: 4299, rating: 4.3, image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400&auto=format" },
            { name: "Eclipse Sofa", price: 19990, oldPrice: 32990, rating: 4.7, image: "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=400&auto=format" }
        ],

        saleProducts: [
            { name: "Gaming Laptop Pro", price: 44999, oldPrice: 79999, rating: 4.9, image: "https://images.unsplash.com/photo-1593642632823-8f785ba67e45?w=400&auto=format", badge: "-44%" },
            { name: "Premium Cookware Set", price: 3999, oldPrice: 7499, rating: 4.6, image: "https://images.unsplash.com/photo-1584345604476-8ec5e12e42dd?w=400&auto=format", badge: "-47%" },
            { name: "4K Action Camera", price: 8999, oldPrice: 14999, rating: 4.7, image: "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=400&auto=format", badge: "-40%" },
            { name: "Leather Backpack", price: 2499, oldPrice: 4999, rating: 4.5, image: "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=400&auto=format", badge: "-50%" },
            { name: "Noise Cancelling Earbuds", price: 1999, oldPrice: 3999, rating: 4.8, image: "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=400&auto=format", badge: "-50%" },
            { name: "Smart Home Speaker", price: 3499, oldPrice: 5999, rating: 4.6, image: "https://images.unsplash.com/photo-1589492477829-5e65395b66cc?w=400&auto=format", badge: "-42%" },
            { name: "Wireless Mechanical Keyboard", price: 2899, oldPrice: 4999, rating: 4.7, image: "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=400&auto=format", badge: "-42%" },
            { name: "Ergonomic Office Chair", price: 7999, oldPrice: 12999, rating: 4.8, image: "https://images.unsplash.com/photo-1580480055273-228ff5388ef8?w=400&auto=format", badge: "-38%" }
        ],

        testimonials: [
            { name: "Maria Santos", text: "Amazing quality products and lightning fast delivery! Will definitely shop again.", rating: 5, avatar: "https://randomuser.me/api/portraits/women/1.jpg" },
            { name: "James Reyes", text: "Best online shopping experience in the Philippines. Highly recommended!", rating: 5, avatar: "https://randomuser.me/api/portraits/men/2.jpg" },
            { name: "Sophia Gomez", text: "Customer service is outstanding. They resolved my issue within hours!", rating: 5, avatar: "https://randomuser.me/api/portraits/women/3.jpg" }
        ]
    };

    // ========== RENDERER ==========
    class Renderer {
        static loginUrl = '{{ path('app_login') }}';

        static categories() {
            const grid = document.getElementById('categoryGrid');
            if (!grid) return;
            grid.innerHTML = Data.categories.map(c => `
                <div class="category-card" onclick="Renderer.redirectToLogin()">
                    <div class="category-card__icon"><i class="fas ${c.icon}"></i></div>
                    <h3>${c.name}</h3>
                    <p>${c.desc}</p>
                </div>
            `).join('');
        }

        static products(productsArray, containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            container.innerHTML = productsArray.map(p => `
                <div class="product-card" onclick="Renderer.redirectToLogin()">
                    ${p.badge ? `<div class="product-card__badge">${p.badge}</div>` : ''}
                    <div class="product-card__image">
                        <img src="${p.image}" alt="${p.name}" loading="lazy">
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__title">${p.name}</div>
                        <div class="product-card__rating">
                            ${'★'.repeat(Math.floor(p.rating))}${p.rating % 1 ? '½' : ''} (${p.rating})
                        </div>
                        <div class="product-card__price">
                            ₱${p.price.toLocaleString()}
                            ${p.oldPrice ? `<span class="product-card__price--old">₱${p.oldPrice.toLocaleString()}</span>` : ''}
                        </div>
                        <button class="product-card__btn">Shop Now →</button>
                    </div>
                </div>
            `).join('');
        }

        static testimonials() {
            const grid = document.getElementById('testimonialsGrid');
            if (!grid) return;
            grid.innerHTML = Data.testimonials.map(t => `
                <div class="testimonial-card">
                    <img src="${t.avatar}" class="testimonial-card__avatar" alt="${t.name}">
                    <div class="testimonial-card__stars">${'★'.repeat(t.rating)}</div>
                    <p class="testimonial-card__text">"${t.text}"</p>
                    <p class="testimonial-card__name">— ${t.name}</p>
                </div>
            `).join('');
        }

        static redirectToLogin() {
            window.location.href = Renderer.loginUrl;
        }
    }

    // ========== COUNTDOWN ==========
    class Countdown {
        constructor() {
            this.deadline = new Date();
            this.deadline.setHours(this.deadline.getHours() + 48);
        }

        start() {
            this.update();
            setInterval(() => this.update(), 1000);
        }

        update() {
            const distance = this.deadline - new Date().getTime();
            const elements = {
                days: document.getElementById('days'),
                hours: document.getElementById('hours'),
                minutes: document.getElementById('minutes'),
                seconds: document.getElementById('seconds')
            };

            if (distance < 0) {
                Object.values(elements).forEach(el => { if (el) el.textContent = '00'; });
                return;
            }

            elements.days.textContent = Math.floor(distance / 86400000).toString().padStart(2, '0');
            elements.hours.textContent = Math.floor((distance % 86400000) / 3600000).toString().padStart(2, '0');
            elements.minutes.textContent = Math.floor((distance % 3600000) / 60000).toString().padStart(2, '0');
            elements.seconds.textContent = Math.floor((distance % 60000) / 1000).toString().padStart(2, '0');
        }
    }

    // ========== UTILS ==========
    function scrollToProducts() {
        document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
    }

    // ========== INITIALIZATION ==========
    document.addEventListener('DOMContentLoaded', () => {
        MenuController.init();
        Renderer.categories();
        Renderer.products(Data.featuredProducts, 'featuredGrid');
        Renderer.products(Data.saleProducts, 'saleGrid');
        Renderer.testimonials();
        new Countdown().start();
    });
</script>
{% endblock %}