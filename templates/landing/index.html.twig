{% extends 'base.html.twig' %}

{% block title %}Cartlify — Home{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block body %}
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
}

:root {
  --slide-seconds: 5s;    
  --slide-count: 5;         
  --total-duration: calc(var(--slide-seconds) * var(--slide-count));
  --primary-color: #b23b2a;
  --secondary-color: #f4c542;
  --text-dark: #333;
  --text-light: #555;
  --bg-light: #fdfdfd;
  --bg-accent: #fff5f4;
  --shadow-sm: 0 2px 6px rgba(0,0,0,0.1);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.1);
  --shadow-lg: 0 6px 16px rgba(0,0,0,0.2);
}

body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Navbar */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 5%;
  background: #fff;
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 1000;
  flex-wrap: wrap;
  gap: 15px;
}

.logo {
  flex-shrink: 0;
}

.logo-img {
  width: 140px;
  height: auto;
  max-width: 100%;
}

.menu {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 20px;
  justify-content: center;
  flex: 1;
}

.menu a {
  text-decoration: none;
  color: var(--text-dark);
  font-weight: 500;
  font-size: 0.95rem;
  white-space: nowrap;
  transition: color 0.3s;
}

.menu a:hover {
  color: var(--primary-color);
}

.nav-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-shrink: 0;
}

.nav-actions input {
  padding: 8px 12px;
  border: 1px solid #ccc;
  border-radius: 5px;
  font-size: 0.9rem;
  min-width: 0;
  flex: 1;
}

.nav-actions button {
  padding: 8px 16px;
  background: var(--primary-color);
  color: #fff;
  border: none;
  border-radius: 5px;
  font-size: 0.9rem;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.3s;
}

.nav-actions button:hover {
  background: #9a3223;
}

/* Hero Section */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 5%;
  background: var(--bg-light);
  gap: 40px;
}

@media (min-width: 992px) {
  .hero {
    flex-direction: row;
    justify-content: space-between;
    padding: 60px 5%;
  }
}

.hero-text {
  text-align: center;
  max-width: 100%;
}

@media (min-width: 992px) {
  .hero-text {
    text-align: left;
    max-width: 50%;
  }
}

.hero-text h1 {
  font-size: 2rem;
  margin-bottom: 20px;
  line-height: 1.3;
}

@media (min-width: 768px) {
  .hero-text h1 {
    font-size: 2.5rem;
  }
}

@media (min-width: 1200px) {
  .hero-text h1 {
    font-size: 3rem;
  }
}

.hero-text h1 span {
  color: var(--primary-color);
}

.hero-text p {
  margin-bottom: 20px;
  font-size: 1rem;
  color: var(--text-light);
  line-height: 1.6;
}

@media (min-width: 768px) {
  .hero-text p {
    font-size: 1.1rem;
  }
}

.cta-btn {
  padding: 12px 24px;
  background: var(--primary-color);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.3s, transform 0.2s;
}

.cta-btn:hover {
  background: #9a3223;
  transform: translateY(-2px);
}

.hero-image {
  width: 100%;
  max-width: 500px;
  height: 300px;
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: var(--shadow-md);
}

@media (min-width: 768px) {
  .hero-image {
    height: 350px;
  }
}

@media (min-width: 992px) {
  .hero-image {
    width: 45%;
    max-width: 400px;
    height: 300px;
  }
}

@media (min-width: 1200px) {
  .hero-image {
    width: 400px;
    height: 300px;
  }
}

.hero-slides img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transform: scale(1);
  animation: heroFade var(--total-duration) linear infinite;
}

.hero-slides img:nth-child(1) { animation-delay: calc(var(--slide-seconds) * 0); }
.hero-slides img:nth-child(2) { animation-delay: calc(var(--slide-seconds) * 1); }
.hero-slides img:nth-child(3) { animation-delay: calc(var(--slide-seconds) * 2); }
.hero-slides img:nth-child(4) { animation-delay: calc(var(--slide-seconds) * 3); }
.hero-slides img:nth-child(5) { animation-delay: calc(var(--slide-seconds) * 4); }

@keyframes heroFade {
  0%   { opacity: 0; transform: scale(1); }
  8%   { opacity: 1; transform: scale(1.03); }
  28%  { opacity: 1; transform: scale(1.03); }
  36%  { opacity: 0; transform: scale(1); }
  100% { opacity: 0; transform: scale(1); }
}

/* Features */
.features {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 40px 5%;
  background: var(--bg-accent);
}

@media (min-width: 768px) {
  .features {
    flex-direction: row;
    justify-content: space-around;
    flex-wrap: wrap;
  }
}

.feature-card {
  background: #fff;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.05);
  text-align: center;
  flex: 1;
  min-width: 250px;
  max-width: 100%;
}

@media (min-width: 768px) {
  .feature-card {
    width: 30%;
    min-width: 0;
  }
}

.feature-card h3 {
  margin-bottom: 10px;
  color: var(--primary-color);
  font-size: 1.2rem;
}

/* Categories */
.categories {
  padding: 40px 5%;
  text-align: center;
}

@media (min-width: 768px) {
  .categories {
    padding: 60px 5%;
  }
}

.categories h2 {
  margin-bottom: 30px;
  font-size: 1.8rem;
}

@media (min-width: 768px) {
  .categories h2 {
    font-size: 2.5rem;
  }
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}

@media (min-width: 768px) {
  .category-grid {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
}

.category-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 8px rgba(0,0,0,0.05);
  transition: transform 0.3s, box-shadow 0.3s;
  text-decoration: none;
  color: inherit;
  display: block;
}

.category-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
  border: 2px solid var(--secondary-color);
}

.category-card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
}

.category-card h4 {
  padding: 15px;
  font-size: 1.1rem;
  color: var(--text-dark);
  transition: color 0.3s;
}

.category-card:hover h4 {
  color: var(--primary-color);
}

/* Footer */
.footer {
  padding: 20px;
  text-align: center;
  background: #f3f3f3;
  color: #666;
  margin-top: auto;
}

/* Mobile Menu Toggle (for extra small screens) */
.menu-toggle {
  display: none;
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--primary-color);
}

/* Responsive Breakpoints */
@media (max-width: 767px) {
  .navbar {
    padding: 15px 20px;
  }
  
  .menu-toggle {
    display: block;
  }
  
  .menu {
    display: none;
    width: 100%;
    order: 3;
    flex-direction: column;
    padding-top: 15px;
    border-top: 1px solid #eee;
  }
  
  .menu.active {
    display: flex;
  }
  
  .menu a {
    padding: 10px 0;
    width: 100%;
    text-align: center;
  }
  
  .nav-actions {
    width: 100%;
    order: 2;
    justify-content: center;
  }
  
  .nav-actions input {
    flex: 2;
  }
  
  .hero-text h1 {
    font-size: 1.8rem;
  }
  
  .category-grid {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  
  .category-card img {
    height: 140px;
  }
  
  .hero-image {
    height: 250px;
  }
}

@media (max-width: 480px) {
  .hero-text h1 {
    font-size: 1.6rem;
  }
  
  .hero-text p {
    font-size: 0.95rem;
  }
  
  .category-grid {
    grid-template-columns: 1fr;
  }
  
  .feature-card {
    min-width: 100%;
  }
  
  .nav-actions {
    flex-direction: column;
    gap: 8px;
  }
  
  .nav-actions input,
  .nav-actions button {
    width: 100%;
  }
}
</style>

