      <div class="category-badge">Hot!</div>
    </div>
    <div class="category-card" onclick="window.location.href='{{ path('app_login') }}'">
      <div class="category-icon"><i class="fas fa-couch"></i></div>
      <h3>Furniture</h3>
      <p>Modern & Classic Designs</p>
    </div>
    <div class="category-card" onclick="window.location.href='{{ path('app_login') }}'">
      <div class="category-icon"><i class="fas fa-utensils"></i></div>
      <h3>Utensils</h3>
      <p>Kitchen Essentials</p>
    </div>
    <div class="category-card" onclick="window.location.href='{{ path('app_login') }}'">
