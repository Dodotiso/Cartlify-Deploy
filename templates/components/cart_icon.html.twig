{% set cartCount = app.session.get('cart_count', 0) %}
<a href="{{ path('app_cart_view') }}" class="cart-icon-link" style="position: relative; margin-right: 20px; text-decoration: none;">
    <i class="fas fa-shopping-cart" style="font-size: 22px; color: #333;"></i>
    {% if cartCount > 0 %}
        <span class="cart-badge" style="position: absolute; top: -8px; right: -12px; background: #dc3545; color: white; border-radius: 50%; padding: 2px 6px; font-size: 11px; font-weight: bold; min-width: 18px; text-align: center;">
            {{ cartCount }}
        </span>
    {% endif %}
</a>

<style>
.cart-icon-link:hover i {
    color: #007bff;
}
</style>