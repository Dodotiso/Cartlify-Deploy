// ============================================
// PROFILE PICTURE UPLOAD MODAL
// ============================================
function showUploadModal() {
    // Remove existing modal if present
    const existing = document.getElementById('uploadModal');
    if (existing) existing.remove();

    // Create modal element
    const modal = document.createElement('div');
    modal.id = 'uploadModal';
    modal.className = 'modal';

    modal.innerHTML = '<div class="modal-content">' +
        '<div class="modal-header">' +
            '<h3>Change Profile Picture</h3>' +
            '<button class="close-modal">&times;</button>' +
        '</div>' +
        '<div class="modal-body">' +
            '<div class="upload-area" id="uploadArea">' +
                '<i class="fas fa-cloud-upload-alt"></i>' +
                '<p>Click to upload or drag and drop</p>' +
                '<small>PNG, JPG, GIF, WebP up to 2MB</small>' +
            '</div>' +
            '<div class="image-preview" id="imagePreview" style="display:none;">' +
                '<img src="" alt="Preview">' +
            '</div>' +
            '<div class="upload-progress" id="uploadProgress" style="display:none;">' +
                '<div class="progress-bar">' +
                    '<div class="progress-fill" id="progressFill"></div>' +
                '</div>' +
                '<span id="progressText">0%</span>' +
            '</div>' +
        '</div>' +
        '<div class="modal-footer">' +
            '<button class="btn-secondary-modal" id="cancelUpload">Cancel</button>' +
            '<button class="btn-primary-modal" id="saveUpload" disabled>Upload</button>' +
        '</div>' +
    '</div>';

    document.body.appendChild(modal);
    setTimeout(function() { modal.classList.add('show'); }, 10);

    // Get DOM references
    const uploadArea = document.getElementById('uploadArea');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = imagePreview.querySelector('img');
    const saveBtn = document.getElementById('saveUpload');
    const cancelBtn = document.getElementById('cancelUpload');
    const closeBtn = modal.querySelector('.close-modal');
    const progressContainer = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');

    // Create file input
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp';
    fileInput.style.display = 'none';
    modal.appendChild(fileInput);

    // Event: Click to upload
    uploadArea.addEventListener('click', function() { fileInput.click(); });

    // Event: File selected
    fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;

        if (!['image/jpeg', 'image/png', 'image/gif', 'image/webp'].includes(file.type)) {
            showToast('Invalid image type', 'error');
            return;
        }

        if (file.size > 2 * 1024 * 1024) {
            showToast('File too large (max 2MB)', 'error');
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            previewImg.src = e.target.result;
            imagePreview.style.display = 'block';
            uploadArea.style.display = 'none';
            saveBtn.disabled = false;
        };
        reader.readAsDataURL(file);
    });

    // Event: Drag and drop
    uploadArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        uploadArea.style.borderColor = '#3b82f6';
    });

    uploadArea.addEventListener('drop', function(e) {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (!file || !file.type.startsWith('image/')) return;

        if (file.size > 2 * 1024 * 1024) {
            showToast('File too large', 'error');
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            previewImg.src = e.target.result;
            imagePreview.style.display = 'block';
            uploadArea.style.display = 'none';
            saveBtn.disabled = false;

            const dt = new DataTransfer();
            dt.items.add(file);
            fileInput.files = dt.files;
        };
        reader.readAsDataURL(file);
    });

    // Event: Save upload
    saveBtn.addEventListener('click', function() {
        if (fileInput.files.length > 0) {
            uploadProfilePicture(fileInput.files[0]);
        }
    });

    // Upload function
    function uploadProfilePicture(file) {
        const formData = new FormData();
        formData.append('profile_picture', file);

        progressContainer.style.display = 'block';
        saveBtn.disabled = true;

        const xhr = new XMLHttpRequest();

        xhr.upload.addEventListener('progress', function(e) {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressFill.style.width = percent + '%';
                progressText.textContent = percent + '%';
            }
        });

        xhr.addEventListener('load', function() {
            if (xhr.status === 200) {
                try {
                    const response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        updateProfilePicture(response.imageUrl);
                        showToast('Profile picture updated!', 'success');
                        closeUploadModal();
                    } else {
                        showToast(response.message || 'Upload failed', 'error');
                        resetUpload();
                    }
                } catch (e) {
                    showToast('Invalid response', 'error');
                    resetUpload();
                }
            } else {
                showToast('Upload failed', 'error');
                resetUpload();
            }
        });

        xhr.addEventListener('error', function() {
            showToast('Network error', 'error');
            resetUpload();
        });

        xhr.open('POST', '/dashboard/upload-profile-picture', true);
        xhr.send(formData);
    }

    function resetUpload() {
        progressContainer.style.display = 'none';
        progressFill.style.width = '0%';
        progressText.textContent = '0%';
        saveBtn.disabled = false;
    }

    function updateProfilePicture(imageUrl) {
        const avatar = document.querySelector('.profile-avatar');
        avatar.innerHTML = '<img src="' + imageUrl + '?t=' + Date.now() + '" alt="{{ app.user.username }}" style="border-radius: 50%;">';
    }

    function closeUploadModal() {
        modal.classList.remove('show');
        setTimeout(function() { modal.remove(); }, 300);
    }

    // Close events
    cancelBtn.addEventListener('click', closeUploadModal);
    closeBtn.addEventListener('click', closeUploadModal);
    modal.addEventListener('click', function(e) {
        if (e.target === modal) closeUploadModal();
    });
}

// ============================================
// ACTIVE STATUS
// ============================================
function updateMyLastActive() {
    fetch('/last-active/update', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/json'
        }
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (!data.success) return;
        const currentUsername = '{{ app.user.username }}';
        const userRows = document.querySelectorAll('.users-table tbody tr');

        userRows.forEach(function(row) {
            const usernameCell = row.querySelector('td:nth-child(2) strong');
            if (usernameCell && usernameCell.textContent === currentUsername) {
                const badge = row.querySelector('.active-badge-table');
                if (badge) {
                    badge.innerHTML = '<i class="fas fa-circle"></i> Active Now';
                    badge.className = 'active-badge-table online';
                }
            }
        });
    })
    .catch(console.error);
}

// ============================================
// CHECK ORDER UPDATES
// ============================================
function checkOrderUpdates() {
    fetch('{{ path('app_order_check_updates') }}')
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (!data.updates || data.updates.length === 0) return;

            updateTrackerBadge();

            data.updates.forEach(function(update) {
                const exists = notifications.find(function(n) {
                    return n.orderId === update.orderId && n.message.includes(update.newStatus);
                });

                if (exists) return;

                let title = '';
                let message = '';
                let type = 'info';

                    switch(update.newStatus) {
                        case 'processing': title = '📦 Order Processing'; message = `Order #${update.orderId} is now being processed.`; break;
                        case 'packaging': title = '📦 Packaging Your Order'; message = `Order #${update.orderId} is being packed.`; break;
                        case 'ready_for_pickup': title = '✅ Ready for Pickup!'; message = `Order #${update.orderId} is ready for pickup.`; type = 'success'; break;
                        case 'shipped': title = '🚚 Order Shipped!'; message = `Order #${update.orderId} has been shipped.`; type = 'success'; break;
                        case 'delivered': title = '🏠 Order Delivered'; message = `Order #${update.orderId} has been delivered.`; type = 'success'; break;
                        case 'completed': title = '✅ Order Completed'; message = `Order #${update.orderId} has been completed.`; type = 'success'; break;
                        case 'accepted': title = '✅ Order Accepted'; message = `Order #${update.orderId} has been accepted.`; type = 'success'; break;
                        case 'rejected': title = '❌ Order Rejected'; message = `Order #${update.orderId} has been rejected.`; type = 'warning'; break;
                        case 'cancelled': title = '❌ Order Cancelled'; message = `Order #${update.orderId} has been cancelled.`; type = 'warning'; break;
                        default: return;
                    }

                addNotification(title, message, update.orderId, type);
            });
        })
        .catch(function(e) { console.error('Polling error:', e); });
}

// ============================================
// INITIALIZATION
// ============================================
function initAll() {
    initMobileSidebar();
    displayFlashMessages();
    initializeDropdown();
    loadNotifications();
    updateCartBadge();
    updateTrackerBadge();

    setInterval(updateCartBadge, 5000);
    setInterval(updateTrackerBadge, 10000);
    setInterval(checkOrderUpdates, 30000);

    setTimeout(updateMyLastActive, 1000);
    setInterval(updateMyLastActive, 30000);
}

document.addEventListener('DOMContentLoaded', function() {
    setTimeout(initAll, 100);
});

document.addEventListener('turbo:load', function() {
    sidebarInitialized = false;
    dropdownInitialized = false;
    setTimeout(initAll, 100);
});
</script>
