{% extends 'base.html.twig' %}
{% block title %}Cartlify | Edit User{% endblock %}

{% block body %}
<style>
body { margin:0;font-family:Arial,sans-serif;background:#f4f6f9;color:#343a40 }
.sidebar{position:fixed;top:0;left:0;height:100%;width:60px;background:#1f2a44;padding-top:30px;display:flex;flex-direction:column;overflow:hidden;transition:.3s}
.sidebar:hover{width:220px}
.sidebar .logo{display:flex;justify-content:center;margin-bottom:40px}
.sidebar .logo img{height:48px;transition:.3s}
.sidebar:hover .logo img{height:128px}
.sidebar a{display:flex;align-items:center;padding:15px 10px;text-decoration:none;color:#fff;font-weight:500;border-left:4px solid transparent;transition:.3s}
.sidebar a span{display:none}
.sidebar:hover a span{display:inline;margin-left:25px}
.sidebar a:hover{background:#34495e;border-left:4px solid #E64C3C}
.header{margin-left:60px;height:80px;background:#fff;display:flex;align-items:center;padding:0 30px;box-shadow:0 2px 6px rgba(0,0,0,.1);transition:.3s}
.sidebar:hover~.header{margin-left:220px}
.main{margin-left:60px;padding:30px;transition:.3s}
.sidebar:hover~.main{margin-left:220px}
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 25px;
    background: #ffffff;
    border-bottom: 1px solid #ddd;
}

.profile-wrapper {
    position: relative;
}

.profile-header {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    position: relative;
}

.profile-avatar {
    width: 38px;
    height: 38px;
    background: #007bff;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 18px;
}

.profile-name {
    font-weight: 500;
    user-select: none;
}

.profile-dropdown {
    position: absolute;
    top: 50px;
    right: 0;
    width: 150px;
    background: white;
    border: 1px solid #ccc;
    border-radius: 6px;
    display: none;
    flex-direction: column;
    box-shadow: 0 3px 8px rgba(0,0,0,0.1);
    z-index: 999;
}

.profile-dropdown a {
    padding: 10px 12px;
    text-decoration: none;
    color: #333;
    display: block;
}

.profile-dropdown a:hover {
    background: #f5f5f5;
}

.profile-header:hover .profile-dropdown {
    display: flex;
}


.products-container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px
}
.product-card{
    background:#fff;
    border-radius:8px;
    box-shadow:0 2px 8px rgba(0,0,0,.1);
    overflow:hidden;
    display:flex;
    flex-direction:column
}
.card-body{
    padding:15px;
    display:flex;
    flex-direction:column;
    flex-grow:1
}
.card-body h3{margin:0 0 10px;font-size:18px}
.card-body p{margin:0 0 10px;font-size:14px;color:#555}
.card-body input, .card-body select{padding:6px;margin-bottom:10px;border-radius:4px;border:1px solid #ccc;width:100%}
.btn-submit{
    background:#28a745;
    color:#fff;
    border:none;
    border-radius:4px;
    padding:8px;
    font-size:14px;
    cursor:pointer
}
</style>

{% if is_granted('ROLE_ADMIN') %}
<div class="sidebar">
    <div class="logo"><img src="{{ asset('images/Cart-2.png') }}"></div>
    <a href="{{ path('app_dashboard') }}">
        <i class="fas fa-home" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Dashboard</span>
    </a>
    
    <!-- Products -->
    <a href="{{ path('app_product_index') }}">
        <i class="fas fa-shopping-bag" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Products</span>
    </a>
    
    <!-- Stocks -->
    <a href="{{ path('app_stock_index') }}">
        <i class="fas fa-boxes" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Stocks</span>
    </a>
    
    <!-- Marketplace -->
    <a href="{{ path('app_order_new') }}">
        <i class="fas fa-shopping-cart" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Marketplace</span>
    </a>
    
    <!-- Transactions -->
    <a href="{{ path('app_order_index') }}">
        <i class="fas fa-receipt" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Transactions</span>
    </a>
    
    <!-- Staff Management -->
    <a href="{{ path('app_user_index') }}">
        <i class="fas fa-user-tie" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Staff Management</span>
    </a>
    
    <!-- Activity Logs -->
    <a href="{{ path('app_activity_log_index') }}">
        <i class="fas fa-clipboard-list" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Activity Logs</span>
    </a>
    <a href="{{ path('app_profile_index') }}">
        <i class="fas fa-user"></i>
        <span>Profile</span>
    </a>
    <!-- Logout -->
    <a href="{{ path('app_logout') }}">
        <i class="fas fa-power-off" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Logout</span>
    </a>
</div>

{% set role = app.user.roles[0] ?? 'ROLE_USER' %}

{% set avatarLetter = 
    role == 'ROLE_ADMIN' ? 'A' :
    (role == 'ROLE_STAFF' ? 'S' :
    (role == 'ROLE_USER' ? 'U' :
    app.user.username|first|upper))
%}

<div class="header">
     <h1>Edit User</h1>

    <div class="profile-wrapper">
        <div class="profile-header">
            <div class="profile-avatar">{{ avatarLetter }}</div>
            <span class="profile-name">{{ app.user.username }}</span>
        </div>
    </div>
</div>

<div class="main">
    <div class="products-container">
        <div class="product-card">
            <div class="card-body">
                {{ form_start(form) }}
                    <h3>Username</h3>
                    {{ form_widget(form.username) }}
                    <h3>Role</h3>
                    {{ form_widget(form.roles) }}
                    <h3>Password (leave blank to keep current)</h3>
                    {{ form_widget(form.password) }}
                    <button type="submit" class="btn-submit">Update</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
