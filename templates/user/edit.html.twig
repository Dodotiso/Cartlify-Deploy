    .button-group {
        flex-direction: column;
        gap: 10px;
    }
    
    .btn-submit, .btn-back {
        padding: 10px 16px;
        font-size: 14px;
    }
    
    .profile-avatar-large {
        width: 100px;
        height: 100px;
        font-size: 40px;
    }
    
    .toast {
        min-width: 250px;
        padding: 12px 16px;
    }
    
    .toast-container {
        top: 80px;
        right: 15px;
    }
    .notification-dropdown {
        width: 300px;
        right: -60px;
    }
    .profile-dropdown {
        position: fixed;
        top: 60px;
        right: 10px;
        width: calc(100% - 20px);
        max-width: 280px;
    }
}

@media (max-width: 480px) {
    body {
        padding-top: 60px;
    }
    
    .header {
        height: 60px;
        padding: 0 12px;
    }
    
    .header h1 {
        font-size: 14px;
    }
    
    .main-content {
        padding: 10px;
