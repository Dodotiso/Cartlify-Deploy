{% extends 'base.html.twig' %}

{% block title %}Cartlify | Product Details{% endblock %}

{% block body %}
<style>
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 25px;
    background: #ffffff;
    border-bottom: 1px solid #ddd;
}

.profile-wrapper {
    position: relative;
}

.profile-header {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    position: relative;
}

.profile-avatar {
    width: 38px;
    height: 38px;
    background: #007bff;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 18px;
}

.profile-name {
    font-weight: 500;
    user-select: none;
}

.profile-dropdown {
    position: absolute;
    top: 50px;
    right: 0;
    width: 150px;
    background: white;
    border: 1px solid #ccc;
    border-radius: 6px;
    display: none;
    flex-direction: column;
    box-shadow: 0 3px 8px rgba(0,0,0,0.1);
    z-index: 999;
}

.profile-dropdown a {
    padding: 10px 12px;
    text-decoration: none;
    color: #333;
    display: block;
}

.profile-dropdown a:hover {
    background: #f5f5f5;
}

.profile-header:hover .profile-dropdown {
    display: flex;
}

body{margin:0;font-family:Arial,sans-serif;background:#f4f6f9;color:#343a40;}
.sidebar{position:fixed;top:0;left:0;height:100%;width:60px;background:#1f2a44;padding-top:30px;display:flex;flex-direction:column;overflow:hidden;transition:width 0.3s;}
.sidebar:hover{width:220px;}
.sidebar .logo{display:flex;justify-content:center;margin-bottom:40px;}
.sidebar .logo img{height:48px;transition:height 0.3s;}
.sidebar:hover .logo img{height:128px;}
.sidebar a{display:flex;align-items:center;padding:15px 10px;text-decoration:none;color:#fff;font-weight:500;border-left:4px solid transparent;transition:all 0.3s;}
.sidebar a span{display:none;}
.sidebar:hover a span{display:inline;margin-left:25px;}
.sidebar a:hover{background:#34495e;border-left:4px solid #E64C3C;}
.header{margin-left:60px;height:80px;background:#fff;display:flex;align-items:center;padding:0 30px;box-shadow:0 2px 6px rgba(0,0,0,0.1);}
.sidebar:hover ~ .header{margin-left:220px;}
.main-content{margin-left:60px;padding:30px;}
.sidebar:hover ~ .main-content{margin-left:220px;}
.product-details{background:#fff;padding:30px;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.1);max-width:700px;margin:0 auto;text-align:center;}
.product-details img{width:250px;height:250px;object-fit:cover;border-radius:10px;margin-bottom:15px;}
.btn{padding:8px 14px;border-radius:5px;text-decoration:none;color:white;margin:5px;display:inline-block;}
.btn-primary{background:#007bff;} .btn-warning{background:#ffc107;color:#000;} .btn-danger{background:#dc3545;} .btn:hover{opacity:0.9;}
</style>

{% if is_granted('ROLE_ADMIN') %}
<!-- Sidebar -->
<div class="sidebar">
    <div class="logo">
        <img src="{{ asset('images/Cart-2.png') }}" alt="Cartlify Logo">
    </div>
    <a href="{{ path('app_dashboard') }}">
        <i class="fas fa-home" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Dashboard</span>
    </a>
    
    <!-- Products -->
    <a href="{{ path('app_product_index') }}">
        <i class="fas fa-shopping-bag" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Products</span>
    </a>
    
    <!-- Stocks -->
    <a href="{{ path('app_stock_index') }}">
        <i class="fas fa-boxes" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Stocks</span>
    </a>
    
    <!-- Marketplace -->
    <a href="{{ path('app_order_new') }}">
        <i class="fas fa-shopping-cart" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Marketplace</span>
    </a>
    
    <!-- Transactions -->
    <a href="{{ path('app_order_index') }}">
        <i class="fas fa-receipt" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Transactions</span>
    </a>
    
    <!-- Staff Management -->
    <a href="{{ path('app_user_index') }}">
        <i class="fas fa-user-tie" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Staff Management</span>
    </a>
    
    <!-- Activity Logs -->
    <a href="{{ path('app_activity_log_index') }}">
        <i class="fas fa-clipboard-list" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Activity Logs</span>
    </a>
    <a href="{{ path('app_profile_index') }}">
        <i class="fas fa-user"></i>
        <span>Profile</span>
    </a>
    <!-- Logout -->
    <a href="{{ path('app_logout') }}">
        <i class="fas fa-power-off" style="font-size: 18px; width: 24px; text-align: center;"></i>
        <span>Logout</span>
    </a>
</div>

{% set role = app.user.roles[0] ?? 'ROLE_USER' %}

{% set avatarLetter = 
    role == 'ROLE_ADMIN' ? 'A' :
    (role == 'ROLE_STAFF' ? 'S' :
    (role == 'ROLE_USER' ? 'U' :
    app.user.username|first|upper))
%}

<div class="header">
    <h1>Product Details</h1>

    <div class="profile-wrapper">
        <div class="profile-header">
            <div class="profile-avatar">{{ avatarLetter }}</div>
            <span class="profile-name">{{ app.user.username }}</span>
        </div>
    </div>
</div>


<div class="main-content">
    <div class="product-details">
        {% if product.image %}
            {% set imagePath = product.image %}
            {# Fix for image paths - prepend /uploads/ if needed #}
            {% if not (imagePath starts with 'http' or imagePath starts with '/' or imagePath starts with asset('')) %}
                {% set imagePath = '/uploads/' ~ imagePath %}
            {% endif %}
            <img src="{{ imagePath }}" alt="{{ product.name }}" 
                 onerror="this.onerror=null; this.src='{{ asset('images/no-image.png') }}'; this.alt='Image not available';">
        {% else %}
            <img src="{{ asset('images/no-image.png') }}" alt="No Image">
        {% endif %}
        <h2>{{ product.name }}</h2>
        <p>{{ product.description }}</p>
        <p><strong>Price:</strong> ₱{{ product.price|number_format(2,'.',',') }}</p>
        <p><strong>Category:</strong> {{ product.category ? product.category.category : 'N/A' }}</p>
        <p><strong>ID:</strong> {{ product.id }}</p>
        <p><strong>Created:</strong> {{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</p>

        <a href="{{ path('app_product_index') }}" class="btn btn-primary">Back to List</a>
        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-warning">Edit</a>
    </div>
</div>

