<div class="sidebar-overlay" id="sidebarOverlay"></div>

{% set role = app.user.roles[0] ?? 'ROLE_USER' %}
{% set hasProfilePic = app.user.profilePicture is defined and app.user.profilePicture is not null %}
{% set userRoleName = role == 'ROLE_ADMIN' ? 'Administrator' : (role == 'ROLE_STAFF' ? 'Staff Member' : 'User') %}
{% set userRoleIcon = role == 'ROLE_ADMIN' ? 'crown' : (role == 'ROLE_STAFF' ? 'user-tie' : 'user') %}

<div class="header">
    <h1><button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button><i class="fas fa-edit"></i> Edit Product</h1>
    <div class="profile-wrapper">
        <div class="profile-header" id="profileHeader">
            <div class="profile-avatar">{% if hasProfilePic %}<img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">{% else %}{{ app.user.username|first|upper }}{% endif %}</div>
            <span class="profile-name">{{ app.user.username }}</span><i class="fas fa-chevron-down dropdown-icon"></i>
        </div>
        <div class="profile-dropdown" id="profileDropdown">
            <div class="dropdown-role-header"><i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}</div>
            <a href="{{ path('app_profile_index') }}" class="dropdown-item"><i class="fas fa-user-circle"></i><span>My Profile</span></a>
            <a href="#" class="dropdown-item" id="changeProfilePicBtn"><i class="fas fa-camera"></i><span>Change Picture</span></a>
            <div class="dropdown-divider"></div>
            <a href="{{ path('app_logout') }}" class="dropdown-item logout-item"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a>
        </div>
    </div>
</div>

<form id="profilePicUploadForm" method="post" enctype="multipart/form-data" style="display: none;"><input type="file" id="profilePicInput" name="profile_picture" accept="image/*"></form>

<div class="main-content">
    <div class="form-container">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
        
        <div class="current-image-section">
            <div class="current-image-label">Current Image</div>
            {% if form.vars.value.image %}
                {% set imagePath = form.vars.value.image %}
                {% if not (imagePath starts with 'http' or imagePath starts with '/') %}{% set imagePath = '/uploads/' ~ imagePath %}{% endif %}
                <img src="{{ imagePath }}" alt="Current product image" class="current-image">
            {% else %}
                <div class="no-image">No image uploaded</div>
            {% endif %}
        </div>
        
        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
            <small class="form-help">Required - Product name must be unique</small>
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
            <small class="form-help">Required - Describe your product details</small>
            {{ form_errors(form.description) }}
        </div>

        <div class="form-group">
            {{ form_label(form.price) }}
            {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
            <small class="form-help">Required - Must be greater than 0</small>
            {{ form_errors(form.price) }}
        </div>

        <div class="form-group">
            {{ form_label(form.category) }}
            {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
            <small class="form-help">Required - Select a category for this product</small>
            {{ form_errors(form.category) }}
        </div>

        <div class="form-group">
            {{ form_label(form.image) }}
            {{ form_widget(form.image, {'attr': {'class': 'form-control', 'placeholder': 'https://example.com/image.jpg'}}) }}
            <small class="form-help">Optional - Provide an image URL (leave blank if uploading a file)</small>
            {{ form_errors(form.image) }}
        </div>

        <div class="form-group">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control-file'}}) }}
            <small class="form-help">Optional - Upload an image file (PNG, JPEG, JPG, GIF, WEBP, AVIF up to 5MB)</small>
            <small class="form-help" style="color: #ffc107;">⚠️ Note: Use only ONE image source (URL OR upload), not both</small>
            {{ form_errors(form.imageFile) }}
        </div>

        <div class="button-group">
            <button class="btn-update"><i class="fas fa-save"></i> Update Product</button>
            <a href="{{ path('app_product_index') }}" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Products</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
(function() {
    // Toast Notification System
    function showToast(message, type) {
        type = type || 'success';
        let container = document.getElementById('toastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'toast-container';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        toast.className = 'toast toast-' + type;
        let icon = type === 'success' ? '✓' : (type === 'error' ? '✗' : (type === 'warning' ? '⚠' : 'ℹ'));
        toast.innerHTML = '<div class="toast-icon">' + icon + '</div><div class="toast-content">' + message + '</div><div class="toast-progress"></div>';
        container.appendChild(toast);
        setTimeout(function() { toast.style.animation = 'slideOutRight 0.3s ease'; setTimeout(function() { if(toast && toast.remove) toast.remove(); }, 300); }, 5000);
    }

    // Display flash messages
    function displayFlashMessages() {
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                showToast('{{ message|escape('js') }}', '{{ label }}');
            {% endfor %}
        {% endfor %}
    }

    // Mobile Sidebar Toggle
    let sidebarInitialized = false;
    function initMobileSidebar() {
        if (sidebarInitialized) return;
        var menuToggle = document.getElementById('menuToggle');
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');
        if (!menuToggle || !sidebar) return;
        function openSidebar() { sidebar.classList.add('mobile-open'); if (overlay) overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
        function closeSidebar() { sidebar.classList.remove('mobile-open'); if (overlay) overlay.classList.remove('active'); document.body.style.overflow = ''; }
        var newToggle = menuToggle.cloneNode(true);
        menuToggle.parentNode.replaceChild(newToggle, menuToggle);
        var newMenuToggle = document.getElementById('menuToggle');
        newMenuToggle.addEventListener('click', function(e) { e.stopPropagation(); e.preventDefault(); var sidebarEl = document.getElementById('sidebar'); if (sidebarEl.classList.contains('mobile-open')) { closeSidebar(); } else { openSidebar(); } });
        if (overlay) { var newOverlay = overlay.cloneNode(true); overlay.parentNode.replaceChild(newOverlay, overlay); var newOverlayEl = document.getElementById('sidebarOverlay'); newOverlayEl.addEventListener('click', closeSidebar); }
        document.addEventListener('click', function(e) { var currentSidebar = document.getElementById('sidebar'); var currentMenuToggle = document.getElementById('menuToggle'); if (window.innerWidth <= 768 && currentSidebar && currentSidebar.classList.contains('mobile-open')) { if (!currentSidebar.contains(e.target) && !currentMenuToggle.contains(e.target)) { closeSidebar(); } } });
        window.addEventListener('resize', function() { var currentSidebar = document.getElementById('sidebar'); if (window.innerWidth > 768 && currentSidebar && currentSidebar.classList.contains('mobile-open')) { closeSidebar(); } });
        sidebarInitialized = true;
    }

    // Profile dropdown
    let dropdownInitialized = false;
    function initializeDropdown() {
        if (dropdownInitialized) return;
        var profileHeader = document.getElementById('profileHeader');
        var profileDropdown = document.getElementById('profileDropdown');
        var changePicBtn = document.getElementById('changeProfilePicBtn');
        if (profileHeader && profileDropdown) {
            var newHeader = profileHeader.cloneNode(true);
            profileHeader.parentNode.replaceChild(newHeader, profileHeader);
            var newProfileHeader = document.getElementById('profileHeader');
            newProfileHeader.addEventListener('click', function(e) { e.stopPropagation(); this.classList.toggle('active'); var dropdown = document.getElementById('profileDropdown'); if (dropdown) dropdown.classList.toggle('show'); });
            document.addEventListener('click', function(e) { var header = document.getElementById('profileHeader'); var dropdown = document.getElementById('profileDropdown'); if (header && dropdown && !header.contains(e.target) && !dropdown.contains(e.target)) { header.classList.remove('active'); dropdown.classList.remove('show'); } });
            dropdownInitialized = true;
        }
        if (changePicBtn) {
            var newChangeBtn = changePicBtn.cloneNode(true);
            changePicBtn.parentNode.replaceChild(newChangeBtn, changePicBtn);
            var newChangePicBtn = document.getElementById('changeProfilePicBtn');
            if (newChangePicBtn) { newChangePicBtn.addEventListener('click', function(e) { e.preventDefault(); showUploadModal(); }); }
        }
    }

    function showUploadModal() {
        var existingModal = document.getElementById('uploadModal');
        if (existingModal) existingModal.remove();
        var modal = document.createElement('div');
        modal.id = 'uploadModal';
        modal.className = 'modal';
        modal.innerHTML = '<div class="modal-content"><div class="modal-header"><h3>Change Profile Picture</h3><button class="close-modal">&times;</button></div><div class="modal-body"><div class="upload-area" id="uploadArea"><i class="fas fa-cloud-upload-alt"></i><p>Click to upload or drag and drop</p><small>PNG, JPG, GIF, WebP up to 2MB</small></div><div class="image-preview" id="imagePreview" style="display: none;"><img src="" alt="Preview"></div><div class="upload-progress" id="uploadProgress" style="display: none;"><div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div><span id="progressText">0%</span></div></div><div class="modal-footer"><button class="btn-secondary-modal" id="cancelUpload">Cancel</button><button class="btn-primary-modal" id="saveUpload" disabled>Upload</button></div></div>';
        document.body.appendChild(modal);
        setTimeout(function() { modal.classList.add('show'); }, 10);
        var uploadArea = document.getElementById('uploadArea');
        var imagePreview = document.getElementById('imagePreview');
        var previewImg = imagePreview.querySelector('img');
        var saveBtn = document.getElementById('saveUpload');
        var cancelBtn = document.getElementById('cancelUpload');
        var closeBtn = modal.querySelector('.close-modal');
        var progressContainer = document.getElementById('uploadProgress');
        var progressFill = document.getElementById('progressFill');
        var progressText = document.getElementById('progressText');
        var fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp';
        fileInput.style.display = 'none';
        modal.appendChild(fileInput);
        uploadArea.addEventListener('click', function() { fileInput.click(); });
        fileInput.addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                if (!validTypes.includes(file.type)) { showToast('Please upload a valid image file (JPEG, PNG, GIF, WebP)', 'error'); return; }
                if (file.size > 2 * 1024 * 1024) { showToast('File size must be less than 2MB', 'error'); return; }
                var reader = new FileReader();
                reader.onload = function(e) { previewImg.src = e.target.result; imagePreview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; };
                reader.readAsDataURL(file);
            }
        });
        uploadArea.addEventListener('dragover', function(e) { e.preventDefault(); uploadArea.style.borderColor = '#007bff'; uploadArea.style.backgroundColor = 'rgba(0,123,255,0.05)'; });
        uploadArea.addEventListener('dragleave', function() { uploadArea.style.borderColor = '#ced4da'; uploadArea.style.backgroundColor = 'transparent'; });
        uploadArea.addEventListener('drop', function(e) {
            e.preventDefault();
            uploadArea.style.borderColor = '#ced4da';
            uploadArea.style.backgroundColor = 'transparent';
            var file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                if (file.size > 2 * 1024 * 1024) { showToast('File size must be less than 2MB', 'error'); return; }
                var reader = new FileReader();
                reader.onload = function(e) { previewImg.src = e.target.result; imagePreview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; var dataTransfer = new DataTransfer(); dataTransfer.items.add(file); fileInput.files = dataTransfer.files; };
                reader.readAsDataURL(file);
            }
        });
        saveBtn.addEventListener('click', function() { if (fileInput.files.length > 0) { uploadProfilePicture(fileInput.files[0]); } });
        function uploadProfilePicture(file) {
            var formData = new FormData();
            formData.append('profile_picture', file);
            progressContainer.style.display = 'block';
            saveBtn.disabled = true;
            var xhr = new XMLHttpRequest();
            xhr.upload.addEventListener('progress', function(e) { if (e.lengthComputable) { var percentComplete = Math.round((e.loaded / e.total) * 100); progressFill.style.width = percentComplete + '%'; progressText.textContent = percentComplete + '%'; } });
            xhr.addEventListener('load', function() {
                if (xhr.status === 200) {
                    try { var response = JSON.parse(xhr.responseText); if (response.success) { updateProfilePicture(response.imageUrl); showToast('Profile picture updated successfully!', 'success'); modal.classList.remove('show'); setTimeout(function() { modal.remove(); }, 300); } else { showToast(response.message || 'Upload failed', 'error'); resetUpload(); } } catch (e) { showToast('Invalid server response', 'error'); resetUpload(); }
                } else { showToast('Upload failed. Please try again.', 'error'); resetUpload(); }
            });
            xhr.addEventListener('error', function() { showToast('Network error. Please try again.', 'error'); resetUpload(); });
            xhr.open('POST', '/dashboard/upload-profile-picture', true);
            xhr.send(formData);
        }
        function resetUpload() { progressContainer.style.display = 'none'; progressFill.style.width = '0%'; progressText.textContent = '0%'; saveBtn.disabled = false; }
        function updateProfilePicture(imageUrl) { var avatar = document.querySelector('.profile-avatar'); var url = imageUrl + '?t=' + new Date().getTime(); avatar.innerHTML = '<img src="' + url + '" alt="{{ app.user.username }}">'; }
        function closeModal() { modal.classList.remove('show'); setTimeout(function() { modal.remove(); }, 300); }
        cancelBtn.addEventListener('click', closeModal);
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
    }

    function initAll() {
        initMobileSidebar();
        displayFlashMessages();
        initializeDropdown();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(initAll, 100); });
    } else {
        setTimeout(initAll, 100);
    }
    document.addEventListener('turbo:load', function() { setTimeout(initAll, 100); });
})();
</script>
{% endblock %}