<!-- Sidebar Overlay for Mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

{# Profile Section #}
{% set role = app.user.roles[0] ?? 'ROLE_USER' %}
{% set hasProfilePic = app.user.profilePicture is defined and app.user.profilePicture is not null %}
{% set userRoleName = 
    role == 'ROLE_ADMIN' ? 'Administrator' :
    (role == 'ROLE_STAFF' ? 'Staff Member' : 'User')
%}
{% set userRoleIcon = 
    role == 'ROLE_ADMIN' ? 'crown' :
    (role == 'ROLE_STAFF' ? 'user-tie' : 'user')
%}

<!-- Sticky Header -->
<div class="header">
    <h1>
        <button class="menu-toggle" id="menuToggle">
            <i class="fas fa-bars"></i>
        </button>
        <i class="fas fa-edit"></i> Edit Product
    </h1>

    <div class="profile-wrapper">
        <div class="profile-header" id="profileHeader">
            <div class="profile-avatar">
                {% if hasProfilePic %}
                    <img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">
                {% else %}
                    {{ app.user.username|first|upper }}
                {% endif %}
            </div>
            <span class="profile-name">{{ app.user.username }}</span>
            <i class="fas fa-chevron-down dropdown-icon"></i>
        </div>
        
        <div class="profile-dropdown" id="profileDropdown">
            <div class="dropdown-role-header">
                <i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}
            </div>
            <a href="{{ path('app_profile_index') }}" class="dropdown-item">
                <i class="fas fa-user-circle"></i>
                <span>My Profile</span>
            </a>
            <a href="#" class="dropdown-item" id="changeProfilePicBtn">
                <i class="fas fa-camera"></i>
                <span>Change Picture</span>
            </a>
            <div class="dropdown-divider"></div>
            <a href="{{ path('app_logout') }}" class="dropdown-item logout-item">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </div>
    </div>
</div>

<!-- Hidden File Upload Form -->
<form id="profilePicUploadForm" method="post" enctype="multipart/form-data" style="display: none;">
    <input type="file" id="profilePicInput" name="profile_picture" accept="image/*">
</form>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<div class="main-content">
    <div class="form-container">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        
        <!-- Current Image Section - Placed above form fields -->
        <div class="current-image-section">
            <div class="current-image-label">Current Image</div>
            {% if form.vars.value.image %}
                {% set imagePath = form.vars.value.image %}
                {% if not (imagePath starts with 'http' or imagePath starts with '/') %}
                    {% set imagePath = '/uploads/' ~ imagePath %}
                {% endif %}
                <img src="{{ imagePath }}" alt="Current product image" class="current-image">
            {% else %}
                <div class="no-image">No image uploaded</div>
            {% endif %}
        </div>
        
        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
            {{ form_help(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
            {{ form_help(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-group">
            {{ form_label(form.price) }}
            {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
