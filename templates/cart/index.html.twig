            </div>

            <div class="cart-actions">
                <form method="post" action="{{ path('app_cart_clear') }}" onsubmit="return confirm('Clear entire cart? This action cannot be undone.')">
                    <button type="submit" class="btn-clear"><i class="fas fa-trash-alt"></i> Clear Cart</button>
