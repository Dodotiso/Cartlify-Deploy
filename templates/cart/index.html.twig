<div class="main-content">
    <div class="cart-container">
        <div class="cart-header">
            <h2><i class="fas fa-shopping-cart"></i> Your Shopping Cart</h2>
            {% if cartItems|length > 0 %}
                <a href="{{ path('app_order_new') }}" class="btn-continue"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
            {% endif %}
        </div>

        {% if cartItems|length > 0 %}
            <div style="overflow-x: auto;">
                <table class="cart-table" id="cartTable">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Image</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in cartItems %}
                            <tr id="cart-item-{{ item.id }}" data-item-id="{{ item.id }}" data-price="{{ item.stock.product.price }}" data-max-stock="{{ item.stock.stock }}">
                                <td class="product-name">{{ item.stock.product.name }}</td>
                                <td class="product-image-cell">
                                    {% if item.stock.product.image %}
                                        {% set imagePath = item.stock.product.image %}
                                        {% if not (imagePath starts with 'http' or imagePath starts with '/') %}
                                            {% set imagePath = '/uploads/' ~ imagePath %}
                                        {% endif %}
                                        <img src="{{ imagePath }}" class="product-image" alt="{{ item.stock.product.name }}" onerror="this.src='{{ asset('images/placeholder.png') }}'">
                                    {% else %}
                                        <div style="width:60px;height:60px;background:#f8f9fa;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                                            <i class="fas fa-image" style="color:#adb5bd;"></i>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>₱{{ item.stock.product.price|number_format(2, '.', ',') }}</td>
                                <td>
                                    <input type="number" class="quantity-input" value="{{ item.quantity }}" min="1" max="{{ item.stock.stock }}" data-item-id="{{ item.id }}" data-original-quantity="{{ item.quantity }}">
                                    <div class="quantity-update-status" style="font-size: 11px; color: #28a745; margin-top: 5px; display: none;">✓ Updated</div>
                                </td>
                                <td class="subtotal" style="color:#28a745;font-weight:600;">₱{{ item.subtotal|number_format(2, '.', ',') }}</td>
                                <td>
                                    <form method="post" action="{{ path('app_cart_remove', {'itemId': item.id}) }}" onsubmit="return confirm('Remove this item from cart?')" style="display: inline-block;">
