<button class="scroll-top" id="scrollTop">↑</button>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
// ============================================
// ADD TO CART MODAL VARIABLES
// ============================================
let addCartStockId = null;
let addCartProductName = '';
let addCartProductPrice = 0;
let addCartMaxStock = 0;
let addCartProductImage = '';

// ============================================
// BUY NOW MODAL VARIABLES
// ============================================
let buyNowStockId = null;
let buyNowProductName = '';
let buyNowProductPrice = 0;
let buyNowMaxStock = 0;
let buyNowProductImage = '';

// ============================================
// ADD TO CART FUNCTIONS
// ============================================
function openAddToCartModal(productId, productName, price, stock, image) {
    addCartStockId = productId;
    addCartProductName = productName;
    addCartProductPrice = price;
    addCartMaxStock = stock;
    addCartProductImage = image;
    
    document.getElementById('addCartProductName').textContent = productName;
    document.getElementById('addCartProductPrice').textContent = '₱' + price.toLocaleString('en-US', {minimumFractionDigits: 2});
    document.getElementById('addCartStockAmount').textContent = stock;
    document.getElementById('addCartQuantity').value = 1;
    
    const imgElement = document.getElementById('addCartProductImage');
    if (image) {
        let imagePath = image;
        if (!imagePath.startsWith('http') && !imagePath.startsWith('/')) {
            imagePath = '/uploads/' + imagePath;
        }
        imgElement.src = imagePath;
        imgElement.onerror = () => imgElement.src = '{{ asset('images/placeholder.jpg') }}';
    } else {
        imgElement.src = '{{ asset('images/placeholder.jpg') }}';
    }
    
    updateAddCartTotal();
    document.getElementById('addToCartModal').classList.add('show');
}

function closeAddToCartModal() {
    document.getElementById('addToCartModal').classList.remove('show');
    addCartStockId = null;
}

function incrementAddCartQuantity() {
    let val = parseInt(document.getElementById('addCartQuantity').value) || 1;
    if (val < addCartMaxStock) {
        document.getElementById('addCartQuantity').value = val + 1;
        updateAddCartTotal();
    } else {
        showToast('Maximum stock available is ' + addCartMaxStock, 'warning');
    }
}

function decrementAddCartQuantity() {
    let val = parseInt(document.getElementById('addCartQuantity').value) || 1;
    if (val > 1) {
        document.getElementById('addCartQuantity').value = val - 1;
        updateAddCartTotal();
    }
}

function updateAddCartTotal() {
    let qty = parseInt(document.getElementById('addCartQuantity').value) || 1;
    let total = addCartProductPrice * qty;
    document.getElementById('addCartTotalAmount').textContent = '₱' + total.toLocaleString('en-US', {minimumFractionDigits: 2});
}

function confirmAddToCart() {
    if (!addCartStockId) return;
    let qty = parseInt(document.getElementById('addCartQuantity').value) || 1;
    if (qty > addCartMaxStock) {
        showToast('Not enough stock', 'error');
        return;
    }
    
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/cart/add/' + addCartStockId;
    
    const qtyInput = document.createElement('input');
    qtyInput.type = 'hidden';
    qtyInput.name = 'quantity';
    qtyInput.value = qty;
    form.appendChild(qtyInput);
    
    document.body.appendChild(form);
    form.submit();
}

// ============================================
// BUY NOW FUNCTIONS
// ============================================
function openBuyNowModal(productId, productName, price, stock, image) {
    buyNowStockId = productId;
    buyNowProductName = productName;
    buyNowProductPrice = price;
    buyNowMaxStock = stock;
    buyNowProductImage = image;
    
    document.getElementById('buyNowStockId').value = productId;
    document.getElementById('buyNowProductName').textContent = productName;
    document.getElementById('buyNowProductPrice').textContent = '₱' + price.toLocaleString('en-US', {minimumFractionDigits: 2});
    document.getElementById('buyNowStockAmount').textContent = stock;
    document.getElementById('buyNowQuantityDisplay').value = 1;
    document.getElementById('buyNowQuantityHidden').value = 1;
    
    const imgElement = document.getElementById('buyNowProductImage');
    if (image) {
        let imagePath = image;
        if (!imagePath.startsWith('http') && !imagePath.startsWith('/')) {
            imagePath = '/uploads/' + imagePath;
        }
        imgElement.src = imagePath;
        imgElement.onerror = () => imgElement.src = '{{ asset('images/placeholder.jpg') }}';
    } else {
        imgElement.src = '{{ asset('images/placeholder.jpg') }}';
    }
    
    updateBuyNowTotal();
    document.getElementById('buyNowModal').classList.add('show');
}

function closeBuyNowModal() {
    document.getElementById('buyNowModal').classList.remove('show');
    buyNowStockId = null;
}

function incrementBuyNowQuantity() {
    let val = parseInt(document.getElementById('buyNowQuantityDisplay').value) || 1;
    if (val < buyNowMaxStock) {
        document.getElementById('buyNowQuantityDisplay').value = val + 1;
        document.getElementById('buyNowQuantityHidden').value = val + 1;
        updateBuyNowTotal();
    } else {
        showToast('Maximum stock available is ' + buyNowMaxStock, 'warning');
    }
}

function decrementBuyNowQuantity() {
    let val = parseInt(document.getElementById('buyNowQuantityDisplay').value) || 1;
    if (val > 1) {
        document.getElementById('buyNowQuantityDisplay').value = val - 1;
        document.getElementById('buyNowQuantityHidden').value = val - 1;
        updateBuyNowTotal();
    }
}

function updateBuyNowTotal() {
    let qty = parseInt(document.getElementById('buyNowQuantityDisplay').value) || 1;
    let total = buyNowProductPrice * qty;
    document.getElementById('buyNowTotalAmount').textContent = '₱' + total.toLocaleString('en-US', {minimumFractionDigits: 2});
}

function toggleBuyNowAddressField() {
    const deliveryType = document.getElementById('buyNowDeliveryType').value;
    const addressField = document.getElementById('buyNowAddressField');
    const addressInput = document.getElementById('buyNowDeliveryAddress');
    
    if (deliveryType === 'shipping') {
        addressField.style.display = 'block';
        addressInput.required = true;
    } else {
        addressField.style.display = 'none';
        addressInput.required = false;
    }
}

function selectBuyNowPaymentMethod(method) {
    document.querySelectorAll('#buyNowModal .payment-method').forEach(el => el.classList.remove('selected'));
    document.querySelector(`#buyNowModal .payment-method[data-payment="${method}"]`).classList.add('selected');
    document.getElementById('buyNowSelectedPaymentMethod').value = method;
}

function validateBuyNowForm() {
    const name = document.getElementById('buyNowCustomerName').value.trim();
    const email = document.getElementById('buyNowCustomerEmail').value.trim();
    const phone = document.getElementById('buyNowCustomerPhone').value.trim();
    const deliveryType = document.getElementById('buyNowDeliveryType').value;
    const address = document.getElementById('buyNowDeliveryAddress').value.trim();
    const emailError = document.getElementById('buyNowEmailError');
    
    if (!name) {
        showToast('Please enter your full name', 'error');
        return false;
    }
    
    if (!email) {
        emailError.textContent = 'Email address is required';
        emailError.style.display = 'block';
        return false;
    }
    
    const emailPattern = /^[a-zA-Z0-9._%+-]+@(gmail\.com|yahoo\.com|yahoo\.com\.ph|outlook\.com|hotmail\.com)$/i;
    if (!emailPattern.test(email)) {
        emailError.textContent = 'Please enter a valid email address (e.g., name@gmail.com or name@yahoo.com)';
        emailError.style.display = 'block';
        return false;
    }
    emailError.style.display = 'none';
    
    if (!phone) {
        showToast('Please enter your contact number', 'error');
        return false;
    }
    
    const cleanPhone = phone.replace(/[^0-9+]/g, '');
    if (!cleanPhone.match(/^\+?[0-9]{10,15}$/)) {
        showToast('Please enter a valid phone number (e.g., +639123456789)', 'error');
        return false;
    }
    
    if (deliveryType === 'shipping' && !address) {
        showToast('Please enter your delivery address', 'error');
        return false;
    }
    
    return true;
}

function submitBuyNowOrder() {
    if (!validateBuyNowForm()) {
        return;
    }
    document.getElementById('buyNowForm').submit();
}

// ============================================
// BUTTON CLICK HANDLERS
// ============================================
document.querySelectorAll('.btn-cart').forEach(btn => {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        const productId = this.dataset.productId;
        const productName = this.dataset.productName;
        const productPrice = parseFloat(this.dataset.productPrice);
        const productStock = parseInt(this.dataset.productStock);
        const productImage = this.dataset.productImage;
        const isLoggedIn = {{ app.user ? 'true' : 'false' }};
        
        if (!isLoggedIn) {
            showToast('Please login to add items to cart', 'error');
            setTimeout(() => { window.location.href = "{{ path('app_login') }}"; }, 1500);
            return;
        }
        
        openAddToCartModal(productId, productName, productPrice, productStock, productImage);
    });
});

document.querySelectorAll('.btn-buy-now').forEach(btn => {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        const productId = this.dataset.productId;
        const productName = this.dataset.productName;
        const productPrice = parseFloat(this.dataset.productPrice);
        const productStock = parseInt(this.dataset.productStock);
        const productImage = this.dataset.productImage;
        const isLoggedIn = {{ app.user ? 'true' : 'false' }};
        
        if (!isLoggedIn) {
            showToast('Please login to checkout', 'error');
            setTimeout(() => { window.location.href = "{{ path('app_login') }}"; }, 1500);
            return;
        }
        
        openBuyNowModal(productId, productName, productPrice, productStock, productImage);
    });
});

// ============================================
// NOTIFICATION FUNCTIONS
// ============================================
let notifications = [];

function loadNotifications() { 
    const saved = localStorage.getItem('order_notifications'); 
    notifications = saved ? JSON.parse(saved) : []; 
    updateNotificationUI(); 
    updateNotificationBadge();
}

function saveNotifications() { 
    localStorage.setItem('order_notifications', JSON.stringify(notifications)); 
    updateNotificationUI(); 
    updateNotificationBadge();
}

function updateNotificationBadge() {
    const unreadCount = notifications.filter(n => !n.read).length;
    const badge = document.getElementById('notificationBadge');
    if (badge) { 
        if (unreadCount > 0) { 
            badge.classList.add('show'); 
            badge.textContent = unreadCount > 99 ? '99+' : unreadCount; 
        } else { 
            badge.classList.remove('show'); 
        } 
    }
}

function updateNotificationUI() {
    const list = document.getElementById('notificationList');
    if (!list) return;
    if (notifications.length === 0) { 
        list.innerHTML = '<div style="padding:20px;text-align:center;color:#6c757d;"><i class="fas fa-bell-slash"></i> No notifications</div>'; 
    } else { 
        list.innerHTML = notifications.slice(0,5).map(n => `<div class="notification-item ${n.read ? '' : 'unread'}"><div class="notification-title">${n.title}</div><div class="notification-message">${n.message}</div><div class="notification-time">Just now</div></div>`).join('');
    }
}

function clearAllNotifications() { 
    if (confirm('Clear all notifications?')) { 
        notifications = []; 
        saveNotifications(); 
        showToast('All notifications cleared', 'success'); 
    } 
}

function showToast(message, type) {
    let container = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.innerHTML = `<div class="toast-icon">${type === 'success' ? '✓' : '✗'}</div><div class="toast-content">${message}</div><div class="toast-progress"></div>`;
    container.appendChild(toast);
    setTimeout(() => { toast.style.animation = 'slideOutRight 0.3s ease'; setTimeout(() => toast.remove(), 300); }, 3000);
}

function updateCartBadge() {
    fetch('/cart/count').then(res => res.json()).then(data => {
        const badge = document.getElementById('cartBadge');
        if (badge && data.count > 0) { 
            badge.textContent = data.count > 99 ? '99+' : data.count; 
            badge.classList.add('show'); 
        }
        else if (badge) { badge.classList.remove('show'); }
    }).catch(e => console.log('Cart error:', e));
}

function updateTrackerBadge() {
    fetch('{{ path('app_new_orders_count') }}').then(res => res.json()).then(data => {
        const badge = document.getElementById('trackerBadge');
        if (badge && data.count > 0) { 
            badge.textContent = data.count > 99 ? '99+' : data.count; 
            badge.classList.add('show'); 
        }
        else if (badge) { badge.classList.remove('show'); }
    }).catch(e => console.log('Tracker error:', e));
}

// ============================================
// PROFILE DROPDOWN
// ============================================
const profileHeader = document.getElementById('profileHeader');
const profileDropdown = document.getElementById('profileDropdown');
if (profileHeader && profileDropdown) {
    profileHeader.addEventListener('click', function(e) {
        e.stopPropagation();
        this.classList.toggle('active');
        profileDropdown.classList.toggle('show');
    });
    document.addEventListener('click', function(e) {
        if (!profileHeader.contains(e.target) && !profileDropdown.contains(e.target)) {
            profileHeader.classList.remove('active');
            profileDropdown.classList.remove('show');
        }
    });
}

// ============================================
// NOTIFICATION DROPDOWN
// ============================================
const notificationIcon = document.getElementById('notificationIcon');
const notificationDropdown = document.getElementById('notificationDropdown');
if (notificationIcon && notificationDropdown) {
    notificationIcon.addEventListener('click', function(e) {
        e.stopPropagation();
        notificationDropdown.classList.toggle('show');
        if (notifications.length > 0) {
            notifications.forEach(n => n.read = true);
            saveNotifications();
        }
    });
    document.addEventListener('click', function(e) {
        if (!notificationIcon.contains(e.target) && !notificationDropdown.contains(e.target)) {
            notificationDropdown.classList.remove('show');
        }
    });
}

// ============================================
// FILTER TOGGLE
// ============================================
const filterToggle = document.getElementById('filterToggle');
const filterBody = document.getElementById('filterBody');
if (filterToggle && filterBody) {
    filterToggle.addEventListener('click', () => {
        filterBody.classList.toggle('hidden');
        filterToggle.textContent = filterBody.classList.contains('hidden') ? 'Show Filters' : 'Hide Filters';
    });
}

// ============================================
// SCROLL TOP
// ============================================
const scrollTop = document.getElementById('scrollTop');
window.addEventListener('scroll', () => { scrollTop.classList.toggle('visible', window.scrollY > 300); });
scrollTop.addEventListener('click', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });

// ============================================
// INITIALIZE
// ============================================
document.addEventListener('DOMContentLoaded', () => {
    loadNotifications();
    updateCartBadge();
    updateTrackerBadge();
    setInterval(updateCartBadge, 5000);
    setInterval(updateTrackerBadge, 30000);
});
</script>
{% endblock %}