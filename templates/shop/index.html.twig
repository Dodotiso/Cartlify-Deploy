<div class="main-content">
    <section class="hero">
        <div class="hero-pattern"></div>
        <div class="hero-content">
            <h1 class="hero-title">Quality Products, Exceptional Value</h1>
            <p class="hero-description">Explore our curated selection of premium products. Free shipping on orders above ₱999.</p>
            <div class="hero-stats">
                <div class="stat-item">
                    <div class="stat-value">{{ products|length }}</div>
                    <div class="stat-label">Products</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">{{ categories|length }}</div>
                    <div class="stat-label">Categories</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">24/7</div>
                    <div class="stat-label">Support</div>
                </div>
            </div>
        </div>
    </section>

    <div class="filter-section">
        <div class="filter-header">
            <div class="filter-title">
                <h3>Refine Results</h3>
            </div>
            <button class="filter-toggle" id="filterToggle">Hide Filters</button>
        </div>

        <form method="get" action="{{ path('app_shop') }}" id="filterForm">
            <div class="filter-grid" id="filterBody">
                <div class="filter-field">
                    <label class="filter-label">Search</label>
                    <input type="text" class="filter-input" name="search" value="{{ search }}" placeholder="Keyword...">
                </div>
                <div class="filter-field">
                    <label class="filter-label">Category</label>
                    <select class="filter-select" name="category">
                        <option value="">All Categories</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}" {% if selectedCategory == category.id %}selected{% endif %}>{{ category.category }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="filter-field">
                    <label class="filter-label">Price Range (₱)</label>
                    <div class="price-range">
                        <input type="number" class="filter-input" name="min_price" value="{{ minPrice }}" placeholder="Min">
                        <input type="number" class="filter-input" name="max_price" value="{{ maxPrice }}" placeholder="Max">
                    </div>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">Apply</button>
                    <a href="{{ path('app_shop') }}" class="btn-secondary">Clear</a>
                </div>
            </div>
        </form>
    </div>

    <div class="results-bar">
        <div class="results-count">{{ products|length }} items found</div>
        <form method="get" action="{{ path('app_shop') }}" id="sortForm">
            <div class="sort-wrapper">
                <span>Sort by:</span>
                <select name="sort" class="sort-select" onchange="this.form.submit()">
                    <option value="newest" {% if currentSort == 'newest' %}selected{% endif %}>Newest First</option>
                    <option value="price_asc" {% if currentSort == 'price_asc' %}selected{% endif %}>Price: Low to High</option>
                    <option value="price_desc" {% if currentSort == 'price_desc' %}selected{% endif %}>Price: High to Low</option>
                    <option value="name_asc" {% if currentSort == 'name_asc' %}selected{% endif %}>Name: A to Z</option>
                    <option value="name_desc" {% if currentSort == 'name_desc' %}selected{% endif %}>Name: Z to A</option>
                </select>
            </div>
        </form>
    </div>

    {% if products is empty %}
        <div class="empty-state">
            <h3>No Products Found</h3>
            <p>Try adjusting your search or filter criteria.</p>
            <a href="{{ path('app_shop') }}" class="btn-primary">View All Products</a>
        </div>
    {% else %}
        <div class="products-grid">
            {% for product in products %}
                {% set totalStock = productStock[product.id] ?? 0 %}
                {% set stockClass = totalStock == 0 ? 'out' : (totalStock < 10 ? 'low' : '') %}
                {% set stockTextClass = totalStock == 0 ? 'out-of-stock' : (totalStock < 10 ? 'low-stock' : 'in-stock') %}
                {% set stockText = totalStock == 0 ? 'Out of Stock' : (totalStock < 10 ? 'Only ' ~ totalStock ~ ' left' : 'In Stock') %}
                
                <div class="product-card">
                    <div class="card-image">
                        {% if product.image %}
                            <img src="{{ product.image starts with 'http' ? product.image : asset('uploads/' ~ product.image) }}" alt="{{ product.name }}">
                        {% else %}
                            <img src="{{ asset('images/placeholder.jpg') }}" alt="No Image">
                        {% endif %}
                    </div>
                    <div class="card-content">
                        {% if product.category %}
                            <div class="card-category">{{ product.category.category }}</div>
                        {% endif %}
                        <h3 class="card-title">{{ product.name }}</h3>
                        <p class="card-description">{{ product.description|length > 80 ? product.description|slice(0,80) ~ '...' : product.description }}</p>
                        <div class="card-price">₱{{ product.price|number_format(2) }}</div>
                        <div class="stock-indicator">
                            <div class="stock-bar"><div class="stock-fill {{ stockClass }}" style="width: {{ totalStock > 50 ? 100 : (totalStock / 50 * 100) }}%"></div></div>
                            <span class="stock-text {{ stockTextClass }}">{{ stockText }}</span>
                        </div>
                        <div class="card-actions">
                            <button class="btn-cart" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}" data-product-price="{{ product.price }}" data-product-stock="{{ totalStock }}" data-product-image="{{ product.image }}" {% if totalStock == 0 %}disabled{% endif %}>Add to Cart</button>
                            <button class="btn-buy-now" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}" data-product-price="{{ product.price }}" data-product-stock="{{ totalStock }}" data-product-image="{{ product.image }}" {% if totalStock == 0 %}disabled{% endif %}>Buy Now</button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<!-- ADD TO CART MODAL -->
