<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
// ============================================
// REAL-TIME DASHBOARD WITH HEARTBEAT & AUTO-RECOVERY
// ============================================

// Toast Notification System
function showToast(message, type = 'success') {
    let container = document.getElementById('toastContainer');
    if (!container) {
        container = document.createElement('div');
        container.id = 'toastContainer';
        container.className = 'toast-container';
        document.body.appendChild(container);
    }
    
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    
    let icon = '';
    if (type === 'success') icon = '✓';
    if (type === 'error') icon = '✗';
    if (type === 'warning') icon = '⚠';
    if (type === 'info') icon = 'ℹ';
    
    toast.innerHTML = `
        <div class="toast-icon">${icon}</div>
        <div class="toast-content">${message}</div>
        <div class="toast-progress"></div>
    `;
    
    container.appendChild(toast);
    
    setTimeout(() => {
        toast.style.animation = 'slideOutRight 0.3s ease';
        setTimeout(() => toast.remove(), 300);
    }, 5000);
}

// Global variables
let chartInstances = {};
let dropdownInitialized = false;
let pollingInterval = null;
let heartbeatInterval = null;
let isPolling = true;
let pollingFrequency = 5000; // 5 seconds
let lastUpdateTimestamp = Date.now();
let previousData = {};
let isRefreshing = false;
let lastHeartbeat = Date.now();
let consecutiveErrors = 0;

// Update last update time
function updateLastUpdateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString();
    const updateSpan = document.getElementById('lastUpdateTime');
    if (updateSpan) {
        updateSpan.innerHTML = `Last updated: ${timeString}`;
    }
}

// Animate card update
function animateCard(cardElement) {
    if (cardElement) {
        cardElement.classList.add('card-updated');
        setTimeout(() => {
            cardElement.classList.remove('card-updated');
        }, 500);
    }
}

// Update metrics with real-time data
function updateMetrics(data) {
    let hasUpdates = false;
    
    // Update total products
    if (data.totalProducts !== undefined && previousData.totalProducts !== data.totalProducts) {
        const element = document.getElementById('totalProductsValue');
        if (element) {
            element.innerText = data.totalProducts;
            animateCard(document.querySelector('[data-metric="totalProducts"]'));
            hasUpdates = true;
        }
    }
    
    // Update total orders
    if (data.totalOrders !== undefined && previousData.totalOrders !== data.totalOrders) {
        const element = document.getElementById('totalOrdersValue');
        if (element) {
            element.innerText = data.totalOrders;
            animateCard(document.querySelector('[data-metric="totalOrders"]'));
            hasUpdates = true;
        }
    }
    
    // Update total income
    if (data.totalIncome !== undefined && previousData.totalIncome !== data.totalIncome) {
        const element = document.getElementById('totalIncomeValue');
        if (element) {
            element.innerText = `₱${data.totalIncome.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            animateCard(document.querySelector('[data-metric="totalIncome"]'));
            hasUpdates = true;
        }
    }
    
    // Update total users
    if (data.totalUsers !== undefined && previousData.totalUsers !== data.totalUsers) {
        const element = document.getElementById('totalUsersValue');
        if (element) {
            element.innerText = data.totalUsers;
            animateCard(document.querySelector('[data-metric="totalUsers"]'));
            hasUpdates = true;
        }
    }
    
    // Update total admins
    if (data.totalAdmins !== undefined && previousData.totalAdmins !== data.totalAdmins) {
        const element = document.getElementById('totalAdminsValue');
        if (element) {
            element.innerText = data.totalAdmins;
            animateCard(document.querySelector('[data-metric="totalAdmins"]'));
            hasUpdates = true;
        }
    }
    
    // Update total staff
    if (data.totalStaff !== undefined && previousData.totalStaff !== data.totalStaff) {
        const element = document.getElementById('totalStaffValue');
        if (element) {
            element.innerText = data.totalStaff;
            animateCard(document.querySelector('[data-metric="totalStaff"]'));
            hasUpdates = true;
        }
    }
    
    // Update today's orders
    if (data.todayOrders !== undefined && previousData.todayOrders !== data.todayOrders) {
        const element = document.getElementById('todayOrdersValue');
        if (element) {
            const oldValue = parseInt(previousData.todayOrders || 0);
            element.innerText = data.todayOrders;
            animateCard(document.querySelector('[data-metric="todayOrders"]'));
            
            if (data.todayOrders > oldValue) {
                showToast(`🛒 New order received! Total today: ${data.todayOrders}`, 'info');
            }
            hasUpdates = true;
        }
    }
    
    // Update today's sales
    if (data.todaySales !== undefined && previousData.todaySales !== data.todaySales) {
        const element = document.getElementById('todaySalesValue');
        if (element) {
            element.innerText = `₱${data.todaySales.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            animateCard(document.querySelector('[data-metric="todaySales"]'));
            hasUpdates = true;
        }
    }
    
    // Update average order value
    if (data.avgOrderValue !== undefined && previousData.avgOrderValue !== data.avgOrderValue) {
        const element = document.getElementById('avgOrderValueValue');
        if (element) {
            element.innerText = `₱${data.avgOrderValue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            hasUpdates = true;
        }
    }
    
    // Update low stock count
    if (data.lowStockCount !== undefined && previousData.lowStockCount !== data.lowStockCount) {
        const element = document.getElementById('lowStockCountValue');
        if (element) {
            const oldValue = parseInt(previousData.lowStockCount || 0);
            element.innerText = data.lowStockCount;
            if (data.lowStockCount > oldValue && data.lowStockCount > 0) {
                showToast(`⚠️ Warning: ${data.lowStockCount} items are low on stock!`, 'warning');
            }
            hasUpdates = true;
        }
    }
    
    // Update insight message
    if (data.insightMessage && previousData.insightMessage !== data.insightMessage) {
        const insightElement = document.getElementById('insightMessage');
        if (insightElement) {
            insightElement.textContent = data.insightMessage;
            hasUpdates = true;
        }
    }
    
    // Store current data for next comparison
    previousData = {...data};
    
    if (hasUpdates) {
        updateLastUpdateTime();
    }
    
    return hasUpdates;
}

// Update recent orders table
function updateRecentOrders(orders) {
    const tbody = document.getElementById('recentOrdersTable');
    if (!tbody) return;
    
    // Check if orders have changed
    const currentOrders = Array.from(tbody.querySelectorAll('tr[data-order-id]')).map(row => row.dataset.orderId);
    const newOrderIds = orders.map(order => order.id.toString());
    
    // Check if there are new orders
    const hasNewOrders = newOrderIds.some(id => !currentOrders.includes(id));
    
    if (hasNewOrders) {
        // Clear existing rows except "no orders" row
        const rows = tbody.querySelectorAll('tr');
        rows.forEach(row => {
            if (row.id !== 'noOrdersRow') {
                row.remove();
            }
        });
        
        // Add new orders
        orders.forEach(order => {
            const newRow = document.createElement('tr');
            newRow.style.borderBottom = '1px solid #f1f1f1';
            newRow.className = 'new-order-row';
            newRow.setAttribute('data-order-id', order.id);
            
            const productName = order.productName || 'Product';
            const truncatedName = productName.length > 20 ? productName.substring(0, 20) + '...' : productName;
            
            newRow.innerHTML = `
                <td style="padding: 12px; font-weight: 500;">#${order.id}</td>
                <td style="padding: 12px;">${truncatedName}</td>
                <td style="padding: 12px;">${order.quantity}</td>
                <td style="padding: 12px; font-weight: 600; color: #28a745;">₱${parseFloat(order.totalAmount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                <td style="padding: 12px; color: #6c757d;">${order.createdAt}</td>
            `;
            
            tbody.appendChild(newRow);
            
            // Show notification for new order
            showToast(`🛒 New order #${order.id} received! Amount: ₱${parseFloat(order.totalAmount).toLocaleString()}`, 'success');
        });
        
        // Show notification badge
        const badge = document.getElementById('newOrderBadge');
        if (badge) {
            badge.style.display = 'flex';
            setTimeout(() => {
                badge.style.display = 'none';
            }, 3000);
        }
        
        // Remove highlight class after animation
        setTimeout(() => {
            tbody.querySelectorAll('.new-order-row').forEach(row => {
                row.classList.remove('new-order-row');
            });
        }, 2000);
    }
}

// Update chart data with recovery
function updateChartData(chartId, newData) {
    const chart = chartInstances[chartId];
    if (chart && newData) {
        try {
            let needsUpdate = false;
            
            if (newData.labels && JSON.stringify(chart.data.labels) !== JSON.stringify(newData.labels)) {
                chart.data.labels = newData.labels;
                needsUpdate = true;
            }
            
            if (newData.data && JSON.stringify(chart.data.datasets[0].data) !== JSON.stringify(newData.data)) {
                chart.data.datasets[0].data = newData.data;
                needsUpdate = true;
            }
            
            if (needsUpdate) {
                chart.update('none');
            }
        } catch (e) {
            console.error(`Error updating chart ${chartId}:`, e);
            // Chart might be corrupted, force re-render
            forceChartRerender();
        }
    } else if (newData && !chart) {
        // Chart instance missing, force re-render
        forceChartRerender();
    }
}

// Force all charts to re-render
function forceChartRerender() {
    console.log('Forcing chart re-render...');
    renderCharts();
}

// Update sales trend chart
function updateSalesTrend(data) {
    if (data.salesTrend) {
        updateChartData('salesTrend', data.salesTrend);
    }
}

// Update product distribution chart
function updateProductDistribution(data) {
    if (data.productCategories) {
        updateChartData('productDistribution', data.productCategories);
    }
}

// Update stock chart
function updateStockChart(data) {
    if (data.stockLevels) {
        updateChartData('stockGauge', data.stockLevels);
    }
}

// Fetch real-time updates with cache busting
async function fetchRealtimeUpdates(forceRefresh = false) {
    if ((!isPolling && !forceRefresh) || isRefreshing) return;
    
    isRefreshing = true;
    
    try {
        // Add cache-busting timestamp
        const timestamp = Date.now();
        const response = await fetch(`/dashboard/realtime-updates?_=${timestamp}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'X-Last-Update': lastUpdateTimestamp.toString(),
                'Cache-Control': 'no-cache, no-store, must-revalidate',
                'Pragma': 'no-cache',
                'Expires': '0'
            }
        });
        
        if (response.ok) {
            consecutiveErrors = 0;
            const data = await response.json();
            
            if (data.hasUpdates || forceRefresh) {
                if (data.metrics) {
                    updateMetrics(data.metrics);
                }
                
                if (data.salesTrend) {
                    updateSalesTrend(data);
                }
                if (data.productCategories) {
                    updateProductDistribution(data);
                }
                if (data.stockLevels) {
                    updateStockChart(data);
                }
                
                if (data.recentOrders) {
                    updateRecentOrders(data.recentOrders);
                }
                
                lastUpdateTimestamp = Date.now();
                lastHeartbeat = Date.now();
            }
        } else {
            consecutiveErrors++;
            if (consecutiveErrors >= 3) {
                console.warn('Multiple fetch errors, attempting recovery...');
                forceChartRerender();
                consecutiveErrors = 0;
            }
        }
    } catch (error) {
        console.error('Error fetching real-time updates:', error);
        consecutiveErrors++;
        if (consecutiveErrors >= 3) {
            forceChartRerender();
            consecutiveErrors = 0;
        }
    } finally {
        isRefreshing = false;
    }
}

// Heartbeat to check if dashboard is still active
function startHeartbeat() {
    if (heartbeatInterval) {
        clearInterval(heartbeatInterval);
    }
    
    heartbeatInterval = setInterval(() => {
        const now = Date.now();
        const timeSinceLastUpdate = now - lastHeartbeat;
        
        // If no update for more than 30 seconds, force a refresh
        if (timeSinceLastUpdate > 30000) {
            console.log('Heartbeat: No updates for 30 seconds, forcing refresh...');
            manualRefresh();
        }
    }, 15000); // Check every 15 seconds
}

// Manual refresh function - no toast message
function manualRefresh() {
    fetchRealtimeUpdates(true);
}

// Toggle auto-refresh
function toggleAutoRefresh() {
    isPolling = !isPolling;
    const statusEl = document.getElementById('refreshStatus');
    const toggleBtn = document.getElementById('toggleRefresh');
    
    if (isPolling) {
        if (pollingInterval) {
            clearInterval(pollingInterval);
        }
        pollingInterval = setInterval(() => fetchRealtimeUpdates(false), pollingFrequency);
        statusEl.className = 'refresh-status active';
        statusEl.querySelector('span').textContent = 'Auto-refreshing every 5 seconds';
        toggleBtn.innerHTML = '<i class="fas fa-pause"></i>';
        showToast('Auto-refresh enabled', 'success');
    } else {
        if (pollingInterval) {
            clearInterval(pollingInterval);
            pollingInterval = null;
        }
        statusEl.className = 'refresh-status paused';
        statusEl.querySelector('span').textContent = 'Auto-refresh paused';
        toggleBtn.innerHTML = '<i class="fas fa-play"></i>';
        showToast('Auto-refresh paused', 'info');
    }
}

// Detect page visibility and refresh when returning to dashboard
function setupVisibilityDetection() {
    let wasHidden = false;
    
    document.addEventListener('visibilitychange', function() {
        if (!document.hidden) {
            // Page became visible again
            console.log('Dashboard became visible, checking charts...');
            
            // Check if charts are still rendered properly
            let chartsNeedRefresh = false;
            Object.keys(chartInstances).forEach(key => {
                if (!chartInstances[key] || !chartInstances[key].canvas) {
                    chartsNeedRefresh = true;
                }
            });
            
            if (chartsNeedRefresh) {
                console.log('Charts missing, re-rendering...');
                forceChartRerender();
            }
            
            // Always refresh data when coming back
            setTimeout(() => manualRefresh(), 100);
            wasHidden = true;
        } else {
            wasHidden = true;
        }
    });
    
    // Also detect when page is loaded from cache (back button)
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            // Page was loaded from cache (back button)
            console.log('Page loaded from cache, refreshing...');
            forceChartRerender();
            setTimeout(() => manualRefresh(), 100);
        }
    });
    
    // Detect if page becomes active after long inactivity
    document.addEventListener('click', function() {
        const now = Date.now();
        const timeSinceLastUpdate = now - lastHeartbeat;
        if (timeSinceLastUpdate > 30000) {
            console.log('User interaction after long inactivity, refreshing...');
            manualRefresh();
        }
    });
}

