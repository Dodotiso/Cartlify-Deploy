{% if is_granted('ROLE_ADMIN') %}
<!-- ============================================ -->
<!-- ADMIN MAIN CONTENT -->
<!-- ============================================ -->
<div class="main-content">
    <!-- Welcome Section -->
    <div class="welcome-section">
        <div class="welcome-content">
            <div class="welcome-text">
                <h2>Welcome back, {{ app.user.username }}!</h2>
                <p>Here's an overview of your store's performance.</p>
            </div>
            <div class="welcome-icon">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="dashboard-cards">
        <div class="card" data-metric="totalProducts">
            <div><i class="fas fa-box" style="font-size: 32px; color: #3b82f6;"></i></div>
            <div>
                <h3 id="totalProductsValue">{{ totalProducts|default('0') }}</h3>
                <p>Total Products</p>
            </div>
        </div>
        
        <div class="card" data-metric="totalMarketplaceProducts">
            <div><i class="fas fa-store" style="font-size: 32px; color: #10b981;"></i></div>
            <div>
                <h3 id="totalMarketplaceProductsValue">{{ totalMarketplaceProducts|default('0') }}</h3>
                <p>Marketplace Products</p>
            </div>
        </div>
        
        <div class="card" data-metric="totalOrders">
            <div><i class="fas fa-shopping-cart" style="font-size: 32px; color: #f59e0b;"></i></div>
            <div>
                <h3 id="totalOrdersValue">{{ totalOrders|default('0') }}</h3>
                <p>Total Transactions</p>
            </div>
        </div>
        
        <div class="card" data-metric="totalIncome">
            <div><i class="fas fa-money-bill-wave" style="font-size: 32px; color: #06b6d4;"></i></div>
            <div>
                <h3 id="totalIncomeValue">₱{{ totalIncome|default('0')|number_format(2) }}</h3>
                <p>Total Income</p>
            </div>
        </div>
        
        <div class="card" data-metric="totalUsers">
            <div><i class="fas fa-users" style="font-size: 32px; color: #64748b;"></i></div>
            <div>
                <h3 id="totalUsersValue">{{ totalUsers|default('0') }}</h3>
                <p>Total Customers</p>
            </div>
        </div>
        
        <div class="card" data-metric="totalStaff">
            <div><i class="fas fa-user-tie" style="font-size: 32px; color: #ef4444;"></i></div>
            <div>
                <h3 id="totalStaffValue">{{ totalStaff|default('0') }}</h3>
                <p>Staff Users</p>
            </div>
        </div>
        
        <div class="card" data-metric="totalActivityLogs">
            <div><i class="fas fa-clipboard-list" style="font-size: 32px; color: #f97316;"></i></div>
            <div>
                <h3 id="totalActivityLogsValue">{{ totalActivityLogs|default('0') }}</h3>
                <p>Activity Logs</p>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="chart-grid">
        <div class="chart-container full-width">
            <div class="chart-header">
                <h3><i class="fas fa-chart-line" style="color: #3b82f6; margin-right: 10px;"></i> Sales Trend (Last 6 Months)</h3>
            </div>
            <div class="chart-body">
                <canvas id="salesTrendChart"></canvas>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-header">
                <h3><i class="fas fa-chart-pie" style="color: #f59e0b; margin-right: 10px;"></i> Product Categories</h3>
            </div>
            <div class="chart-body">
                <canvas id="productDistributionChart"></canvas>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-header">
                <h3><i class="fas fa-boxes" style="color: #10b981; margin-right: 10px;"></i> Stock Level Overview</h3>
            </div>
            <div class="chart-body">
                <canvas id="stockGaugeChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Recent Orders -->
    <div class="activity-grid">
        <div class="activity-card">
            <h3><i class="fas fa-bolt" style="color: #f59e0b; margin-right: 10px;"></i> Quick Actions</h3>
            <div class="quick-actions">
                <a href="{{ path('app_user_new') }}" class="action-btn action-btn-primary">
                    <i class="fas fa-user-plus"></i>
                    <span>Add New User</span>
                </a>
                <a href="{{ path('app_product_new') }}" class="action-btn action-btn-success">
                    <i class="fas fa-plus-circle"></i>
                    <span>Add New Product</span>
                </a>
                <a href="{{ path('app_activity_log_index') }}" class="action-btn action-btn-secondary">
                    <i class="fas fa-clipboard-list"></i>
                    <span>View Activity Logs</span>
                </a>
                <a href="{{ path('app_order_index') }}" class="action-btn action-btn-info">
                    <i class="fas fa-receipt"></i>
                    <span>Manage Transactions</span>
                </a>
            </div>
        </div>

        <div class="activity-card" style="grid-column: span 2;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0;"><i class="fas fa-history" style="color: #3b82f6; margin-right: 10px;"></i> Recent Transactions</h3>
                <a href="{{ path('app_order_index') }}" class="view-all-link">View All <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Amount</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody id="recentOrdersTable">
                        {% for order in recentOrders|default([]) %}
                        <tr data-order-id="{{ order.id }}">
                            <td style="font-weight: 600;">#{{ order.id }}</td>
                            <td>
                                {% if order.stock and order.stock.product %}
                                    {{ order.stock.product.name|length > 20 ? order.stock.product.name|slice(0, 20) ~ '...' : order.stock.product.name }}
                                {% else %}
                                    <span style="color: #ef4444;">Product Not Available</span>
                                {% endif %}
                            </td>
