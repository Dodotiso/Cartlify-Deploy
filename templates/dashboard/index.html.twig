// Chart initialization function
function renderCharts() {
    if (typeof Chart === 'undefined') {
        console.log('Chart.js not loaded yet, retrying...');
        setTimeout(renderCharts, 100);
        return;
    }
    
    // Destroy existing charts safely
    Object.keys(chartInstances).forEach(key => {
        if (chartInstances[key]) {
            try {
                chartInstances[key].destroy();
            } catch (e) {
                console.error('Error destroying chart:', e);
            }
        }
    });
    chartInstances = {};
    
    setTimeout(() => {
        const salesCtx = document.getElementById('salesTrendChart');
        if (salesCtx) {
            const monthlySales = {{ monthlySales|default({labels: ['Jan','Feb','Mar','Apr','May','Jun'], data: [0,0,0,0,0,0]})|json_encode|raw }};
            
            try {
                chartInstances.salesTrend = new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: monthlySales.labels || ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [{
                            label: 'Sales (₱)',
                            data: monthlySales.data || [0, 0, 0, 0, 0, 0],
                            borderColor: '#007bff',
                            backgroundColor: 'rgba(0, 123, 255, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return '₱' + context.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return '₱' + value.toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            } catch (e) {
                console.error('Error creating sales chart:', e);
            }
        }

        const distributionCtx = document.getElementById('productDistributionChart');
        if (distributionCtx) {
            const productCategories = {{ productCategories|default({labels: ['No Data'], data: [1]})|json_encode|raw }};
            const colors = ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FFCD56'];
            
            try {
                chartInstances.productDistribution = new Chart(distributionCtx, {
                    type: 'doughnut',
                    data: {
                        labels: productCategories.labels || ['No Data'],
                        datasets: [{
                            data: productCategories.data || [1],
                            backgroundColor: colors.slice(0, (productCategories.labels || ['No Data']).length),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { position: 'right', labels: { padding: 20, usePointStyle: true, font: { size: 11 } } }
                        }
                    }
                });
            } catch (e) {
                console.error('Error creating distribution chart:', e);
            }
        }

        const stockCtx = document.getElementById('stockGaugeChart');
        if (stockCtx) {
            const stockLevels = {{ stockLevels|default({data: [0,0,0]})|json_encode|raw }};
            
            try {
                chartInstances.stockGauge = new Chart(stockCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Low Stock (<10)', 'Medium Stock (10-50)', 'Good Stock (>50)'],
                        datasets: [{
                            label: 'Number of Products',
                            data: stockLevels.data || [0, 0, 0],
                            backgroundColor: ['rgba(220, 53, 69, 0.7)', 'rgba(255, 193, 7, 0.7)', 'rgba(40, 167, 69, 0.7)'],
                            borderColor: ['rgba(220, 53, 69, 1)', 'rgba(255, 193, 7, 1)', 'rgba(40, 167, 69, 1)'],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'Number of Products' },
                                ticks: { stepSize: 1, precision: 0 }
                            }
                        }
                    }
                });
            } catch (e) {
                console.error('Error creating stock chart:', e);
            }
        }
        
        lastHeartbeat = Date.now();
    }, 100);
}

// Initialize dropdown functionality
function initializeDropdown() {
    if (dropdownInitialized) {
        return;
    }
    
    const profileHeader = document.getElementById('profileHeader');
    const profileDropdown = document.getElementById('profileDropdown');
    const changePicBtn = document.getElementById('changeProfilePicBtn');
    
    if (profileHeader && profileDropdown) {
        const newHeader = profileHeader.cloneNode(true);
        profileHeader.parentNode.replaceChild(newHeader, profileHeader);
        const newProfileHeader = document.getElementById('profileHeader');
        
        newProfileHeader.addEventListener('click', function(e) {
            e.stopPropagation();
            this.classList.toggle('active');
            const dropdown = document.getElementById('profileDropdown');
            if (dropdown) dropdown.classList.toggle('show');
        });
        
        document.addEventListener('click', function(e) {
            const header = document.getElementById('profileHeader');
            const dropdown = document.getElementById('profileDropdown');
            if (header && dropdown && !header.contains(e.target) && !dropdown.contains(e.target)) {
                header.classList.remove('active');
                dropdown.classList.remove('show');
            }
        });
        
        dropdownInitialized = true;
    }
    
    if (changePicBtn) {
        const newChangeBtn = changePicBtn.cloneNode(true);
        changePicBtn.parentNode.replaceChild(newChangeBtn, changePicBtn);
        const newChangePicBtn = document.getElementById('changeProfilePicBtn');
        if (newChangePicBtn) {
            newChangePicBtn.addEventListener('click', function(e) {
                e.preventDefault();
                showUploadModal();
            });
        }
    }
}

// Mobile sidebar initialization
let sidebarInitialized = false;

function initMobileSidebar() {
    if (sidebarInitialized) return;
    
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    
    if (!menuToggle || !sidebar) return;
    
    function openSidebar() {
        sidebar.classList.add('mobile-open');
        if (overlay) overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    
    function closeSidebar() {
        sidebar.classList.remove('mobile-open');
        if (overlay) overlay.classList.remove('active');
        document.body.style.overflow = '';
    }
    
    const newToggle = menuToggle.cloneNode(true);
    menuToggle.parentNode.replaceChild(newToggle, menuToggle);
    const newMenuToggle = document.getElementById('menuToggle');
    
    newMenuToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        const sidebarEl = document.getElementById('sidebar');
        if (sidebarEl.classList.contains('mobile-open')) {
            closeSidebar();
        } else {
            openSidebar();
        }
    });
    
    if (overlay) {
        const newOverlay = overlay.cloneNode(true);
        overlay.parentNode.replaceChild(newOverlay, overlay);
        const newOverlayEl = document.getElementById('sidebarOverlay');
        newOverlayEl.addEventListener('click', closeSidebar);
    }
    
    document.addEventListener('click', function(e) {
        const currentSidebar = document.getElementById('sidebar');
        const currentMenuToggle = document.getElementById('menuToggle');
        if (window.innerWidth <= 768 && currentSidebar && currentSidebar.classList.contains('mobile-open')) {
            if (!currentSidebar.contains(e.target) && !currentMenuToggle.contains(e.target)) {
                closeSidebar();
            }
        }
    });
    
    window.addEventListener('resize', function() {
        const currentSidebar = document.getElementById('sidebar');
        if (window.innerWidth > 768 && currentSidebar && currentSidebar.classList.contains('mobile-open')) {
            closeSidebar();
        }
    });
    
    sidebarInitialized = true;
}

