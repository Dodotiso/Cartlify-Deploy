function initializeDashboard() {
    initializeDropdown();
    setupVisibilityDetection();
    startHeartbeat();
    
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
    pollingInterval = setInterval(() => fetchRealtimeUpdates(false), pollingFrequency);
    
    const toggleBtn = document.getElementById('toggleRefresh');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', toggleAutoRefresh);
    }
    
    const manualBtn = document.getElementById('manualRefreshBtn');
    if (manualBtn) {
