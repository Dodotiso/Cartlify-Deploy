<!-- Add Chart.js and Font Awesome -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
// ============================================
// NOTIFICATION SYSTEM
// ============================================
let notifications = [];

function loadNotifications() {
    const saved = localStorage.getItem('order_notifications');
    notifications = saved ? JSON.parse(saved) : [];
    updateNotificationUI();
    updateNotificationBadge();
}

function saveNotifications() {
    localStorage.setItem('order_notifications', JSON.stringify(notifications));
    updateNotificationUI();
    updateNotificationBadge();
}

function updateNotificationBadge() {
    const unreadCount = notifications.filter(n => !n.read).length;
    const badge = document.getElementById('notificationBadge');
    if (badge) { 
        if (unreadCount > 0) { 
            badge.classList.add('show'); 
            badge.textContent = unreadCount > 99 ? '99+' : unreadCount; 
        } else { 
            badge.classList.remove('show'); 
        } 
    }
}

function markAllNotificationsAsRead() {
    if (notifications.length > 0) {
        let hasUnread = notifications.some(n => !n.read);
        if (hasUnread) {
            notifications.forEach(n => n.read = true);
            saveNotifications();
            updateNotificationBadge();
        }
    }
}

function markAllNotificationsAsReadBeforeRedirect() {
    markAllNotificationsAsRead();
    window.location.href = '{{ path('app_notifications_index') }}';
}

function updateNotificationUI() {
    const list = document.getElementById('notificationList');
    if (!list) return;
    
    if (notifications.length === 0) { 
        list.innerHTML = '<div style="padding:20px;text-align:center;color:#64748b;"><i class="fas fa-bell-slash"></i> No notifications</div>'; 
    } else { 
        const recentNotifications = notifications.slice(0, 5);
        list.innerHTML = recentNotifications.map(n => `
            <div class="notification-item ${n.read ? '' : 'unread'}" onclick="markNotificationAsRead(${n.id})">
                <div class="notification-title">${n.title}</div>
                <div class="notification-message">${n.message}</div>
                <div class="notification-time">${formatTimeAgo(n.timestamp)}</div>
            </div>
        `).join('');
        
        if (notifications.length > 5) {
            list.innerHTML += '<div style="padding:10px;text-align:center;"><a href="#" onclick="markAllNotificationsAsReadBeforeRedirect(); return false;" style="color:#3b82f6;text-decoration:none;font-size:13px;font-weight:500;">View all ' + notifications.length + ' notifications →</a></div>';
        }
    }
}

function markNotificationAsRead(id) { 
    const notification = notifications.find(n => n.id === id); 
    if (notification) { 
        notification.read = true; 
        saveNotifications(); 
    } 
}

function clearAllNotifications() { 
    if (confirm('Clear all notifications?')) { 
        notifications = []; 
        saveNotifications(); 
        showToast('All notifications cleared', 'info'); 
    } 
}

function formatTimeAgo(timestamp) { 
    const date = new Date(timestamp), now = new Date(), mins = Math.floor((now - date) / 60000), hours = Math.floor(mins / 60), days = Math.floor(hours / 24); 
    if (mins < 1) return 'Just now'; 
    if (mins < 60) return `${mins} min ago`; 
    if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`; 
    return `${days} day${days > 1 ? 's' : ''} ago`; 
}

function toggleNotificationDropdown() { 
    const dropdown = document.getElementById('notificationDropdown');
    if (dropdown) {
        markAllNotificationsAsRead();
        dropdown.classList.toggle('show');
    }
}

// ============================================
// BADGE UPDATE FUNCTIONS
// ============================================
function updateCartBadge() {
    fetch('/cart/count')
        .then(res => res.json())
        .then(data => {
            const badge = document.getElementById('cartBadge');
            if (badge) {
                if (data.count > 0) {
                    badge.textContent = data.count > 9 ? '9+' : data.count;
                    badge.classList.add('show');
                } else {
                    badge.classList.remove('show');
                }
            }
        })
        .catch(e => console.log('Cart update error:', e));
}

function updateTrackerBadge() {
    fetch('{{ path('app_new_orders_count') }}')
        .then(res => res.json())
        .then(data => {
            const badge = document.getElementById('trackerBadge');
            if (badge) {
                if (data.count > 0) {
                    badge.textContent = data.count > 9 ? '9+' : data.count;
                    badge.classList.add('show');
                } else {
                    badge.classList.remove('show');
                }
            }
        })
        .catch(e => console.log('Tracker update error:', e));
}

// ============================================
// TOAST NOTIFICATION SYSTEM
// ============================================
function showToast(message, type = 'success') {
    let container = document.getElementById('toastContainer');
    if (!container) {
        container = document.createElement('div');
        container.id = 'toastContainer';
        container.className = 'toast-container';
        document.body.appendChild(container);
    }
    
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    
    let icon = '';
    if (type === 'success') icon = '✓';
    if (type === 'error') icon = '✗';
    if (type === 'warning') icon = '⚠';
    if (type === 'info') icon = 'ℹ';
    
    toast.innerHTML = `
        <div class="toast-icon">${icon}</div>
        <div class="toast-content">${message}</div>
        <div class="toast-progress"></div>
    `;
    
    container.appendChild(toast);
    
    setTimeout(() => {
        toast.style.animation = 'slideOutRight 0.3s ease';
        setTimeout(() => toast.remove(), 300);
    }, 5000);
}

// ============================================
// PROFILE DROPDOWN FUNCTIONS
// ============================================
function toggleProfileDropdown() {
    const dropdown = document.getElementById('profileDropdown');
    const header = document.getElementById('profileHeader');
    if (dropdown && header) {
        dropdown.classList.toggle('show');
        header.classList.toggle('active');
    }
}

// Close dropdowns when clicking outside
document.addEventListener('click', function(event) {
    const notificationDropdown = document.getElementById('notificationDropdown');
    const notificationIcon = document.getElementById('notificationIcon');
    if (notificationDropdown && notificationIcon && !notificationIcon.contains(event.target) && !notificationDropdown.contains(event.target)) {
        notificationDropdown.classList.remove('show');
    }
    
    const profileDropdown = document.getElementById('profileDropdown');
    const profileHeader = document.getElementById('profileHeader');
    if (profileDropdown && profileHeader && !profileHeader.contains(event.target) && !profileDropdown.contains(event.target)) {
        profileDropdown.classList.remove('show');
        profileHeader.classList.remove('active');
    }
});

// ============================================
// REAL-TIME DASHBOARD (ADMIN ONLY)
// ============================================

let chartInstances = {};
let dropdownInitialized = false;
let pollingInterval = null;
let isPolling = true;
let pollingFrequency = 5000;
let previousData = {};
let isRefreshing = false;

function updateLastUpdateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString();
    const updateSpan = document.getElementById('lastUpdateTime');
    if (updateSpan) {
        updateSpan.innerHTML = `Last updated: ${timeString}`;
    }
}

function animateCard(cardElement) {
    if (cardElement) {
        cardElement.classList.add('card-updated');
        setTimeout(() => {
            cardElement.classList.remove('card-updated');
        }, 600);
    }
}

function updateMetrics(data) {
    let hasUpdates = false;
    
    if (data.totalProducts !== undefined && previousData.totalProducts !== data.totalProducts) {
        const element = document.getElementById('totalProductsValue');
        if (element) {
            element.innerText = data.totalProducts;
            animateCard(document.querySelector('[data-metric="totalProducts"]'));
            hasUpdates = true;
        }
    }
    
    if (data.totalMarketplaceProducts !== undefined && previousData.totalMarketplaceProducts !== data.totalMarketplaceProducts) {
        const element = document.getElementById('totalMarketplaceProductsValue');
        if (element) {
            element.innerText = data.totalMarketplaceProducts;
            animateCard(document.querySelector('[data-metric="totalMarketplaceProducts"]'));
            hasUpdates = true;
        }
    }
    
    if (data.totalOrders !== undefined && previousData.totalOrders !== data.totalOrders) {
        const element = document.getElementById('totalOrdersValue');
        if (element) {
            element.innerText = data.totalOrders;
            animateCard(document.querySelector('[data-metric="totalOrders"]'));
            hasUpdates = true;
        }
    }
    
    if (data.totalIncome !== undefined && previousData.totalIncome !== data.totalIncome) {
        const element = document.getElementById('totalIncomeValue');
        if (element) {
            element.innerText = `₱${data.totalIncome.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            animateCard(document.querySelector('[data-metric="totalIncome"]'));
            hasUpdates = true;
        }
    }
    
    if (data.totalUsers !== undefined && previousData.totalUsers !== data.totalUsers) {
        const element = document.getElementById('totalUsersValue');
        if (element) {
            element.innerText = data.totalUsers;
            animateCard(document.querySelector('[data-metric="totalUsers"]'));
            hasUpdates = true;
        }
    }
    
    if (data.totalStaff !== undefined && previousData.totalStaff !== data.totalStaff) {
        const element = document.getElementById('totalStaffValue');
        if (element) {
            element.innerText = data.totalStaff;
            animateCard(document.querySelector('[data-metric="totalStaff"]'));
            hasUpdates = true;
        }
    }
    
    if (data.totalActivityLogs !== undefined && previousData.totalActivityLogs !== data.totalActivityLogs) {
        const element = document.getElementById('totalActivityLogsValue');
        if (element) {
            element.innerText = data.totalActivityLogs;
            animateCard(document.querySelector('[data-metric="totalActivityLogs"]'));
            hasUpdates = true;
        }
    }
    
    if (data.todayOrders !== undefined && previousData.todayOrders !== data.todayOrders) {
        const element = document.getElementById('todayOrdersValue');
        if (element) {
            element.innerText = data.todayOrders;
            hasUpdates = true;
        }
    }
    
    if (data.todaySales !== undefined && previousData.todaySales !== data.todaySales) {
        const element = document.getElementById('todaySalesValue');
        if (element) {
            element.innerText = `₱${data.todaySales.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            hasUpdates = true;
        }
    }
    
    if (data.avgOrderValue !== undefined && previousData.avgOrderValue !== data.avgOrderValue) {
        const element = document.getElementById('avgOrderValueValue');
        if (element) {
            element.innerText = `₱${data.avgOrderValue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            hasUpdates = true;
        }
    }
    
    if (data.lowStockCount !== undefined && previousData.lowStockCount !== data.lowStockCount) {
        const element = document.getElementById('lowStockCountValue');
        if (element) {
            element.innerText = data.lowStockCount;
            if (data.lowStockCount > 0 && data.lowStockCount > (previousData.lowStockCount || 0)) {
                showToast(`⚠️ Warning: ${data.lowStockCount} items are low on stock!`, 'warning');
            }
            hasUpdates = true;
        }
    }
    
    if (data.insightMessage && previousData.insightMessage !== data.insightMessage) {
        const insightElement = document.getElementById('insightMessage');
        if (insightElement) {
            insightElement.textContent = data.insightMessage;
            hasUpdates = true;
        }
    }
    
    previousData = {...data};
    
    if (hasUpdates) {
        updateLastUpdateTime();
    }
    
    return hasUpdates;
}

function updateRecentOrders(orders) {
    const tbody = document.getElementById('recentOrdersTable');
    if (!tbody) return;
    
    const currentOrders = Array.from(tbody.querySelectorAll('tr[data-order-id]')).map(row => row.dataset.orderId);
    const newOrderIds = orders.map(order => order.id.toString());
    
    const hasNewOrders = newOrderIds.some(id => !currentOrders.includes(id));
    
    if (hasNewOrders) {
        const rows = tbody.querySelectorAll('tr');
        rows.forEach(row => {
            if (row.id !== 'noOrdersRow') {
                row.remove();
            }
        });
        
        orders.forEach(order => {
            const newRow = document.createElement('tr');
            newRow.style.borderBottom = '1px solid #f1f5f9';
            newRow.className = 'new-order-row';
            newRow.setAttribute('data-order-id', order.id);
            
            const productName = order.productName || 'Product';
            const truncatedName = productName.length > 20 ? productName.substring(0, 20) + '...' : productName;
            
            newRow.innerHTML = `
                <td style="padding: 14px; font-weight: 600;">#${order.id}</td>
                <td style="padding: 14px;">${truncatedName}</td>
                <td style="padding: 14px;">${order.quantity}</td>
                <td style="padding: 14px; font-weight: 600; color: #10b981;">₱${parseFloat(order.totalAmount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                <td style="padding: 14px; color: #64748b;">${order.createdAt}</td>
            `;
            
            tbody.appendChild(newRow);
            
            showToast(`🛒 New order #${order.id} received! Amount: ₱${parseFloat(order.totalAmount).toLocaleString()}`, 'success');
        });
        
        setTimeout(() => {
            tbody.querySelectorAll('.new-order-row').forEach(row => {
                row.classList.remove('new-order-row');
            });
        }, 2000);
    }
}

function updateChartData(chartId, newData) {
    const chart = chartInstances[chartId];
    if (chart && newData) {
        try {
            let needsUpdate = false;
            
            if (newData.labels && JSON.stringify(chart.data.labels) !== JSON.stringify(newData.labels)) {
                chart.data.labels = newData.labels;
                needsUpdate = true;
            }
            
            if (newData.data && JSON.stringify(chart.data.datasets[0].data) !== JSON.stringify(newData.data)) {
                chart.data.datasets[0].data = newData.data;
                needsUpdate = true;
            }
            
            if (needsUpdate) {
                chart.update('none');
            }
        } catch (e) {
            console.error(`Error updating chart ${chartId}:`, e);
        }
    }
}

async function fetchRealtimeUpdates(forceRefresh = false) {
    if ((!isPolling && !forceRefresh) || isRefreshing) return;
    
    isRefreshing = true;
    
    try {
        const timestamp = Date.now();
        const response = await fetch(`/dashboard/realtime-updates?_=${timestamp}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Cache-Control': 'no-cache, no-store, must-revalidate'
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            
            if (data.hasUpdates || forceRefresh) {
                if (data.metrics) updateMetrics(data.metrics);
                if (data.salesTrend) updateChartData('salesTrend', data.salesTrend);
                if (data.productCategories) updateChartData('productDistribution', data.productCategories);
                if (data.stockLevels) updateChartData('stockGauge', data.stockLevels);
                if (data.recentOrders) updateRecentOrders(data.recentOrders);
            }
        }
    } catch (error) {
        console.error('Error fetching real-time updates:', error);
    } finally {
        isRefreshing = false;
    }
}

function renderCharts() {
    if (typeof Chart === 'undefined') {
        setTimeout(renderCharts, 100);
        return;
    }
    
    Object.keys(chartInstances).forEach(key => {
        if (chartInstances[key]) {
            try {
                chartInstances[key].destroy();
            } catch (e) {
                console.error('Error destroying chart:', e);
            }
        }
    });
    chartInstances = {};
    
    setTimeout(() => {
        const salesCtx = document.getElementById('salesTrendChart');
        if (salesCtx) {
            const monthlySales = {{ monthlySales|default({labels: ['Jan','Feb','Mar','Apr','May','Jun'], data: [0,0,0,0,0,0]})|json_encode|raw }};
            
            try {
                chartInstances.salesTrend = new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: monthlySales.labels || ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [{
                            label: 'Sales (₱)',
                            data: monthlySales.data || [0, 0, 0, 0, 0, 0],
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return '₱' + context.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return '₱' + value.toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            } catch (e) {
                console.error('Error creating sales chart:', e);
            }
        }

        const distributionCtx = document.getElementById('productDistributionChart');
        if (distributionCtx) {
            const productCategories = {{ productCategories|default({labels: ['No Data'], data: [1]})|json_encode|raw }};
            const colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#f97316', '#64748b', '#ec4899', '#14b8a6'];
            
            try {
                chartInstances.productDistribution = new Chart(distributionCtx, {
                    type: 'doughnut',
                    data: {
                        labels: productCategories.labels || ['No Data'],
                        datasets: [{
                            data: productCategories.data || [1],
                            backgroundColor: colors.slice(0, (productCategories.labels || ['No Data']).length),
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { position: 'right', labels: { padding: 20, usePointStyle: true, font: { size: 12 } } }
                        }
                    }
                });
            } catch (e) {
                console.error('Error creating distribution chart:', e);
            }
        }

        const stockCtx = document.getElementById('stockGaugeChart');
        if (stockCtx) {
            const stockLevels = {{ stockLevels|default({data: [0,0,0]})|json_encode|raw }};
            
            try {
                chartInstances.stockGauge = new Chart(stockCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Low Stock (<10)', 'Medium Stock (10-50)', 'Good Stock (>50)'],
                        datasets: [{
                            label: 'Number of Products',
                            data: stockLevels.data || [0, 0, 0],
                            backgroundColor: ['rgba(239, 68, 68, 0.8)', 'rgba(245, 158, 11, 0.8)', 'rgba(16, 185, 129, 0.8)'],
                            borderColor: ['rgba(239, 68, 68, 1)', 'rgba(245, 158, 11, 1)', 'rgba(16, 185, 129, 1)'],
                            borderWidth: 2,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'Number of Products', font: { weight: '600' } },
                                ticks: { stepSize: 1, precision: 0 }
                            }
                        }
                    }
                });
            } catch (e) {
                console.error('Error creating stock chart:', e);
            }
        }
    }, 100);
}

// ============================================
// INITIALIZATION
// ============================================
let sidebarInitialized = false;

function initializeDropdown() {
    if (dropdownInitialized) return;
    
    const profileHeader = document.getElementById('profileHeader');
    const profileDropdown = document.getElementById('profileDropdown');
    const changePicBtn = document.getElementById('changeProfilePicBtn');
    
    if (profileHeader && profileDropdown) {
        profileHeader.addEventListener('click', function(e) {
            e.stopPropagation();
            toggleProfileDropdown();
        });
        dropdownInitialized = true;
    }
    
    if (changePicBtn) {
        changePicBtn.addEventListener('click', function(e) {
            e.preventDefault();
            showUploadModal();
        });
    }
}

function initMobileSidebar() {
    if (sidebarInitialized) return;
    
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    
    if (!menuToggle || !sidebar) return;
    
    function openSidebar() {
        sidebar.classList.add('mobile-open');
        if (overlay) overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    
    function closeSidebar() {
        sidebar.classList.remove('mobile-open');
        if (overlay) overlay.classList.remove('active');
        document.body.style.overflow = '';
    }
    
    menuToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        if (sidebar.classList.contains('mobile-open')) {
            closeSidebar();
        } else {
            openSidebar();
        }
    });
    
    if (overlay) {
        overlay.addEventListener('click', closeSidebar);
    }
    
    document.addEventListener('click', function(e) {
        if (window.innerWidth <= 768 && sidebar.classList.contains('mobile-open')) {
            if (!sidebar.contains(e.target) && !menuToggle.contains(e.target)) {
                closeSidebar();
            }
        }
    });
    
    window.addEventListener('resize', function() {
        if (window.innerWidth > 768 && sidebar.classList.contains('mobile-open')) {
            closeSidebar();
        }
    });
    
    sidebarInitialized = true;
}

function initFlashMessages() {
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            showToast('{{ message|escape('js') }}', '{{ label }}');
        {% endfor %}
    {% endfor %}
}

function showUploadModal() {
    let existing = document.getElementById('uploadModal');
    if (existing) existing.remove();
    
    let modal = document.createElement('div');
    modal.id = 'uploadModal';
    modal.className = 'modal';
    modal.innerHTML = `
        <div class="modal-content">
            <div class="modal-header">
                <h3>Change Profile Picture</h3>
                <button class="close-modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Click to upload or drag and drop</p>
                    <small>PNG, JPG, GIF, WebP up to 2MB</small>
                </div>
                <div class="image-preview" id="imagePreview" style="display: none;">
                    <img src="" alt="Preview">
                </div>
                <div class="upload-progress" id="uploadProgress" style="display: none;">
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                    <span id="progressText">0%</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary-modal" id="cancelUpload">Cancel</button>
                <button class="btn-primary-modal" id="saveUpload" disabled>Upload</button>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    setTimeout(() => modal.classList.add('show'), 10);
    
    const uploadArea = document.getElementById('uploadArea');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = imagePreview.querySelector('img');
    const saveBtn = document.getElementById('saveUpload');
    const cancelBtn = document.getElementById('cancelUpload');
    const closeBtn = modal.querySelector('.close-modal');
    const progressContainer = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');
    
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp';
    fileInput.style.display = 'none';
    modal.appendChild(fileInput);
    
    uploadArea.addEventListener('click', () => fileInput.click());
    
    fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            if (!['image/jpeg','image/png','image/gif','image/webp'].includes(file.type)) {
                showToast('Invalid image type', 'error');
                return;
            }
            if (file.size > 2 * 1024 * 1024) {
                showToast('File too large (max 2MB)', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                imagePreview.style.display = 'block';
                uploadArea.style.display = 'none';
                saveBtn.disabled = false;
            };
            reader.readAsDataURL(file);
        }
    });
    
    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = '#3b82f6';
    });
    
    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            if (file.size > 2 * 1024 * 1024) {
                showToast('File too large', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                imagePreview.style.display = 'block';
                uploadArea.style.display = 'none';
                saveBtn.disabled = false;
                const dt = new DataTransfer();
                dt.items.add(file);
                fileInput.files = dt.files;
            };
            reader.readAsDataURL(file);
        }
    });
    
    saveBtn.addEventListener('click', function() {
        if (fileInput.files.length > 0) {
            uploadProfilePicture(fileInput.files[0]);
        }
    });
    
    function uploadProfilePicture(file) {
        const formData = new FormData();
        formData.append('profile_picture', file);
        
        progressContainer.style.display = 'block';
        saveBtn.disabled = true;
        
        const xhr = new XMLHttpRequest();
        
        xhr.upload.addEventListener('progress', function(e) {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressFill.style.width = percent + '%';
                progressText.textContent = percent + '%';
            }
        });
        
        xhr.addEventListener('load', function() {
            if (xhr.status === 200) {
                try {
                    const response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        updateProfilePicture(response.imageUrl);
                        showToast('Profile picture updated!', 'success');
                        closeUploadModal();
                    } else {
                        showToast(response.message || 'Upload failed', 'error');
                        resetUpload();
                    }
                } catch(e) {
                    showToast('Invalid response', 'error');
                    resetUpload();
                }
            } else {
                showToast('Upload failed', 'error');
                resetUpload();
            }
        });
        
        xhr.addEventListener('error', function() {
            showToast('Network error', 'error');
            resetUpload();
        });
        
        xhr.open('POST', '/dashboard/upload-profile-picture', true);
        xhr.send(formData);
    }
    
    function resetUpload() {
        progressContainer.style.display = 'none';
        progressFill.style.width = '0%';
        progressText.textContent = '0%';
        saveBtn.disabled = false;
    }
    
    function updateProfilePicture(imageUrl) {
        const avatar = document.querySelector('.profile-avatar');
        avatar.innerHTML = `<img src="${imageUrl}?t=${Date.now()}" alt="{{ app.user.username }}" style="border-radius: 50%;">`;
    }
    
    function closeUploadModal() {
        modal.classList.remove('show');
        setTimeout(() => modal.remove(), 300);
    }
    
    cancelBtn.addEventListener('click', closeUploadModal);
    closeBtn.addEventListener('click', closeUploadModal);
    modal.addEventListener('click', function(e) {
        if (e.target === modal) closeUploadModal();
    });
}

function initAll() {
    initMobileSidebar();
    initFlashMessages();
    initializeDropdown();
    loadNotifications();
    
    // Only initialize admin features if user is admin
    {% if is_granted('ROLE_ADMIN') %}
    renderCharts();
    
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
    pollingInterval = setInterval(() => fetchRealtimeUpdates(false), pollingFrequency);
    
    previousData = {
        totalProducts: parseInt(document.getElementById('totalProductsValue')?.innerText || '0'),
        totalMarketplaceProducts: parseInt(document.getElementById('totalMarketplaceProductsValue')?.innerText || '0'),
        totalOrders: parseInt(document.getElementById('totalOrdersValue')?.innerText || '0'),
        totalIncome: parseFloat(document.getElementById('totalIncomeValue')?.innerText.replace('₱', '').replace(/,/g, '') || '0'),
        totalUsers: parseInt(document.getElementById('totalUsersValue')?.innerText || '0'),
        totalStaff: parseInt(document.getElementById('totalStaffValue')?.innerText || '0'),
        totalActivityLogs: parseInt(document.getElementById('totalActivityLogsValue')?.innerText || '0'),
        todayOrders: parseInt(document.getElementById('todayOrdersValue')?.innerText || '0'),
        todaySales: parseFloat(document.getElementById('todaySalesValue')?.innerText.replace('₱', '').replace(/,/g, '') || '0'),
        avgOrderValue: parseFloat(document.getElementById('avgOrderValueValue')?.innerText.replace('₱', '').replace(/,/g, '') || '0'),
        lowStockCount: parseInt(document.getElementById('lowStockCountValue')?.innerText || '0')
    };
    
    updateLastUpdateTime();
    setTimeout(() => fetchRealtimeUpdates(true), 500);
    {% endif %}
    
    updateCartBadge();
    setInterval(updateCartBadge, 5000);
    updateTrackerBadge();
}

document.addEventListener('DOMContentLoaded', function() {
    setTimeout(initAll, 100);
});

document.addEventListener('turbo:load', function() {
    sidebarInitialized = false;
    dropdownInitialized = false;
    chartInstances = {};
    
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
    
    setTimeout(initAll, 100);
});

let resizeTimeout;
window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
        Object.values(chartInstances).forEach(chart => {
            if (chart && chart.resize) {
                chart.resize();
            }
        });
    }, 100);
});

window.addEventListener('beforeunload', function() {
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
});
</script>
{% endblock %}