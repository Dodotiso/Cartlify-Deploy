function showUploadModal() {
    let existing = document.getElementById('uploadModal');
    if (existing) existing.remove();
    
    let modal = document.createElement('div');
    modal.id = 'uploadModal';
    modal.className = 'modal';
    modal.innerHTML = `
        <div class="modal-content">
            <div class="modal-header">
                <h3>Change Profile Picture</h3>
                <button class="close-modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Click to upload or drag and drop</p>
                    <small>PNG, JPG, GIF, WebP up to 2MB</small>
                </div>
                <div class="image-preview" id="imagePreview" style="display: none;">
                    <img src="" alt="Preview">
                </div>
                <div class="upload-progress" id="uploadProgress" style="display: none;">
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                    <span id="progressText">0%</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary-modal" id="cancelUpload">Cancel</button>
                <button class="btn-primary-modal" id="saveUpload" disabled>Upload</button>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    setTimeout(() => modal.classList.add('show'), 10);
    
    const uploadArea = document.getElementById('uploadArea');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = imagePreview.querySelector('img');
    const saveBtn = document.getElementById('saveUpload');
    const cancelBtn = document.getElementById('cancelUpload');
    const closeBtn = modal.querySelector('.close-modal');
    const progressContainer = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');
    
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp';
    fileInput.style.display = 'none';
    modal.appendChild(fileInput);
    
    uploadArea.addEventListener('click', () => fileInput.click());
    
    fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            if (!['image/jpeg','image/png','image/gif','image/webp'].includes(file.type)) {
                showToast('Invalid image type', 'error');
                return;
            }
            if (file.size > 2 * 1024 * 1024) {
                showToast('File too large (max 2MB)', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                imagePreview.style.display = 'block';
                uploadArea.style.display = 'none';
                saveBtn.disabled = false;
            };
            reader.readAsDataURL(file);
        }
    });
    
    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = '#007bff';
    });
    
    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            if (file.size > 2 * 1024 * 1024) {
                showToast('File too large', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                imagePreview.style.display = 'block';
                uploadArea.style.display = 'none';
                saveBtn.disabled = false;
                const dt = new DataTransfer();
                dt.items.add(file);
                fileInput.files = dt.files;
            };
            reader.readAsDataURL(file);
        }
    });
    
    saveBtn.addEventListener('click', function() {
        if (fileInput.files.length > 0) {
            uploadProfilePicture(fileInput.files[0]);
        }
    });
    
    function uploadProfilePicture(file) {
        const formData = new FormData();
        formData.append('profile_picture', file);
        
        progressContainer.style.display = 'block';
        saveBtn.disabled = true;
        
        const xhr = new XMLHttpRequest();
        
        xhr.upload.addEventListener('progress', function(e) {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressFill.style.width = percent + '%';
                progressText.textContent = percent + '%';
            }
        });
        
        xhr.addEventListener('load', function() {
            if (xhr.status === 200) {
                try {
                    const response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        updateProfilePicture(response.imageUrl);
                        showToast('Profile picture updated!', 'success');
                        closeUploadModal();
                    } else {
                        showToast(response.message || 'Upload failed', 'error');
                        resetUpload();
                    }
                } catch(e) {
                    showToast('Invalid response', 'error');
                    resetUpload();
                }
            } else {
                showToast('Upload failed', 'error');
                resetUpload();
            }
        });
        
        xhr.addEventListener('error', function() {
            showToast('Network error', 'error');
            resetUpload();
        });
        
        xhr.open('POST', '/dashboard/upload-profile-picture', true);
        xhr.send(formData);
    }
    
    function resetUpload() {
        progressContainer.style.display = 'none';
        progressFill.style.width = '0%';
        progressText.textContent = '0%';
        saveBtn.disabled = false;
    }
    
    function updateProfilePicture(imageUrl) {
        const avatar = document.querySelector('.profile-avatar');
        avatar.innerHTML = `<img src="${imageUrl}?t=${Date.now()}" alt="{{ app.user.username }}">`;
    }
    
    function closeUploadModal() {
        modal.classList.remove('show');
        setTimeout(() => modal.remove(), 300);
    }
    
    cancelBtn.addEventListener('click', closeUploadModal);
    closeBtn.addEventListener('click', closeUploadModal);
    modal.addEventListener('click', function(e) {
        if (e.target === modal) closeUploadModal();
    });
}

function initAll() {
    initMobileSidebar();
    initFlashMessages();
    initializeDropdown();
    loadNotifications();
    renderCharts();
    
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
    pollingInterval = setInterval(() => fetchRealtimeUpdates(false), pollingFrequency);
    
    updateCartBadge();
    setInterval(updateCartBadge, 5000);
    updateTrackerBadge();
    
    previousData = {
        totalProducts: parseInt(document.getElementById('totalProductsValue')?.innerText || '0'),
        totalOrders: parseInt(document.getElementById('totalOrdersValue')?.innerText || '0'),
        totalIncome: parseFloat(document.getElementById('totalIncomeValue')?.innerText.replace('₱', '').replace(/,/g, '') || '0'),
        totalUsers: parseInt(document.getElementById('totalUsersValue')?.innerText || '0'),
        totalAdmins: parseInt(document.getElementById('totalAdminsValue')?.innerText || '0'),
        totalStaff: parseInt(document.getElementById('totalStaffValue')?.innerText || '0'),
        todayOrders: parseInt(document.getElementById('todayOrdersValue')?.innerText || '0'),
        todaySales: parseFloat(document.getElementById('todaySalesValue')?.innerText.replace('₱', '').replace(/,/g, '') || '0'),
        avgOrderValue: parseFloat(document.getElementById('avgOrderValueValue')?.innerText.replace('₱', '').replace(/,/g, '') || '0'),
        lowStockCount: parseInt(document.getElementById('lowStockCountValue')?.innerText || '0')
    };
    
    updateLastUpdateTime();
    setTimeout(() => fetchRealtimeUpdates(true), 500);
}

document.addEventListener('DOMContentLoaded', function() {
    setTimeout(initAll, 100);
});

document.addEventListener('turbo:load', function() {
    sidebarInitialized = false;
    dropdownInitialized = false;
    chartInstances = {};
    
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
    
    setTimeout(initAll, 100);
});

let resizeTimeout;
window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
        Object.values(chartInstances).forEach(chart => {
            if (chart && chart.resize) {
                chart.resize();
            }
        });
    }, 100);
});

window.addEventListener('beforeunload', function() {
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
});
