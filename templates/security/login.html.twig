{% extends 'base.html.twig' %}

{% block title %}Cartlify | Login{% endblock %}

{% block body %}
<style>
:root {
    --primary: #1f2a44;
    --primary-dark: #16203a;
    --primary-light: #2a3a60;
    --accent: #f72585;
    --light: #f8f9fa;
    --dark: #212529;
    --gray: #6c757d;
    --light-gray: #e9ecef;
    --border-radius: 12px;
    --box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
    color: var(--dark);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.login-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1000px;
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--box-shadow);
}

/* Left side - Illustration/Brand */
.login-illustration {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    padding: 40px 35px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: white;
    position: relative;
    overflow: hidden;
}

.login-illustration::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.illustration-content {
    position: relative;
    z-index: 1;
    text-align: center;
}

.brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
}

.logo-wrapper {
    width: 120px;
    height: 120px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
}

.logo-wrapper img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transition: transform 0.3s ease;
}

.logo-wrapper:hover {
    transform: scale(1.05);
    background: rgba(255, 255, 255, 0.25);
}

.logo-wrapper:hover img {
    transform: scale(1.05);
}

.illustration-content h2 {
    font-size: 1.8rem;
    margin-bottom: 16px;
    font-weight: 700;
}

.illustration-content p {
    font-size: 0.95rem;
    opacity: 0.9;
    line-height: 1.5;
    max-width: 280px;
    margin: 0 auto;
}

/* Right side - Form */
.login-form-section {
    padding: 40px 35px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.login-form-section h1 {
    font-size: 1.75rem;
    margin-bottom: 8px;
    color: var(--dark);
    font-weight: 700;
}

.subtitle {
    color: var(--gray);
    margin-bottom: 28px;
    font-size: 0.9rem;
}

.form-group {
    margin-bottom: 18px;
    position: relative;
}

.form-label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    color: var(--dark);
    font-size: 0.85rem;
}

.form-control {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1.5px solid var(--light-gray);
    font-size: 0.9rem;
    transition: var(--transition);
    background: #fafbfc;
}

.form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(31, 42, 68, 0.1);
    background: white;
}

.form-control::placeholder {
    color: #adb5bd;
    font-size: 0.85rem;
}

.input-icon {
    position: absolute;
    right: 12px;
    top: 34px;
    color: var(--gray);
    font-size: 0.9rem;
    pointer-events: none;
}

.remember-forgot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    font-size: 0.85rem;
}

.remember-me {
    display: flex;
    align-items: center;
    gap: 6px;
}

.remember-me input {
    width: 16px;
    height: 16px;
    cursor: pointer;
    margin: 0;
}

.remember-me label {
    color: var(--gray);
    cursor: pointer;
}

.forgot-password {
    color: var(--primary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: var(--transition);
}

.forgot-password:hover {
    color: var(--primary-dark);
    text-decoration: underline;
}

.btn-login {
    width: 100%;
    padding: 12px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    margin-bottom: 20px;
}

.btn-login:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(31, 42, 68, 0.3);
}

.btn-login:active {
    transform: translateY(0);
}

.divider {
    display: flex;
    align-items: center;
    margin: 20px 0;
    color: var(--gray);
    font-size: 0.8rem;
}

.divider::before,
.divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--light-gray);
}

.divider span {
    padding: 0 12px;
}

.social-login {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.social-btn {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    border: 1.5px solid var(--light-gray);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.85rem;
}

.social-btn:hover {
    border-color: var(--primary);
    background: var(--light);
    transform: translateY(-1px);
}

.social-btn.google {
    color: #db4437;
}

.social-btn.github {
    color: #333;
}

.register-link {
    text-align: center;
    margin-top: 20px;
    color: var(--gray);
    font-size: 0.85rem;
}

.register-link a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
}

.register-link a:hover {
    text-decoration: underline;
}

.alert {
    margin-bottom: 20px;
    padding: 12px;
    background: #ffeaea;
    color: #d32f2f;
    border-radius: 8px;
    font-size: 0.85rem;
    border-left: 3px solid #f44336;
    animation: slideIn 0.3s ease-out;
}

.logged-in-notice {
    background: #e8f5e9;
    color: #2e7d32;
    border-left: 3px solid #4caf50;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 0.85rem;
}

.logged-in-notice a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Tablet and up */
@media (min-width: 768px) {
    .login-container {
        flex-direction: row;
        min-height: auto;
        max-width: 900px;
    }
    
    .login-illustration {
        flex: 0.8;
        padding: 45px 30px;
    }
    
    .illustration-content {
        text-align: left;
    }
    
    .brand-logo {
        justify-content: flex-start;
    }
    
    .illustration-content h2 {
        text-align: left;
    }
    
    .illustration-content p {
        text-align: left;
        max-width: 100%;
    }
    
    .login-form-section {
        flex: 1.2;
        padding: 45px 35px;
    }
    
    .login-form-section h1 {
        font-size: 1.8rem;
    }
}

/* Desktop */
@media (min-width: 992px) {
    .login-container {
        max-width: 1000px;
    }
    
    .login-illustration {
        padding: 50px 35px;
    }
    
    .logo-wrapper {
        width: 140px;
        height: 140px;
    }
    
    .logo-wrapper img {
        width: 100px;
        height: 100px;
    }
    
    .illustration-content h2 {
        font-size: 2rem;
    }
    
    .illustration-content p {
        font-size: 0.95rem;
    }
    
    .login-form-section {
        padding: 50px 40px;
    }
    
    .login-form-section h1 {
        font-size: 2rem;
    }
}

/* Mobile */
@media (max-width: 480px) {
    body {
        padding: 16px;
    }
    
    .login-illustration {
        padding: 30px 25px;
    }
    
    .logo-wrapper {
        width: 100px;
        height: 100px;
    }
    
    .logo-wrapper img {
        width: 70px;
        height: 70px;
    }
    
    .illustration-content h2 {
        font-size: 1.5rem;
        margin-bottom: 10px;
    }
    
    .illustration-content p {
        font-size: 0.85rem;
    }
    
    .login-form-section {
        padding: 30px 25px;
    }
    
    .login-form-section h1 {
        font-size: 1.5rem;
    }
    
    .subtitle {
        font-size: 0.85rem;
        margin-bottom: 20px;
    }
    
    .form-group {
        margin-bottom: 15px;
    }
    
    .form-control {
        padding: 8px 12px;
        font-size: 0.85rem;
    }
    
    .input-icon {
        top: 31px;
        font-size: 0.85rem;
    }
    
    .btn-login {
        padding: 10px;
        font-size: 0.9rem;
        margin-bottom: 16px;
    }
    
    .social-btn {
        padding: 8px;
        font-size: 0.8rem;
    }
    
    .remember-forgot {
        font-size: 0.8rem;
        margin-bottom: 16px;
    }
    
    .divider {
        margin: 16px 0;
    }
}

/* Extra small devices */
@media (max-width: 360px) {
    .social-login {
        flex-direction: column;
        gap: 8px;
    }
    
    .login-illustration {
        padding: 25px 20px;
    }
    
    .logo-wrapper {
        width: 80px;
        height: 80px;
    }
    
    .logo-wrapper img {
        width: 55px;
        height: 55px;
    }
    
    .login-form-section {
        padding: 25px 20px;
    }
}

/* Touch devices */
@media (hover: none) and (pointer: coarse) {
    .btn-login,
    .social-btn {
        min-height: 44px;
    }
    
    .form-control {
        font-size: 16px;
    }
}
</style>

<div class="login-container">
    <div class="login-illustration">
        <div class="illustration-content">
            <div class="brand-logo">
                <div class="logo-wrapper">
                    <img src="{{ asset('images/cart1.png') }}" alt="Cartlify">
                </div>
            </div>
            <h2>Welcome Back!</h2>
            <p>Sign in to access your dashboard, manage your inventory, and track your orders.</p>
        </div>
    </div>
    
    <div class="login-form-section">
        {% if error %}
            <div class="alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="logged-in-notice" role="status">
                You are logged in as <strong>{{ app.user.userIdentifier }}</strong>. 
                <a href="{{ path('app_logout') }}">Logout</a> to switch accounts.
            </div>
        {% endif %}

        <h1>Sign In</h1>
        <p class="subtitle">Enter your credentials to access your account</p>

        <form method="post">
            <div class="form-group">
                <label for="inputUsername" class="form-label">Username or Email</label>
                <input type="text"
                       name="username"
                       id="inputUsername"
                       class="form-control"
                       placeholder="Enter your username or email"
                       value="{{ last_username }}"
                       autocomplete="username"
                       required
                       autofocus>
                {# <span class="input-icon" aria-hidden="true">👤</span> #}
            </div>

            <div class="form-group">
                <label for="inputPassword" class="form-label">Password</label>
                <input type="password"
                       name="password"
                       id="inputPassword"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required>
                {# <span class="input-icon" aria-hidden="true">🔒</span> #}
            </div>

            <div class="remember-forgot">
                <div class="remember-me">
                    <input type="checkbox" id="remember" name="_remember_me" value="1">
                    <label for="remember">Remember me</label>
                </div>
                <a href="#" class="forgot-password">Forgot password?</a>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-login">Sign In</button>
        </form>

        <div class="divider"><span>Or continue with</span></div>

        <div class="social-login">
            <button type="button" class="social-btn google">
                <span>Google</span>
            </button>
            <button type="button" class="social-btn github">
                <span>GitHub</span>
            </button>
        </div>

        <div class="register-link">
            Don't have an account? <a href="{{ path('app_register') }}">Register Here</a>
        </div>
    </div>
</div>

<script>
// Form submission feedback
document.querySelector('form')?.addEventListener('submit', function(e) {
    const btn = this.querySelector('.btn-login');
    if (btn) {
        btn.innerHTML = 'Signing In...';
        btn.disabled = true;
    }
});

// Focus management
const inputs = document.querySelectorAll('.form-control');
inputs.forEach(input => {
    input.addEventListener('focus', function() {
        this.parentElement.style.transform = 'translateY(-1px)';
    });
    
    input.addEventListener('blur', function() {
        this.parentElement.style.transform = 'translateY(0)';
    });
});
</script>

{% endblock %}