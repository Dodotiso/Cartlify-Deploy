{% extends 'base.html.twig' %}

{% block title %}Cartlify | Login{% endblock %}

{% block body %}
<style>
:root {
    --primary: #4361ee;
    --primary-dark: #3a56d4;
    --secondary: #7209b7;
    --accent: #f72585;
    --light: #f8f9fa;
    --dark: #212529;
    --gray: #6c757d;
    --light-gray: #e9ecef;
    --border-radius: 16px;
    --box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    color: var(--dark);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    line-height: 1.5;
}

.login-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1200px;
    min-height: auto;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--box-shadow);
    background: white;
    margin: 0 auto;
}

.login-illustration {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: white;
    position: relative;
    overflow: hidden;
    min-height: 300px;
}

.login-illustration::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.illustration-content {
    position: relative;
    z-index: 1;
    text-align: center;
}

.brand-logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: 30px;
    font-size: 1.6rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.1);
    padding: 10px 20px;
    border-radius: 50px;
    backdrop-filter: blur(10px);
}

.brand-logo .logo-icon {
    margin-right: 10px;
    font-size: 1.8rem;
}

.illustration-content h2 {
    font-size: 1.8rem;
    margin-bottom: 16px;
    font-weight: 700;
    line-height: 1.3;
}

.illustration-content p {
    font-size: 1rem;
    opacity: 0.9;
    line-height: 1.5;
    margin-bottom: 16px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

.login-form-section {
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
}

.login-form-section h1 {
    font-size: 1.8rem;
    margin-bottom: 8px;
    color: var(--dark);
    font-weight: 700;
    text-align: center;
}

.subtitle {
    color: var(--gray);
    margin-bottom: 32px;
    font-size: 0.95rem;
    text-align: center;
}

.form-group {
    margin-bottom: 20px;
    position: relative;
    width: 100%;
}

.form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: var(--dark);
    font-size: 0.9rem;
}

.form-control {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 2px solid var(--light-gray);
    font-size: 16px;
    transition: var(--transition);
    background: #fafbfc;
    appearance: none;
    -webkit-appearance: none;
}

.form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    background: white;
}

.form-control::placeholder {
    color: #adb5bd;
}

.input-icon {
    position: absolute;
    right: 16px;
    top: 42px;
    color: var(--gray);
    font-size: 1rem;
    pointer-events: none;
}

.remember-forgot {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    width: 100%;
}

.remember-me {
    display: flex;
    align-items: center;
}

.remember-me input {
    margin-right: 8px;
    width: 18px;
    height: 18px;
}

.remember-me label {
    font-size: 0.9rem;
    color: var(--gray);
}

.forgot-password {
    color: var(--primary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: var(--transition);
    text-align: left;
}

.forgot-password:hover {
    color: var(--primary-dark);
    text-decoration: underline;
}

.btn-login {
    width: 100%;
    padding: 16px;
    background: linear-gradient(to right, var(--primary), var(--secondary));
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
    letter-spacing: 0.5px;
    margin-bottom: 24px;
}

.btn-login:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(67, 97, 238, 0.4);
}

.btn-login:active {
    transform: translateY(0);
}

.divider {
    display: flex;
    align-items: center;
    margin: 24px 0;
    color: var(--gray);
    font-size: 0.85rem;
    width: 100%;
}

.divider::before,
.divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--light-gray);
}

.divider span {
    padding: 0 12px;
}

.social-login {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    width: 100%;
}

.social-btn {
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    border: 2px solid var(--light-gray);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.95rem;
}

.social-btn:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
}

.social-btn.google {
    color: #db4437;
}

.social-btn.github {
    color: #333;
}

.register-link {
    text-align: center;
    margin-top: 20px;
    color: var(--gray);
    font-size: 0.95rem;
    width: 100%;
}

.register-link a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
}

.register-link a:hover {
    color: var(--primary-dark);
    text-decoration: underline;
}

.alert {
    margin-bottom: 20px;
    padding: 14px 16px;
    background: #ffeaea;
    color: #d32f2f;
    border-radius: 12px;
    font-size: 0.9rem;
    border-left: 4px solid #f44336;
    animation: slideIn 0.3s ease-out;
    width: 100%;
}

.logged-in-notice {
    background: #e8f5e9;
    color: #2e7d32;
    border-left: 4px solid #4caf50;
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-size: 0.9rem;
    width: 100%;
}

.logged-in-notice a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Tablet and larger mobile devices */
@media (min-width: 576px) {
    .login-container {
        margin: 20px auto;
    }
    
    .login-illustration {
        padding: 40px;
    }
    
    .login-form-section {
        padding: 40px 32px;
    }
    
    .social-login {
        flex-direction: row;
    }
    
    .remember-forgot {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
    
    .forgot-password {
        text-align: right;
    }
}

/* Tablet devices */
@media (min-width: 768px) {
    .login-container {
        flex-direction: row;
        min-height: 600px;
        max-width: 900px;
    }
    
    .login-illustration {
        flex: 1;
        padding: 50px 40px;
        min-height: auto;
        text-align: left;
    }
    
    .illustration-content {
        text-align: left;
    }
    
    .brand-logo {
        margin-bottom: 40px;
        font-size: 1.8rem;
    }
    
    .illustration-content h2 {
        font-size: 2rem;
    }
    
    .illustration-content p {
        font-size: 1rem;
    }
    
    .login-form-section {
        flex: 1;
        padding: 50px 40px;
    }
    
    .login-form-section h1 {
        text-align: left;
        font-size: 2rem;
    }
    
    .subtitle {
        text-align: left;
    }
    
    .social-login {
        flex-direction: row;
        gap: 15px;
    }
    
    .social-btn {
        font-size: 0.9rem;
    }
}

/* Desktop devices */
@media (min-width: 992px) {
    .login-container {
        max-width: 1000px;
        min-height: 650px;
    }
    
    .login-illustration {
        padding: 60px 50px;
    }
    
    .brand-logo {
        font-size: 2rem;
    }
    
    .illustration-content h2 {
        font-size: 2.5rem;
    }
    
    .illustration-content p {
        font-size: 1.1rem;
        margin-bottom: 20px;
    }
    
    .login-form-section {
        padding: 60px 50px;
    }
    
    .login-form-section h1 {
        font-size: 2.2rem;
    }
    
    .form-control {
        padding: 16px 20px;
    }
    
    .input-icon {
        top: 45px;
    }
    
    .btn-login {
        padding: 18px;
        font-size: 1.1rem;
    }
}

/* Large desktop devices */
@media (min-width: 1200px) {
    .login-container {
        max-width: 1100px;
    }
    
    .login-illustration {
        padding: 70px 60px;
    }
    
    .login-form-section {
        padding: 70px 60px;
    }
}

/* Extra small devices (phones under 360px) */
@media (max-width: 359px) {
    body {
        padding: 12px;
    }
    
    .login-container {
        border-radius: 20px;
    }
    
    .login-illustration {
        padding: 30px 20px;
        min-height: 250px;
    }
    
    .brand-logo {
        font-size: 1.4rem;
        padding: 8px 16px;
        margin-bottom: 20px;
    }
    
    .illustration-content h2 {
        font-size: 1.5rem;
    }
    
    .illustration-content p {
        font-size: 0.9rem;
    }
    
    .login-form-section {
        padding: 30px 20px;
    }
    
    .login-form-section h1 {
        font-size: 1.5rem;
    }
    
    .form-control {
        padding: 12px 14px;
        font-size: 15px;
    }
    
    .input-icon {
        right: 14px;
        top: 40px;
    }
}

/* Landscape orientation for mobile */
@media (max-height: 600px) and (orientation: landscape) {
    body {
        padding: 10px;
        align-items: flex-start;
    }
    
    .login-container {
        min-height: auto;
        margin: 10px auto;
    }
    
    .login-illustration {
        min-height: 200px;
        padding: 20px;
    }
    
    .illustration-content h2 {
        font-size: 1.5rem;
        margin-bottom: 10px;
    }
    
    .illustration-content p {
        font-size: 0.9rem;
        margin-bottom: 10px;
    }
    
    .login-form-section {
        padding: 30px 20px;
    }
    
    .form-group {
        margin-bottom: 16px;
    }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
    .form-control {
        border-width: 3px;
    }
    
    .btn-login {
        border: 2px solid var(--dark);
    }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
    * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
    
    .btn-login:hover,
    .social-btn:hover {
        transform: none;
    }
}

/* Touch device optimizations */
@media (hover: none) and (pointer: coarse) {
    .btn-login,
    .social-btn,
    .forgot-password {
        min-height: 44px; /* Minimum touch target size */
    }
    
    .remember-me input {
        min-width: 44px;
        min-height: 44px;
    }
    
    .form-control {
        font-size: 16px; /* Prevents iOS zoom on focus */
    }
}

/* Print styles */
@media print {
    .login-container {
        box-shadow: none;
        border: 1px solid #ddd;
    }
    
    .login-illustration {
        display: none;
    }
    
    .btn-login,
    .social-login {
        display: none;
    }
}
</style>

<div class="login-container">
    <div class="login-illustration">
        <div class="illustration-content">
            <div class="brand-logo">
                {# <span class="logo-icon">🛒</span> #}
                <span>Cartlify</span>
            </div>
            <h2>Welcome Back</h2>
            <p>Sign in to access your dashboard, manage your inventory, and track your orders in real-time.</p>
            <p>New to Cartlify? Create an account to get started with our powerful e-commerce management tools.</p>
        </div>
    </div>
    
    <div class="login-form-section">
        {% if error %}
            <div class="alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="logged-in-notice" role="status">
                You are logged in as <strong>{{ app.user.userIdentifier }}</strong>. 
                <a href="{{ path('app_logout') }}">Logout</a> to switch accounts.
            </div>
        {% endif %}

        <h1>Sign In</h1>
        <p class="subtitle">Enter your credentials to access your account</p>

        <form method="post">
            <div class="form-group">
                <label for="inputUsername" class="form-label">Username or Email</label>
                <input type="text"
                       name="username"
                       id="inputUsername"
                       class="form-control"
                       placeholder="Enter your username or email"
                       value="{{ last_username }}"
                       autocomplete="username"
                       required
                       autofocus
                       aria-required="true">
                <span class="input-icon" aria-hidden="true">👤</span>
            </div>

            <div class="form-group">
                <label for="inputPassword" class="form-label">Password</label>
                <input type="password"
                       name="password"
                       id="inputPassword"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required
                       aria-required="true">
                <span class="input-icon" aria-hidden="true">🔒</span>
            </div>

            <div class="remember-forgot">
                <div class="remember-me">
                    <input type="checkbox" id="remember" name="_remember_me" value="1">
                    <label for="remember">Remember me</label>
                </div>
                <a href="#" class="forgot-password" role="button">Forgot password?</a>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-login">Sign In</button>
        </form>

        <div class="divider"><span>Or continue with</span></div>

        <div class="social-login">
            <button type="button" class="social-btn google" aria-label="Sign in with Google">
                <span>Google</span>
            </button>
            <button type="button" class="social-btn github" aria-label="Sign in with GitHub">
                <span>GitHub</span>
            </button>
        </div>

        <div class="register-link">
            Don't have an account? <a href="{{ path('app_register') }}">Register Here</a>
        </div>
    </div>
</div>

<script>
// Mobile viewport height fix for iOS
function setVH() {
    const vh = window.innerHeight * 0.01;
    document.documentElement.style.setProperty('--vh', `${vh}px`);
}

// Initial call
setVH();

// Update on resize and orientation change
window.addEventListener('resize', setVH);
window.addEventListener('orientationchange', setVH);

// Touch device detection for better UX
if ('ontouchstart' in window || navigator.maxTouchPoints) {
    document.body.classList.add('touch-device');
}

// Handle form submission feedback
document.querySelector('form')?.addEventListener('submit', function(e) {
    const btn = this.querySelector('.btn-login');
    if (btn) {
        btn.innerHTML = 'Signing In...';
        btn.disabled = true;
    }
});

// Focus management for better accessibility
const inputs = document.querySelectorAll('.form-control');
inputs.forEach(input => {
    input.addEventListener('focus', function() {
        this.parentElement.classList.add('focused');
    });
    
    input.addEventListener('blur', function() {
        this.parentElement.classList.remove('focused');
    });
});
</script>

{% endblock %}