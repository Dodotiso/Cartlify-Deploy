<!-- ============================================ -->
<!-- PROFILE VARIABLES -->
<!-- ============================================ -->
{% set role = app.user.roles[0] ?? 'ROLE_USER' %}
{% set hasProfilePic = app.user.profilePicture is defined and app.user.profilePicture is not null %}
{% set userRoleName = role == 'ROLE_ADMIN' ? 'Administrator' : (role == 'ROLE_STAFF' ? 'Staff Member' : 'Customer') %}
{% set userRoleIcon = role == 'ROLE_ADMIN' ? 'crown' : (role == 'ROLE_STAFF' ? 'user-tie' : 'user') %}

<!-- ============================================ -->
<!-- HEADER -->
<!-- ============================================ -->
<div class="header">
    <h1>
        <button class="menu-toggle" id="menuToggle">
            <i class="fas fa-bars"></i>
        </button>
        <i class="fas fa-user-circle"></i> Customer Details
    </h1>

    <div class="header-right">
        <a href="{{ path('app_order_tracker') }}" class="tracker-icon-link" title="My Orders Tracker">
            <i class="fas fa-box"></i>
            <span class="tracker-badge" id="trackerBadge">0</span>
        </a>
        <a href="{{ path('app_cart_view') }}" class="cart-icon-link" title="Shopping Cart">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-badge" id="cartBadge">0</span>
        </a>
        <div class="notification-wrapper">
            <button class="notification-icon" id="notificationIcon" onclick="toggleNotificationDropdown()">
                <i class="fas fa-bell"></i>
                <span class="notification-badge" id="notificationBadge">0</span>
            </button>
            <div class="notification-dropdown" id="notificationDropdown">
                <div class="notification-header"><i class="fas fa-bell"></i> Notifications</div>
                <div id="notificationList"><div style="padding:20px;text-align:center;color:#6c757d;"><i class="fas fa-bell-slash"></i> No notifications</div></div>
                <div class="notification-footer">
                    <a href="{{ path('app_notifications_index') }}" class="view-all-link" onclick="markAllNotificationsAsReadBeforeRedirect()">View all notifications</a>
                    <button class="clear-notif-btn" onclick="clearAllNotifications()">Clear all</button>
                </div>
            </div>
        </div>
        <div class="profile-wrapper">
            <div class="profile-header" id="profileHeader">
                <div class="profile-avatar">
                    {% if hasProfilePic %}
                        <img src="{{ asset('uploads/profile_pics/' ~ app.user.profilePicture) }}" alt="{{ app.user.username }}">
                    {% else %}
                        {{ app.user.username|first|upper }}
                    {% endif %}
                </div>
                <span class="profile-name">{{ app.user.username }}</span>
                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
            <div class="profile-dropdown" id="profileDropdown">
                <div class="dropdown-role-header">
                    <i class="fas fa-{{ userRoleIcon }}"></i> {{ userRoleName }}
                </div>
                <a href="{{ path('app_profile_index') }}" class="dropdown-item">
                    <i class="fas fa-user-circle"></i>
                    <span>My Profile</span>
                </a>
                <a href="#" class="dropdown-item" id="changeProfilePicBtn">
                    <i class="fas fa-camera"></i>
                    <span>Change Picture</span>
                </a>
                <div class="dropdown-divider"></div>
                <a href="{{ path('app_logout') }}" class="dropdown-item logout-item">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </div>
</div>

<form id="profilePicUploadForm" method="post" enctype="multipart/form-data" style="display: none;">
    <input type="file" id="profilePicInput" name="profile_picture" accept="image/*">
</form>
<div class="toast-container" id="toastContainer"></div>

<!-- ============================================ -->
<!-- MAIN CONTENT -->
<!-- ============================================ -->
<div class="main-content">
    <div class="customer-details">
        <a href="{{ path('app_customer_management_index') }}" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Customers
        </a>
        
        <div class="profile-header">
            <div class="profile-info">
                <div class="profile-avatar-large">
                    {{ customer.username|first|upper }}
                </div>
                <div>
                    <h1 style="margin: 0 0 5px 0;">{{ customer.username }}</h1>
                    <p style="margin: 0; opacity: 0.9;">Customer since {{ customer.createdAt|date('F d, Y') }}</p>
                </div>
            </div>
            <div>
                <span class="status-badge {{ customer.isActive ? 'status-completed' : 'status-cancelled' }}">
                    {{ customer.isActive ? 'Active' : 'Inactive' }}
                </span>
            </div>
        </div>
        
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number" style="color: #28a745;">₱{{ totalSpent|number_format(2) }}</div>
                <div class="stat-label">Total Spent</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" style="color: #007bff;">{{ orderCount }}</div>
                <div class="stat-label">Total Orders</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" style="color: #17a2b8;">{{ completedOrders }}</div>
                <div class="stat-label">Completed Orders</div>
            </div>
        </div>
        
        <div class="info-card">
            <h3><i class="fas fa-info-circle"></i> Customer Information</h3>
            <div class="info-row">
                <div class="info-label">Full Name:</div>
                <div>{{ customer.username }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">Email Address:</div>
                <div>{{ customer.email }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">Phone Number:</div>
                <div>{{ customer.phone|default('Not provided') }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">Address:</div>
                <div>{{ customer.address|default('Not provided') }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">Registered Date:</div>
                <div>{{ customer.createdAt|date('F d, Y h:i A') }}</div>
            </div>
        </div>
        
        <div class="info-card">
            <h3><i class="fas fa-shopping-bag"></i> Order History</h3>
            {% if orders|length > 0 %}
                <div class="orders-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Delivery</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                <tr>
                                    <td style="font-weight: 600; color: #3498db;">#{{ order.id }}</td>
                                    <td>{{ order.stock.product.name }}</td>
                                    <td>{{ order.quantity }}</td>
                                    <td style="color: #28a745;">₱{{ order.totalAmount|number_format(2) }}</td>
                                    <td>{{ order.deliveryType|capitalize }}</td>
                                    <td>
                                        <span class="status-badge {{ order.orderStatus == 'completed' ? 'status-completed' : (order.orderStatus == 'pending' ? 'status-pending' : 'status-cancelled') }}">
                                            {{ order.orderStatus|capitalize }}
                                        </span>
                                    </td>
                                    <td>{{ order.createdAt|date('M d, Y') }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-shopping-bag" style="font-size: 48px; margin-bottom: 10px;"></i>
                    <p>No orders yet from this customer</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
    let notifications = [];
    let shownFlashes = [];

    function updateCartBadge() {
        fetch('/cart/count')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('cartBadge');
                if (badge && data.count > 0) {
                    badge.textContent = data.count > 9 ? '9+' : data.count;
                    badge.classList.add('show');
                } else if (badge) {
                    badge.classList.remove('show');
                }
            })
            .catch(e => console.log('Cart update error:', e));
    }

    function updateTrackerBadge() {
        fetch('{{ path('app_new_orders_count') }}')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('trackerBadge');
                if (badge && data.count > 0) {
                    badge.textContent = data.count > 9 ? '9+' : data.count;
                    badge.classList.add('show');
                } else if (badge) {
                    badge.classList.remove('show');
                }
            })
            .catch(e => console.log('Tracker update error:', e));
    }

    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'toast-container';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        let icon = type === 'success' ? '✓' : (type === 'error' ? '✗' : (type === 'warning' ? '⚠' : 'ℹ'));
        toast.innerHTML = `<div class="toast-icon">${icon}</div><div class="toast-content">${message}</div><div class="toast-progress"></div>`;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.animation = 'slideOutRight 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    function loadNotifications() {
        const saved = localStorage.getItem('order_notifications');
        notifications = saved ? JSON.parse(saved) : [];
        updateNotificationUI();
        updateNotificationBadge();
    }
    
    function saveNotifications() {
        localStorage.setItem('order_notifications', JSON.stringify(notifications));
        updateNotificationUI();
        updateNotificationBadge();
    }
    
    function updateNotificationBadge() {
        const unreadCount = notifications.filter(n => !n.read).length;
        const badge = document.getElementById('notificationBadge');
        if (badge) { 
            if (unreadCount > 0) { 
                badge.classList.add('show'); 
                badge.textContent = unreadCount > 99 ? '99+' : unreadCount; 
            } else { 
                badge.classList.remove('show'); 
            } 
        }
    }
    
    function markAllNotificationsAsRead() {
        if (notifications.length > 0) {
            let hasUnread = notifications.some(n => !n.read);
            if (hasUnread) {
                notifications.forEach(n => n.read = true);
                saveNotifications();
                updateNotificationBadge();
            }
        }
    }
    
    function markAllNotificationsAsReadBeforeRedirect() {
        markAllNotificationsAsRead();
        window.location.href = '{{ path('app_notifications_index') }}';
    }
    
    function updateNotificationUI() {
        const list = document.getElementById('notificationList');
        if (!list) return;
        
        if (notifications.length === 0) { 
            list.innerHTML = '<div style="padding:20px;text-align:center;color:#6c757d;"><i class="fas fa-bell-slash"></i> No notifications</div>'; 
        } else { 
            const recentNotifications = notifications.slice(0, 5);
            list.innerHTML = recentNotifications.map(n => `
                <div class="notification-item ${n.read ? '' : 'unread'}" onclick="markNotificationAsRead(${n.id})">
                    <div class="notification-title">${n.title}</div>
                    <div class="notification-message">${n.message}</div>
                    <div class="notification-time">${formatTimeAgo(n.timestamp)}</div>
                </div>
            `).join('');
        }
    }
    
    function markNotificationAsRead(id) { 
        const notification = notifications.find(n => n.id === id); 
        if (notification) { 
            notification.read = true; 
            saveNotifications(); 
        } 
    }
    
    function clearAllNotifications() { 
        if (confirm('Clear all notifications?')) { 
            notifications = []; 
            saveNotifications(); 
            showToast('All notifications cleared', 'info'); 
        } 
    }
    
    function formatTimeAgo(timestamp) { 
        const date = new Date(timestamp), now = new Date(), mins = Math.floor((now - date) / 60000), hours = Math.floor(mins / 60), days = Math.floor(hours / 24); 
        if (mins < 1) return 'Just now'; 
        if (mins < 60) return `${mins} min ago`; 
        if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`; 
        return `${days} day${days > 1 ? 's' : ''} ago`; 
    }
    
    function toggleNotificationDropdown() { 
        const dropdown = document.getElementById('notificationDropdown');
        if (dropdown) {
            dropdown.classList.toggle('show');
        }
    }

    function toggleProfileDropdown() {
        const dropdown = document.getElementById('profileDropdown');
        const header = document.getElementById('profileHeader');
        if (dropdown && header) {
            dropdown.classList.toggle('show');
            header.classList.toggle('active');
        }
    }

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
        const notificationDropdown = document.getElementById('notificationDropdown');
        const notificationIcon = document.getElementById('notificationIcon');
        if (notificationDropdown && notificationIcon && !notificationIcon.contains(event.target) && !notificationDropdown.contains(event.target)) {
            notificationDropdown.classList.remove('show');
        }
        
        const profileDropdown = document.getElementById('profileDropdown');
        const profileHeader = document.getElementById('profileHeader');
        if (profileDropdown && profileHeader && !profileHeader.contains(event.target) && !profileDropdown.contains(event.target)) {
            profileDropdown.classList.remove('show');
            profileHeader.classList.remove('active');
        }
    });

    let sidebarInit = false;
    function initMobileSidebar() {
        if (sidebarInit) return;
        let toggle = document.getElementById('menuToggle'), sidebar = document.getElementById('sidebar'), overlay = document.getElementById('sidebarOverlay');
        if (!toggle || !sidebar) return;
        function open() { sidebar.classList.add('mobile-open'); if (overlay) overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
        function close() { sidebar.classList.remove('mobile-open'); if (overlay) overlay.classList.remove('active'); document.body.style.overflow = ''; }
        toggle.addEventListener('click', e => { e.stopPropagation(); sidebar.classList.contains('mobile-open') ? close() : open(); });
        if (overlay) overlay.addEventListener('click', close);
        document.addEventListener('click', e => { if (window.innerWidth <= 768 && sidebar.classList.contains('mobile-open') && !sidebar.contains(e.target) && !toggle.contains(e.target)) close(); });
        window.addEventListener('resize', () => { if (window.innerWidth > 768 && sidebar.classList.contains('mobile-open')) close(); });
        sidebarInit = true;
    }

    function initFlashMessages() {
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                let msg = '{{ message|escape('js') }}';
                if (!shownFlashes.includes(msg)) { shownFlashes.push(msg); showToast(msg, '{{ label }}'); }
            {% endfor %}
        {% endfor %}
    }

    let dropdownInit = false;
    function initializeDropdown() {
        if (dropdownInit) return;
        let header = document.getElementById('profileHeader'), dropdown = document.getElementById('profileDropdown');
        if (header && dropdown) {
            header.addEventListener('click', function(e) {
                e.stopPropagation();
                toggleProfileDropdown();
            });
            dropdownInit = true;
        }
        let changeBtn = document.getElementById('changeProfilePicBtn');
        if (changeBtn) changeBtn.addEventListener('click', e => { e.preventDefault(); showUploadModal(); });
    }

    function showUploadModal() {
        let existing = document.getElementById('uploadModal'); if (existing) existing.remove();
        let modal = document.createElement('div'); modal.id = 'uploadModal'; modal.className = 'modal';
        modal.innerHTML = `<div class="modal-content"><div class="modal-header"><h3>Change Profile Picture</h3><button class="close-modal">&times;</button></div><div class="modal-body"><div class="upload-area" id="uploadArea"><i class="fas fa-cloud-upload-alt"></i><p>Click to upload or drag and drop</p><small>PNG, JPG, GIF, WebP up to 2MB</small></div><div class="image-preview" id="imagePreview" style="display:none;"><img src="" alt="Preview"></div><div class="upload-progress" id="uploadProgress" style="display:none;"><div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div><span id="progressText">0%</span></div></div><div class="modal-footer"><button class="btn-secondary-modal" id="cancelUpload">Cancel</button><button class="btn-primary-modal" id="saveUpload" disabled>Upload</button></div></div>`;
        document.body.appendChild(modal); setTimeout(() => modal.classList.add('show'), 10);
        let uploadArea = document.getElementById('uploadArea'), preview = document.getElementById('imagePreview'), previewImg = preview.querySelector('img'), saveBtn = document.getElementById('saveUpload'), cancelBtn = document.getElementById('cancelUpload'), closeBtn = modal.querySelector('.close-modal'), progressContainer = document.getElementById('uploadProgress'), progressFill = document.getElementById('progressFill'), progressText = document.getElementById('progressText');
        let fileInput = document.createElement('input'); fileInput.type = 'file'; fileInput.accept = 'image/jpeg,image/png,image/gif,image/webp'; fileInput.style.display = 'none'; modal.appendChild(fileInput);
        uploadArea.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', e => { let file = e.target.files[0]; if (file) { if (!['image/jpeg','image/png','image/gif','image/webp'].includes(file.type)) { showToast('Invalid image type', 'error'); return; } if (file.size > 2*1024*1024) { showToast('File too large (max 2MB)', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; }; reader.readAsDataURL(file); } });
        uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.style.borderColor = '#007bff'; });
        uploadArea.addEventListener('drop', e => { e.preventDefault(); let file = e.dataTransfer.files[0]; if (file && file.type.startsWith('image/')) { if (file.size > 2*1024*1024) { showToast('File too large', 'error'); return; } let reader = new FileReader(); reader.onload = e => { previewImg.src = e.target.result; preview.style.display = 'block'; uploadArea.style.display = 'none'; saveBtn.disabled = false; let dt = new DataTransfer(); dt.items.add(file); fileInput.files = dt.files; }; reader.readAsDataURL(file); } });
        saveBtn.addEventListener('click', () => { if (fileInput.files.length > 0) uploadProfilePicture(fileInput.files[0]); });
        function uploadProfilePicture(file) { let fd = new FormData(); fd.append('profile_picture', file); progressContainer.style.display = 'block'; saveBtn.disabled = true; let xhr = new XMLHttpRequest(); xhr.upload.addEventListener('progress', e => { if (e.lengthComputable) { let pct = Math.round((e.loaded / e.total) * 100); progressFill.style.width = pct + '%'; progressText.textContent = pct + '%'; } }); xhr.addEventListener('load', () => { if (xhr.status === 200) { try { let resp = JSON.parse(xhr.responseText); if (resp.success) { document.querySelector('.profile-avatar').innerHTML = `<img src="${resp.imageUrl}?t=${Date.now()}" alt="{{ app.user.username }}">`; showToast('Profile picture updated!', 'success'); closeUploadModal(); } else { showToast(resp.message || 'Upload failed', 'error'); resetUpload(); } } catch(e) { showToast('Invalid response', 'error'); resetUpload(); } } else { showToast('Upload failed', 'error'); resetUpload(); } }); xhr.addEventListener('error', () => { showToast('Network error', 'error'); resetUpload(); }); xhr.open('POST', '/dashboard/upload-profile-picture', true); xhr.send(fd); }
        function resetUpload() { progressContainer.style.display = 'none'; progressFill.style.width = '0%'; progressText.textContent = '0%'; saveBtn.disabled = false; }
        window.closeUploadModal = () => { modal.classList.remove('show'); setTimeout(() => modal.remove(), 300); };
        cancelBtn.addEventListener('click', closeUploadModal);
        closeBtn.addEventListener('click', closeUploadModal);
        modal.addEventListener('click', e => { if (e.target === modal) closeUploadModal(); });
    }

    function initAll() {
        initMobileSidebar(); 
        initFlashMessages(); 
        initializeDropdown(); 
        loadNotifications();
        
        updateCartBadge(); 
        setInterval(updateCartBadge, 5000);
        updateTrackerBadge();
    }

    document.addEventListener('DOMContentLoaded', () => setTimeout(initAll, 100));
    document.addEventListener('turbo:load', () => { sidebarInit = false; dropdownInit = false; setTimeout(initAll, 100); });
</script>
{% endblock %}