APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-this-in-railway

DATABASE_URL="mysql://${MYSQLUSER}:${MYSQLPASSWORD}@${MYSQLHOST}:${MYSQLPORT}/${MYSQLDATABASE}?serverVersion=8.0.32&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-this-in-railway

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-secret

MAILER_DSN=smtp://user:pass@smtp.example.com:587

CORS_ALLOW_ORIGIN='^https?://(.*\.railway\.app|localhost)(:[0-9]+)?$'